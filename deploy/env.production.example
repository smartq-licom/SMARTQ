# SmartQ settings on the Hostinger VPS. setup.sh copies this to /var/www/smartq/.env
# and fills in the database password and session secret. Never commit the real .env.
NODE_ENV=production
PORT=3000
APP_TZ=Asia/Manila
SESSION_SECRET=__SESSION_SECRET__

# MariaDB on the same server: no SSL needed (it only listens on this machine)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=smartq
DB_PASSWORD=__DB_PASSWORD__
DB_NAME=smartq_db
DB_SSL=false

# Email (staff codes, queue code emails): copy the values you use on Render now.
# With BREVO_API_KEY set, email goes through Brevo; the SMTP lines are the fallback.
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SmartQ <no-reply@__DOMAIN__>

# Phone alerts (Web Push): copy the SAME keys used on Render, or phones that
# already turned on alerts stop receiving them
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@__DOMAIN__
