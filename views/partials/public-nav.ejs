<%# Header for the students' pages (/queue): no sidebar and no account, just the
    college and a way back to the start. Closed by partials/foot like nav.ejs. %>
<div class="flex flex-col min-h-screen">
<header class="bg-brand text-white no-print">
  <div class="max-w-3xl mx-auto px-4 h-16 flex items-center gap-3">
    <a href="/queue" class="flex items-center gap-3 min-w-0 text-white hover:text-white">
      <img src="/img/lcc-seal.jpg" alt="Libon Community College seal"
           class="w-10 h-10 rounded-full bg-white ring-2 ring-white/40 object-cover shrink-0">
      <span class="min-w-0">
        <span class="block text-[18px] font-extrabold tracking-tight leading-none">SmartQ</span>
        <span class="block text-[11px] text-white/75 leading-tight mt-1 truncate">Libon Community College</span>
      </span>
    </a>
    <a href="/queue/find" class="ml-auto shrink-0 rounded-lg bg-white/15 hover:bg-white/25 px-3 py-1.5 text-[12.5px] font-semibold text-white transition-colors">Find my ticket</a>
  </div>
</header>
<main id="main" class="flex-1 w-full max-w-3xl mx-auto px-4 py-5 fade-in">
<% if (flash) { %>
<div role="status" class="mb-4 rounded-lg bg-brand-wash border-l-4 border-brand px-4 py-3 text-[13px] font-medium text-brand-deep"><%= flash %></div>
<% } %>
<% if (error) { %>
<div role="alert" class="mb-4 rounded-lg bg-red-50 border-l-4 border-red-600 px-4 py-3 text-[13px] font-medium text-red-900"><%= error %></div>
<% } %>
