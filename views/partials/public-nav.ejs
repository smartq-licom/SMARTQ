<%# Header for the students' pages (/queue): no sidebar and no account, just the
    college and a way back to the start. Closed by partials/foot like nav.ejs. %>
<div class="flex flex-col min-h-screen">
<header class="sticky top-0 z-30 bg-white/80 backdrop-blur-md border-b border-hair/70 no-print" style="padding-top:env(safe-area-inset-top)">
  <div class="max-w-3xl mx-auto px-4 h-16 flex items-center gap-3">
    <a href="/queue" class="flex items-center gap-3 min-w-0">
      <img src="/img/lcc-seal.jpg" alt="Libon Community College seal"
           class="w-10 h-10 rounded-full bg-white ring-1 ring-hair object-cover shrink-0">
      <span class="min-w-0">
        <span class="block text-[18px] font-extrabold tracking-tight leading-none text-ink">Smart<span class="text-brand">Q</span></span>
        <span class="block text-[11px] text-slateSoft/70 leading-tight mt-1 truncate">Libon Community College</span>
      </span>
    </a>
    <a href="/queue/find" class="ml-auto shrink-0 inline-flex items-center gap-1.5 rounded-full bg-brand-wash hover:bg-brand-line/60 px-3.5 py-2 text-[12.5px] font-semibold text-brand-deep transition-colors">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      Find my ticket
    </a>
  </div>
</header>
<main id="main" class="flex-1 w-full max-w-3xl mx-auto px-4 pt-5 pb-10 fade-in">
<%- include('flash') %>
<%- include('install-prompt') %>
