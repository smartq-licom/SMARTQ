<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %> | SmartQ</title>
<link rel="icon" href="/img/lcc-seal.jpg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@600;700;800&display=swap" rel="stylesheet">
<style>
  :root{
    --blue:#2185D5; --blue-deep:#1A6CAE; --blue-wash:#E7F1FA;
    --slate:#303841; --slate-soft:#3A4750;
    --page:#F2F4F8; --card:#FFFFFF; --light:#F3F3F3;
    --line:#E3E7ED; --ink:#1E2A36; --muted:#3A4750; --faint:#78838C;
    --on-blue:rgba(255,255,255,.82); --on-blue-faint:rgba(255,255,255,.55);
    --danger:#B3352A; --danger-bg:#FBEDEC;
    --ok:#1A6CAE;     --ok-bg:#E7F1FA;
    --warn:#7E5C12;   --warn-bg:#FAF3E4;
    --r:28px; --r-sm:12px; --night:#0F4C81;
  }
  *,*::before,*::after{box-sizing:border-box}
  html,body{margin:0;padding:0}
  body{
    font-family:'Plus Jakarta Sans',system-ui,sans-serif;
    background:radial-gradient(80% 60% at 0% 0%,#DCEBFA 0%,transparent 60%),radial-gradient(70% 60% at 100% 100%,#E6E1FB 0%,transparent 60%),var(--page);
    color:var(--ink);
    font-size:15px; line-height:1.55; -webkit-font-smoothing:antialiased;
    display:flex; align-items:center; justify-content:center;
    min-height:100vh; padding:26px 18px;
  }
  a{color:var(--blue); text-decoration:none}
  a:hover{color:var(--blue-deep); text-decoration:underline}
  :focus-visible{outline:2px solid var(--blue); outline-offset:2px; border-radius:4px}
  @media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}

  .shell{
    width:100%; max-width:1040px; background:var(--card);
    border-radius:var(--r); padding:14px;
    box-shadow:0 30px 70px -20px rgba(15,76,129,.28), 0 2px 8px rgba(48,56,65,.05);
    animation:shell-in .7s cubic-bezier(.2,.8,.2,1) both;
  }
  .auth{display:grid; grid-template-columns:1fr; gap:20px}
  @media(min-width:900px){ .auth{grid-template-columns:1fr 1fr; gap:28px} }

  /* left: the blue panel */
  .seal-panel{
    position:relative; overflow:hidden;
    background:radial-gradient(120% 120% at 0% 0%,#3B9BE6 0%,#2185D5 40%,#0F4C81 100%); color:#fff;
    border-radius:22px; padding:34px 28px;
    display:flex; flex-direction:column; align-items:center; text-align:center;
  }
  @media(min-width:900px){ .seal-panel{padding:34px 36px; min-height:540px; justify-content:center} }
  .seal-panel::after{
    content:''; position:absolute; inset:0; pointer-events:none;
    background:linear-gradient(135deg,rgba(255,255,255,.10) 0%,transparent 42%,transparent 62%,rgba(255,255,255,.07) 100%);
  }

  .seal{
    width:96px; height:96px; border-radius:50%;
    background:#fff url('/img/lcc-seal.jpg') center/cover;
    box-shadow:0 10px 26px rgba(20,55,90,.25), 0 0 0 6px rgba(255,255,255,.14); position:relative; z-index:1;
    animation:seal-in .7s cubic-bezier(.34,1.56,.64,1) .15s both;
  }
  @media(min-width:900px){ .seal{width:92px; height:92px} }

  .wordmark b{color:#BFE1FB}
  .wordmark{
    position:relative; z-index:1; animation:up .6s cubic-bezier(.2,.8,.2,1) .3s both;
    font-weight:800; font-size:48px; letter-spacing:-1.6px; line-height:1; margin:16px 0 0;
  }
  @media(min-width:900px){ .wordmark{font-size:52px; letter-spacing:-2px} }
  .college{position:relative; z-index:1; margin:10px 0 0; font-size:15px; font-weight:600; line-height:1.3}
  .place{font-size:12.5px; color:var(--on-blue-faint); margin:2px 0 0; position:relative; z-index:1}

  .lede{position:relative; z-index:1; margin:18px 0 0; font-size:19px; font-weight:700; line-height:1.35; max-width:22ch}
  @media(min-width:900px){ .lede{font-size:19px} }
  .blurb{position:relative; z-index:1; margin:8px 0 0; font-size:13px; color:var(--on-blue); line-height:1.6; max-width:34ch}
  .points{list-style:none; margin:12px 0 0; padding:0; position:relative; z-index:1; width:100%; max-width:300px; text-align:left}
  .points li{
    display:flex; align-items:center; gap:10px; font-size:13px; font-weight:600; color:#fff;
    padding:8px 12px; margin-top:6px; border-radius:12px; background:rgba(255,255,255,.10);
    animation:up .5s cubic-bezier(.2,.8,.2,1) both; animation-delay:calc(.9s + var(--i) * .12s);
  }
  .points li svg{flex:none; color:#BFE1FB}
  @media(max-width:899px){ .points{display:none} .lede{font-size:17px} .blurb{display:none} }
  .panel-foot{display:none}

  /* right: the form */
  .form-side{display:flex; align-items:center; justify-content:center; padding:6px 4px 14px}
  @media(min-width:900px){ .form-side{padding:20px 26px} }
  .form-wrap{width:100%; max-width:340px}
  .form-wrap.wide{max-width:440px}

  h1.page-title{font-weight:800; font-size:27px; letter-spacing:-.5px; margin:0 0 6px; text-align:center; color:var(--slate)}
  .subtitle{color:var(--faint); font-size:13.5px; margin:0 0 26px; text-align:center}

  .card{background:transparent; border:0; padding:0}

  .secgroup{
    font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.08em;
    color:var(--faint); margin:22px 0 10px; padding-bottom:6px; border-bottom:1px solid var(--line);
  }
  .secgroup:first-of-type{margin-top:4px}
  .field{margin-bottom:17px}
  .field label{display:flex; align-items:center; gap:7px; font-size:13.5px; font-weight:600; margin-bottom:7px; color:var(--slate)}
  .field label svg{flex:none; color:var(--blue)}
  .req{color:var(--faint); font-weight:400}
  .control{
    width:100%; font:inherit; font-size:14.5px; color:var(--ink);
    background:#fff; border:1.5px solid var(--line); border-radius:var(--r-sm);
    padding:12px 14px; transition:border-color .15s, box-shadow .15s;
  }
  .control::placeholder{color:#A7AFB7}
  .control:focus{outline:none; border-color:var(--blue); box-shadow:0 0 0 4px rgba(33,133,213,.15)}
  @media (max-width:640px){ .control{font-size:16px} }
  .control[readonly]{background:var(--light); color:var(--muted)}
  .hint{display:block; font-size:12px; color:var(--faint); margin-top:5px}

  .pw-wrap{position:relative}
  .pw-wrap .control{padding-right:60px}
  .pw-toggle{
    position:absolute; right:5px; top:50%; transform:translateY(-50%);
    background:none; border:0; cursor:pointer; padding:6px 9px;
    font:inherit; font-size:12.5px; font-weight:600; color:var(--faint); border-radius:6px;
  }
  .pw-toggle:hover{color:var(--blue); background:var(--light)}

  .btn{
    display:inline-flex; align-items:center; justify-content:center; gap:9px;
    width:100%; font:inherit; font-size:15px; font-weight:600;
    padding:13px 18px; border-radius:var(--r-sm); border:1.5px solid transparent;
    cursor:pointer; transition:background .15s, border-color .15s, color .15s, transform .15s, box-shadow .15s;
  }
  .btn:active:not(:disabled){transform:scale(.98)}
  .btn:disabled{opacity:.55; cursor:not-allowed}
  .btn-primary{background:linear-gradient(135deg,#2E9BEA,#2185D5 50%,#1A6CAE); color:#fff; box-shadow:0 10px 22px -8px rgba(33,133,213,.7)}
  .btn-primary:hover:not(:disabled){transform:translateY(-1px); box-shadow:0 14px 26px -8px rgba(33,133,213,.8)}
  .btn .spin{width:16px; height:16px; border-radius:50%; border:2.5px solid rgba(255,255,255,.4); border-top-color:#fff; animation:spin .7s linear infinite}
  .btn-outline{background:#fff; color:var(--slate); border-color:var(--line)}
  .btn-outline:hover:not(:disabled){border-color:var(--blue); color:var(--blue-deep)}
  .btn-quiet{background:var(--light); color:var(--slate); border-color:var(--line)}
  .btn-quiet:hover:not(:disabled){background:#E7E9EC}

  .divider{display:flex; align-items:center; gap:13px; margin:20px 0; color:var(--faint); font-size:12.5px}
  .divider::before,.divider::after{content:''; height:1px; flex:1; background:var(--line)}

  .alt{text-align:center; font-size:13.5px; color:var(--muted); margin-top:20px}
  .alt a{font-weight:600}
  .under{text-align:center; font-size:13.5px; margin-top:14px; color:var(--slate)}

  .note{border-radius:var(--r-sm); padding:11px 14px; font-size:13px; margin-bottom:16px}
  .note-bad{background:var(--danger-bg); border:1px solid #EED3D0; color:var(--danger)}
  .note-ok{background:var(--ok-bg); border:1px solid #C3DCF2; color:var(--ok)}
  .note-warn{background:var(--warn-bg); border:1px solid #EDDCB2; color:var(--warn)}

  .row{display:grid; gap:13px}
  @media(min-width:560px){ .row-3{grid-template-columns:1fr 1fr 1fr} .row-2{grid-template-columns:1fr 1fr} }

  .rules{list-style:none; margin:10px 0 0; padding:0}
  .rules li{display:flex; align-items:center; gap:8px; font-size:12.5px; color:var(--faint); padding:2px 0}
  .rules li .tick{width:14px; text-align:center; font-weight:700}
  .rules li.met{color:var(--blue-deep)}

  .otp{
    width:100%; font-family:'JetBrains Mono',monospace; font-size:30px; font-weight:700;
    letter-spacing:.3em; text-align:center; text-indent:.3em;
    padding:15px 12px; border:1.5px solid var(--line); border-radius:var(--r-sm); background:#fff;
  }
  .otp:focus{outline:none; border-color:var(--blue); box-shadow:0 0 0 3px rgba(33,133,213,.2)}
  .countdown{font-variant-numeric:tabular-nums; font-weight:700}
  .expired{color:var(--danger)}
  /* motion: the card settles, the panel's parts and the form's fields rise in turn */
  @keyframes shell-in{from{opacity:0; transform:translateY(16px) scale(.985)} to{opacity:1; transform:none}}
  @keyframes seal-in{from{opacity:0; transform:scale(.5) rotate(-20deg)} to{opacity:1; transform:none}}
  @keyframes up{from{opacity:0; transform:translateY(12px)} to{opacity:1; transform:none}}
  @keyframes spin{to{transform:rotate(360deg)}}
  .college,.place{animation:up .6s cubic-bezier(.2,.8,.2,1) .4s both}
  .lede,.blurb{animation:up .6s cubic-bezier(.2,.8,.2,1) .55s both}
  .form-wrap > *{animation:up .55s cubic-bezier(.2,.8,.2,1) both}
  .form-wrap > *:nth-child(2){animation-delay:.08s} .form-wrap > *:nth-child(3){animation-delay:.16s}
  .form-wrap > *:nth-child(4){animation-delay:.24s} .form-wrap > *:nth-child(5){animation-delay:.32s}
  .field{animation:up .5s cubic-bezier(.2,.8,.2,1) both} .field:nth-of-type(2){animation-delay:.1s}
  /* moving light and drifting numbers behind the panel */
  .orb{position:absolute; border-radius:50%; filter:blur(50px); pointer-events:none}
  .orb.a{width:280px; height:280px; background:#7CC4FA; opacity:.45; left:-90px; top:-90px; animation:orb 12s ease-in-out infinite alternate}
  .orb.b{width:260px; height:260px; background:#8B5CF6; opacity:.25; right:-110px; bottom:-60px; animation:orb 15s ease-in-out infinite alternate-reverse}
  @keyframes orb{to{transform:translate(60px,50px) scale(1.15)}}
  .drift{position:absolute; inset:0; overflow:hidden; pointer-events:none}
  .drift span{position:absolute; bottom:-40px; left:calc(6% + var(--i) * 15%); font:700 12px/1 'JetBrains Mono',monospace;
              padding:6px 9px; border-radius:8px; background:rgba(255,255,255,.06); color:rgba(255,255,255,.3);
              animation:drift 13s linear infinite; animation-delay:calc(var(--i) * -2.2s)}
  @keyframes drift{0%{transform:translateY(0); opacity:0} 10%,85%{opacity:1} 100%{transform:translateY(-640px); opacity:0}}
  /* the little live board: the number being called keeps changing */
  .mini{position:relative; z-index:1; margin:18px 0 0; width:100%; max-width:300px; border-radius:18px;
        background:rgba(255,255,255,.12); border:1px solid rgba(255,255,255,.18); padding:14px 16px; text-align:left;
        backdrop-filter:blur(6px); animation:up .6s cubic-bezier(.2,.8,.2,1) .75s both}
  .mini-top{display:flex; justify-content:space-between; font-size:10.5px; font-weight:800; letter-spacing:.18em; text-transform:uppercase; color:rgba(255,255,255,.7)}
  .mini-live{display:inline-flex; align-items:center; gap:6px; letter-spacing:.08em}
  .mini-live i{width:7px; height:7px; border-radius:50%; background:#34D399; box-shadow:0 0 0 0 rgba(52,211,153,.6); animation:ping 1.8s ease-out infinite}
  @keyframes ping{0%{box-shadow:0 0 0 0 rgba(52,211,153,.6)} 80%,100%{box-shadow:0 0 0 7px rgba(52,211,153,0)}}
  .mini-no{font:800 40px/1 'JetBrains Mono',monospace; margin-top:6px; letter-spacing:-.02em}
  .mini-no.flip{animation:flip .5s cubic-bezier(.2,.8,.2,1)}
  @keyframes flip{from{opacity:0; transform:translateY(-12px); filter:blur(4px)} to{opacity:1; transform:none; filter:none}}
  .mini-sub{font-size:12px; color:rgba(255,255,255,.75); margin-top:4px}
  .mini-wait{font-size:11.5px; font-weight:600; color:rgba(255,255,255,.6); margin-top:8px; padding-top:8px; border-top:1px solid rgba(255,255,255,.15)}
  .mini-wait:empty{display:none}
  @media(max-width:899px){ .mini,.drift{display:none} }
  .sr{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
  .skip:focus{position:fixed;top:10px;left:10px;width:auto;height:auto;clip:auto;z-index:99;background:var(--blue);color:#fff;padding:10px 16px;border-radius:8px}
</style>
</head>
<body>
<a href="#form" class="sr skip">Skip to form</a>

<div class="shell">
  <div class="auth">
    <aside class="seal-panel">
      <span class="orb a" aria-hidden="true"></span><span class="orb b" aria-hidden="true"></span>
      <div class="drift" aria-hidden="true"><% ['C-014','R-007','CP-002','R-021','C-009','RP-003'].forEach(function (n, i) { %><span style="--i:<%= i %>"><%= n %></span><% }) %></div>
      <div class="seal" role="img" aria-label="Libon Community College seal"></div>
      <p class="wordmark">Smart<b>Q</b></p>
      <p class="college">Libon Community College</p>
      <p class="place">Libon, Albay</p>

      <p class="lede">Staff portal for the Cashier and Registrar queues.</p>
      <p class="blurb">
        Students do not sign in here. They scan the QR code at the office
        to get a queue number.
      </p>

      <div class="mini" aria-hidden="true">
        <div class="mini-top"><span>Now serving</span><span class="mini-live"><i></i>Live</span></div>
        <div class="mini-no" id="miniNo">&mdash;</div>
        <div class="mini-sub" id="miniSub">Loading the queue&hellip;</div>
        <div class="mini-wait" id="miniWait"></div>
      </div>

      <ul class="points">
        <% ['Call the next client in one click', "See today's queue and busy hours", 'Queue history and reports'].forEach(function (pt, i) { %>
        <li style="--i:<%= i %>"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/></svg><%= pt %></li>
        <% }) %>
      </ul>
    </aside>

    <main class="form-side" id="form">
      <div class="form-wrap <%= typeof wide !== 'undefined' && wide ? 'wide' : '' %>">
