<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %> | SmartQ</title>
<link rel="icon" href="/img/lcc-seal.jpg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root{
    --blue:#2185D5; --blue-deep:#1A6CAE; --blue-wash:#E7F1FA;
    --slate:#303841; --slate-soft:#3A4750;
    --page:#E9EBEF; --card:#FFFFFF; --light:#F3F3F3;
    --line:#DFE2E6; --ink:#303841; --muted:#3A4750; --faint:#78838C;
    --on-blue:rgba(255,255,255,.82); --on-blue-faint:rgba(255,255,255,.55);
    --danger:#B3352A; --danger-bg:#FBEDEC;
    --ok:#1A6CAE;     --ok-bg:#E7F1FA;
    --warn:#7E5C12;   --warn-bg:#FAF3E4;
    --r:14px; --r-sm:8px;
  }
  *,*::before,*::after{box-sizing:border-box}
  html,body{margin:0;padding:0}
  body{
    font-family:'Public Sans',system-ui,sans-serif;
    background:var(--page); color:var(--ink);
    font-size:15px; line-height:1.55; -webkit-font-smoothing:antialiased;
    display:flex; align-items:center; justify-content:center;
    min-height:100vh; padding:26px 18px;
  }
  a{color:var(--blue); text-decoration:none}
  a:hover{color:var(--blue-deep); text-decoration:underline}
  :focus-visible{outline:2px solid var(--blue); outline-offset:2px; border-radius:4px}
  @media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}

  .shell{
    width:100%; max-width:1040px; background:var(--card);
    border-radius:var(--r); padding:20px;
    box-shadow:0 18px 50px rgba(48,56,65,.13), 0 2px 8px rgba(48,56,65,.06);
  }
  .auth{display:grid; grid-template-columns:1fr; gap:20px}
  @media(min-width:900px){ .auth{grid-template-columns:1fr 1fr; gap:28px} }

  /* left: the blue panel */
  .seal-panel{
    position:relative; overflow:hidden;
    background:var(--blue); color:#fff;
    border-radius:var(--r); padding:34px 28px;
    display:flex; flex-direction:column; align-items:center; text-align:center;
  }
  @media(min-width:900px){ .seal-panel{padding:52px 40px; min-height:560px; justify-content:center} }
  .seal-panel::after{
    content:''; position:absolute; inset:0; pointer-events:none;
    background:linear-gradient(135deg,rgba(255,255,255,.10) 0%,transparent 42%,transparent 62%,rgba(255,255,255,.07) 100%);
  }

  .seal{
    width:96px; height:96px; border-radius:50%;
    background:#fff url('/img/lcc-seal.jpg') center/cover;
    box-shadow:0 10px 26px rgba(20,55,90,.25); position:relative; z-index:1;
  }
  @media(min-width:900px){ .seal{width:118px; height:118px} }

  .wordmark{
    position:relative; z-index:1;
    font-weight:800; font-size:48px; letter-spacing:-1.6px; line-height:1; margin:22px 0 0;
  }
  @media(min-width:900px){ .wordmark{font-size:62px; letter-spacing:-2.2px} }
  .college{position:relative; z-index:1; margin:10px 0 0; font-size:15px; font-weight:600; line-height:1.3}
  .place{font-size:12.5px; color:var(--on-blue-faint); margin:2px 0 0; position:relative; z-index:1}

  .lede{position:relative; z-index:1; margin:26px 0 0; font-size:19px; font-weight:700; line-height:1.35; max-width:22ch}
  @media(min-width:900px){ .lede{font-size:21px} }
  .blurb{position:relative; z-index:1; margin:10px 0 0; font-size:13.5px; color:var(--on-blue); line-height:1.6; max-width:34ch}
  .points{list-style:none; margin:24px 0 0; padding:0; position:relative; z-index:1; width:100%; max-width:300px; text-align:left}
  .points li{
    font-size:13px; color:var(--on-blue);
    padding:9px 0 9px 20px; border-top:1px solid rgba(255,255,255,.22); position:relative;
  }
  .points li:last-child{border-bottom:1px solid rgba(255,255,255,.22)}
  .points li::before{content:''; position:absolute; left:0; top:16px; width:6px; height:6px; border-radius:50%; background:#fff}
  @media(max-width:899px){ .points{display:none} .lede{font-size:17px} .blurb{display:none} }
  .panel-foot{display:none}

  /* right: the form */
  .form-side{display:flex; align-items:center; justify-content:center; padding:6px 4px 14px}
  @media(min-width:900px){ .form-side{padding:20px 26px} }
  .form-wrap{width:100%; max-width:340px}
  .form-wrap.wide{max-width:440px}

  h1.page-title{font-weight:800; font-size:27px; letter-spacing:-.5px; margin:0 0 6px; text-align:center; color:var(--slate)}
  .subtitle{color:var(--faint); font-size:13.5px; margin:0 0 26px; text-align:center}

  .card{background:transparent; border:0; padding:0}

  .secgroup{
    font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.08em;
    color:var(--faint); margin:22px 0 10px; padding-bottom:6px; border-bottom:1px solid var(--line);
  }
  .secgroup:first-of-type{margin-top:4px}
  .field{margin-bottom:17px}
  .field label{display:flex; align-items:center; gap:7px; font-size:13.5px; font-weight:600; margin-bottom:7px; color:var(--slate)}
  .field label svg{flex:none; color:var(--blue)}
  .req{color:var(--faint); font-weight:400}
  .control{
    width:100%; font:inherit; font-size:14.5px; color:var(--ink);
    background:#fff; border:1.5px solid var(--line); border-radius:var(--r-sm);
    padding:12px 14px; transition:border-color .15s, box-shadow .15s;
  }
  .control::placeholder{color:#A7AFB7}
  .control:focus{outline:none; border-color:var(--blue); box-shadow:0 0 0 3px rgba(33,133,213,.16)}
  .control[readonly]{background:var(--light); color:var(--muted)}
  .hint{display:block; font-size:12px; color:var(--faint); margin-top:5px}

  .pw-wrap{position:relative}
  .pw-wrap .control{padding-right:60px}
  .pw-toggle{
    position:absolute; right:5px; top:50%; transform:translateY(-50%);
    background:none; border:0; cursor:pointer; padding:6px 9px;
    font:inherit; font-size:12.5px; font-weight:600; color:var(--faint); border-radius:6px;
  }
  .pw-toggle:hover{color:var(--blue); background:var(--light)}

  .btn{
    display:inline-flex; align-items:center; justify-content:center; gap:9px;
    width:100%; font:inherit; font-size:15px; font-weight:600;
    padding:13px 18px; border-radius:var(--r-sm); border:1.5px solid transparent;
    cursor:pointer; transition:background .15s, border-color .15s, color .15s;
  }
  .btn:disabled{opacity:.55; cursor:not-allowed}
  .btn-primary{background:var(--blue); color:#fff}
  .btn-primary:hover:not(:disabled){background:var(--blue-deep)}
  .btn-outline{background:#fff; color:var(--slate); border-color:var(--line)}
  .btn-outline:hover:not(:disabled){border-color:var(--blue); color:var(--blue-deep)}
  .btn-quiet{background:var(--light); color:var(--slate); border-color:var(--line)}
  .btn-quiet:hover:not(:disabled){background:#E7E9EC}

  .divider{display:flex; align-items:center; gap:13px; margin:20px 0; color:var(--faint); font-size:12.5px}
  .divider::before,.divider::after{content:''; height:1px; flex:1; background:var(--line)}

  .alt{text-align:center; font-size:13.5px; color:var(--muted); margin-top:20px}
  .alt a{font-weight:600}
  .under{text-align:center; font-size:13.5px; margin-top:14px; color:var(--slate)}

  .note{border-radius:var(--r-sm); padding:11px 14px; font-size:13px; margin-bottom:16px}
  .note-bad{background:var(--danger-bg); border:1px solid #EED3D0; color:var(--danger)}
  .note-ok{background:var(--ok-bg); border:1px solid #C3DCF2; color:var(--ok)}
  .note-warn{background:var(--warn-bg); border:1px solid #EDDCB2; color:var(--warn)}

  .row{display:grid; gap:13px}
  @media(min-width:560px){ .row-3{grid-template-columns:1fr 1fr 1fr} .row-2{grid-template-columns:1fr 1fr} }

  .rules{list-style:none; margin:10px 0 0; padding:0}
  .rules li{display:flex; align-items:center; gap:8px; font-size:12.5px; color:var(--faint); padding:2px 0}
  .rules li .tick{width:14px; text-align:center; font-weight:700}
  .rules li.met{color:var(--blue-deep)}

  .otp{
    width:100%; font-family:'Public Sans',monospace; font-size:30px; font-weight:700;
    letter-spacing:.3em; text-align:center; text-indent:.3em;
    padding:15px 12px; border:1.5px solid var(--line); border-radius:var(--r-sm); background:#fff;
  }
  .otp:focus{outline:none; border-color:var(--blue); box-shadow:0 0 0 3px rgba(33,133,213,.2)}
  .countdown{font-variant-numeric:tabular-nums; font-weight:700}
  .expired{color:var(--danger)}
  .sr{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
  .skip:focus{position:fixed;top:10px;left:10px;width:auto;height:auto;clip:auto;z-index:99;background:var(--blue);color:#fff;padding:10px 16px;border-radius:8px}
</style>
</head>
<body>
<a href="#form" class="sr skip">Skip to form</a>

<div class="shell">
  <div class="auth">
    <aside class="seal-panel">
      <div class="seal" role="img" aria-label="Libon Community College seal"></div>
      <p class="wordmark">SmartQ</p>
      <p class="college">Libon Community College</p>
      <p class="place">Libon, Albay</p>

      <p class="lede">Staff portal for the Cashier and Registrar queues.</p>
      <p class="blurb">
        Students do not sign in here. They scan the QR code at the office
        to get a queue number.
      </p>

      <ul class="points">
        <li>Call the next client in one click</li>
        <li>See today's queue and busy hours</li>
        <li>Queue history and reports</li>
      </ul>
    </aside>

    <main class="form-side" id="form">
      <div class="form-wrap <%= typeof wide !== 'undefined' && wide ? 'wide' : '' %>">
