<%
  const role = me.role;
  const links = role === 'admin' ? [
      ['/admin/dashboard','Dashboard'],['/admin/documents','Documents'],
      ['/admin/students','Student Accounts'],['/admin/users','Manage Staff Accounts'],
      ['/admin/requirements','Requirements'],
      ['/admin/priority','Priority Requests'],
      ['/admin/calendar','Booking Calendar'],
      ['/admin/windows','Service Windows'],
      ['/admin/history','Queue History'],
      ['/admin/reports','Reports'],['/admin/qr-poster','QR Poster'],['/admin/settings','Settings']]
    : (role === 'cashier' || role === 'registrar') ? [
      ['/staff/dashboard', role === 'cashier' ? 'Cashier Counter' : 'Registrar Counter'],
      ['/staff/calendar', 'Booking Calendar'],
      ['/staff/history', 'Queue History'],
      ['/staff/reports', 'Reports'],
      ['/staff/priority', 'Priority Requests'],
      ['/staff/documents', 'Documents'],
      ['/staff/account', 'My Account']]
    : [];   // students have no account any more; they use /queue
  const boards = role === 'cashier' ? [['/display/cashier','Cashier Board']]
               : role === 'registrar' ? [['/display/registrar','Registrar Board']]
               : [['/display/cashier','Cashier Board'],['/display/registrar','Registrar Board']];
  const activePath = typeof active !== 'undefined' ? active : '';
  const initials = (me.firstName || '?').charAt(0) + (me.lastName || '').charAt(0);
%>
<aside id="sidebar" class="fixed inset-y-0 left-0 z-40 w-64 bg-hero text-white flex flex-col shadow-pop lg:shadow-none
       -translate-x-full lg:translate-x-0 transition-transform duration-300 no-print">

  <!-- seal and wordmark -->
  <div class="px-5 py-5 flex items-center gap-3">
    <img src="/img/lcc-seal.jpg" alt="Libon Community College seal"
         class="w-11 h-11 rounded-full bg-white ring-2 ring-white/40 object-cover shrink-0">
    <div class="min-w-0">
      <div class="text-[19px] font-extrabold tracking-tight leading-none">Smart<span class="text-sky-200">Q</span></div>
      <div class="text-[11px] text-white/70 leading-tight mt-1">Libon Community College</div>
    </div>
  </div>

  <nav class="flex-1 px-3 py-2 overflow-y-auto space-y-0.5">
    <% links.forEach(function(l){ var isPr = /\/priority$/.test(l[0]); %>
    <a href="<%= l[0] %>" class="flex items-center gap-2 rounded-xl px-3.5 py-2.5 text-[13.5px] font-medium transition-colors <%=
      activePath === l[0]
        ? 'bg-white text-brand-night font-semibold shadow-card'
        : 'text-white/75 hover:text-white hover:bg-white/10' %>"><%= l[1] %>
      <% if (isPr) { %>
      <%# Red dot: priority proofs waiting for review (kept live by the script below). %>
      <span data-priority-dot data-priority-count class="pr-dot ml-auto min-w-[20px] h-5 px-1.5 rounded-full bg-red-600 text-white text-[11px] font-bold leading-5 text-center"
            <%= priorityPending ? '' : 'hidden' %> aria-label="<%= priorityPending %> waiting for review"><%= priorityPending %></span>
      <% } %>
    </a>
    <% }) %>

    <div class="px-3.5 pt-5 pb-1.5 text-[10px] font-bold uppercase tracking-widest text-white/45">Public Display</div>
    <% boards.forEach(function(b){ %>
    <a href="<%= b[0] %>" target="_blank" rel="noopener"
       class="flex items-center justify-between rounded-xl px-3.5 py-2.5 text-[13.5px] font-medium text-white/75 hover:text-white hover:bg-white/10 transition-colors"><%= b[1] %>
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true" class="opacity-60"><path d="M7 17 17 7M9 7h8v8"/></svg></a>
    <% }) %>
  </nav>

  <div class="m-3 rounded-2xl bg-white/10 px-4 py-3.5">
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 rounded-full bg-white/20 grid place-items-center text-[12.5px] font-bold shrink-0 uppercase"><%= initials %></div>
      <div class="min-w-0">
        <div class="text-[13px] font-semibold truncate"><%= me.fullName %></div>
        <div class="text-[11px] text-white/65 capitalize"><%= me.role %></div>
      </div>
    </div>
    <a href="/logout" class="mt-3 block text-center rounded-xl bg-white/15 hover:bg-white/25 px-3 py-2 text-[12.5px] font-semibold transition-colors">Log out</a>
  </div>
</aside>

<div class="lg:ml-64 flex flex-col min-h-screen">
<header class="bg-white/80 backdrop-blur-md border-b border-hair/70 h-16 flex items-center gap-3 px-5 lg:px-8 sticky top-0 z-30 no-print">
  <button id="menuBtn" class="lg:hidden relative inline-flex items-center gap-1.5 rounded-xl border border-hair bg-white px-3 py-2 text-[12.5px] font-semibold text-slateSoft" aria-label="Open menu"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>Menu
    <% if (priorityPending != null) { %>
    <span data-priority-dot class="pr-dot absolute -top-1.5 -right-1.5 w-3 h-3 rounded-full bg-red-600 ring-2 ring-white" <%= priorityPending ? '' : 'hidden' %>></span>
    <% } %>
  </button>
  <% if (priorityPending != null) { %>
  <style>
    .pr-dot:not([hidden]){ animation:pr-ping 1.6s ease-out infinite }
    @keyframes pr-ping{ 0%{box-shadow:0 0 0 0 rgba(220,38,38,.55)} 80%,100%{box-shadow:0 0 0 7px rgba(220,38,38,0)} }
    @media (prefers-reduced-motion:reduce){ .pr-dot{ animation:none !important } }
  </style>
  <script>
  // Keep the red dot live: a new priority proof shows up within seconds,
  // without reloading. On the Priority Requests page itself, reload to list it.
  (function () {
    var url = '<%= me.role === "admin" ? "/admin/priority" : "/staff/priority" %>';
    var last = <%= priorityPending %>;
    function paint(n) {
      document.querySelectorAll('[data-priority-dot]').forEach(function (d) { d.hidden = !n; });
      document.querySelectorAll('[data-priority-count]').forEach(function (d) { d.textContent = n; });
    }
    setInterval(function () {
      fetch(url + '/count', { credentials: 'same-origin', cache: 'no-store' })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (d) {
          if (!d || d.pending === last) return;
          var more = d.pending > last;
          last = d.pending;
          paint(last);
          if (more && location.pathname === url) location.reload();
        })
        .catch(function () {});
    }, 8000);
  })();
  </script>
  <% } %>
  <img src="/img/lcc-seal.jpg" alt="" width="26" height="26" class="rounded-full lg:hidden">
  <h1 class="text-[16px] font-extrabold tracking-tight text-ink truncate"><%= title %></h1>
  <span class="<%= pill %> <%= tone(me.role) %> ml-auto capitalize"><%= me.role %></span>
</header>
<main id="main" class="flex-1 p-4 sm:p-5 lg:p-8 fade-in">
<%- include('flash') %>
