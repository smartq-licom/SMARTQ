<%#
  First-time guide (coach marks, like GCash): the page dims, one part is lit,
  and a bubble explains it with Back / Next / Skip. Shown once per phone for
  each page (localStorage), replayed by the "Guide" button or ?tour=1.
  Locals: tourKey (e.g. 'home'), tourSteps = [{ sel, title, body, pane?, act?, next?, end? }]
    pane  the form step (wizard pane) the hint belongs to; shown when the student reaches it
    act   a selector clicked when this last hint is finished (e.g. open the form)
    next  the label of that last button ("Open the form")
    end   finishing this hint ends the guided walkthrough
  (a step whose element is missing or hidden is skipped).

  Guided walkthrough: "First time? Show me how" and the Guide button start a
  session (sessionStorage smartq.guide) that follows the student through the
  whole transaction: each page, and each form step as it is reached, shows its
  hints even if seen before; "Exit guide" stops it.
%>
<div id="tour" class="tour" hidden>
  <div class="tour-spot" aria-hidden="true"></div>
  <div class="tour-tip" role="dialog" aria-modal="true" aria-labelledby="tourTitle">
    <div class="tour-count" data-tour-count></div>
    <div id="tourTitle" class="tour-title" data-tour-title></div>
    <p class="tour-body" data-tour-body></p>
    <div class="tour-actions">
      <button type="button" class="tour-skip" data-tour-skip>Skip</button>
      <span class="tour-dots" data-tour-dots aria-hidden="true"></span>
      <button type="button" class="tour-back" data-tour-back>Back</button>
      <button type="button" class="tour-next" data-tour-next>Next</button>
    </div>
  </div>
</div>
<style>
  .tour{ position:fixed; inset:0; z-index:950 }
  .tour-spot{ position:fixed; border-radius:18px; pointer-events:none;
              box-shadow:0 0 0 9999px rgba(10,22,38,.62), 0 0 0 3px rgba(255,255,255,.9), 0 0 24px 4px rgba(124,196,250,.55);
              transition:top .35s cubic-bezier(.2,.8,.2,1), left .35s cubic-bezier(.2,.8,.2,1), width .35s cubic-bezier(.2,.8,.2,1), height .35s cubic-bezier(.2,.8,.2,1) }
  .tour-spot::after{ content:''; position:absolute; inset:-3px; border-radius:inherit; border:2px solid rgba(255,255,255,.7); animation:tour-ping 1.8s ease-out infinite }
  @keyframes tour-ping{ 0%{ opacity:.9; transform:scale(1) } 100%{ opacity:0; transform:scale(1.08) } }
  .tour-tip{ position:fixed; left:12px; right:12px; max-width:380px; margin:0 auto; background:var(--card-bg); border-radius:20px; padding:16px 16px 14px;
             box-shadow:0 24px 60px -12px rgba(0,0,0,.45); animation:tour-in .3s cubic-bezier(.2,.8,.2,1) both }
  .tour-tip::before{ content:''; position:absolute; left:var(--arrow,50%); width:14px; height:14px; background:var(--card-bg); transform:translateX(-50%) rotate(45deg); border-radius:3px }
  .tour-tip.below::before{ top:-6px } .tour-tip.above::before{ bottom:-6px }
  .tour-tip.inside::before{ display:none }               /* over a tall section: no arrow needed */
  .tour-tip.inside{ box-shadow:0 -8px 40px -6px rgba(0,0,0,.35), 0 24px 60px -12px rgba(0,0,0,.45) }
  @keyframes tour-in{ from{ opacity:0; transform:translateY(8px) scale(.98) } to{ opacity:1; transform:none } }
  .tour-count{ font-size:11px; font-weight:800; letter-spacing:.14em; text-transform:uppercase; color:#2185D5 }
  .tour-title{ font-size:16px; font-weight:800; color:var(--ink-c); margin-top:4px; line-height:1.3 }
  .tour-body{ font-size:13.5px; color:var(--soft-c); margin:6px 0 0; line-height:1.5 }
  .tour-body b{ color:var(--ink-c) }
  .tour-actions{ display:flex; align-items:center; gap:8px; margin-top:14px }
  .tour-skip{ font-size:13px; font-weight:600; color:var(--soft-c); padding:8px 4px }
  .tour-dots{ display:flex; gap:5px; margin-left:auto; margin-right:4px }
  .tour-dots i{ width:6px; height:6px; border-radius:999px; background:var(--line); transition:width .25s, background .25s }
  .tour-dots i.on{ width:16px; background:#2185D5 }
  .tour-back, .tour-next{ min-height:40px; padding:0 16px; border-radius:12px; font-size:13.5px; font-weight:700 }
  .tour-back{ background:var(--mist-bg); color:var(--soft-c) }
  .tour-next{ background:linear-gradient(135deg,#2E9BEA,#2185D5 50%,#1A6CAE); color:#fff; box-shadow:0 8px 18px -8px rgba(33,133,213,.8) }
  @media (prefers-reduced-motion:reduce){ .tour-spot, .tour-tip{ transition:none; animation:none } .tour-spot::after{ animation:none } }
  @media print{ .tour{ display:none !important } }
</style>
<script>
(function () {
  // only the essential hints (extra: true ones are skipped); the page whose
  // steps end the walkthrough ends it whichever of its hints is shown last
  var ALL = <%- JSON.stringify(tourSteps) %>, BASE = 'smartq.tour.<%= tourKey %>';
  var STEPS = ALL.filter(function (s) { return !s.extra; });
  var ENDS = ALL.some(function (s) { return s.end; });
  var el = document.getElementById('tour');
  if (!el || !STEPS.length) return;
  var spot = el.querySelector('.tour-spot'), tip = el.querySelector('.tour-tip');
  var steps = [], i = 0, pane = null;

  // the guided walkthrough lives for this browser tab
  var GUIDE = 'smartq.guide';
  function guiding() { try { return sessionStorage.getItem(GUIDE) === '1'; } catch (e) { return false; } }
  function setGuide(on) { try { on ? sessionStorage.setItem(GUIDE, '1') : sessionStorage.removeItem(GUIDE); } catch (e) {} }
  // the form's current step (wizard pane), when this page has one
  function curPane() { var p = document.querySelector('.wiz-pane:not([hidden])'); return p ? Number(p.dataset.pane) : null; }
  function key() { return BASE + (pane ? '#' + pane : ''); }

  function visible(n) { if (!n) return false; var r = n.getBoundingClientRect(); return r.width > 0 && r.height > 0 && !n.closest('[hidden]'); }
  function done() { try { localStorage.setItem(key(), '1'); } catch (e) {} }
  function close(finished) {
    done(); el.hidden = true; window.smartqTourOpen = false; document.documentElement.style.overflow = '';
    var last = steps[steps.length - 1];
    if (finished && ENDS) setGuide(false);                       // the walkthrough is over
    window.dispatchEvent(new Event('smartq:tour-closed'));
    if (finished && last && last.act) {                          // carry on: open the next page
      var target = document.querySelector(last.act);
      if (target) setTimeout(function () { target.click(); }, 150);
    }
  }
  function place() {
    var s = steps[i], n = document.querySelector(s.sel);
    if (!visible(n)) return go(1);                    // that part is gone: next step
    var r = n.getBoundingClientRect(), pad = 8, edge = 8;
    // the lit part, kept on screen (a tall section is lit only where it shows)
    var top = Math.max(edge, r.top - pad), bottom = Math.min(innerHeight - edge, r.bottom + pad);
    spot.style.top = top + 'px'; spot.style.left = (r.left - pad) + 'px';
    spot.style.width = (r.width + pad * 2) + 'px'; spot.style.height = Math.max(0, bottom - top) + 'px';
    // The bubble must always be seen in full: below or above the lit part where
    // it fits, otherwise (a tall section) over it, at the bottom of the screen.
    var th = tip.offsetHeight || 170, room = 14;
    var fitsBelow = r.bottom + pad + room + th <= innerHeight - edge;
    var fitsAbove = r.top - pad - room - th >= edge;
    var below = fitsBelow && (!fitsAbove || r.top + r.height / 2 < innerHeight / 2);
    var inside = !fitsBelow && !fitsAbove;
    tip.classList.toggle('below', below && !inside); tip.classList.toggle('above', !below && !inside);
    tip.classList.toggle('inside', inside);
    tip.style.top = inside ? '' : below ? (r.bottom + pad + room) + 'px' : '';
    tip.style.bottom = inside ? (edge + 4) + 'px' : below ? '' : (innerHeight - r.top + pad + room) + 'px';
    var tr = tip.getBoundingClientRect();
    tip.style.setProperty('--arrow', Math.max(24, Math.min(tr.width - 24, r.left + r.width / 2 - tr.left)) + 'px');
  }
  function show() {
    var s = steps[i];
    el.querySelector('[data-tour-count]').textContent = 'Step ' + (i + 1) + ' of ' + steps.length;
    el.querySelector('[data-tour-title]').textContent = s.title;
    el.querySelector('[data-tour-body]').innerHTML = s.body;     // our own text (bold allowed)
    el.querySelector('[data-tour-back]').hidden = i === 0;
    var lastOne = i === steps.length - 1;
    el.querySelector('[data-tour-next]').textContent = lastOne ? (s.next || (s.end ? 'Finish' : 'Got it')) : 'Next';
    el.querySelector('[data-tour-skip]').textContent = guiding() ? 'Exit guide' : 'Skip';
    el.querySelector('[data-tour-dots]').innerHTML = steps.map(function (_, k) { return '<i class="' + (k === i ? 'on' : '') + '"></i>'; }).join('');
    tip.style.animation = 'none'; void tip.offsetWidth; tip.style.animation = '';
    var n = document.querySelector(s.sel);
    if (n) {
      // a tall section: its top under the header, so it starts on screen; otherwise centred
      var tall = n.getBoundingClientRect().height > innerHeight * 0.5;
      if (tall) window.scrollTo({ top: Math.max(0, n.getBoundingClientRect().top + scrollY - 84), behavior: 'auto' });
      else n.scrollIntoView({ block: 'center', behavior: 'instant' in document.documentElement.style ? 'instant' : 'auto' });
    }
    setTimeout(place, 60);
    setTimeout(place, 750);                            // again once any entrance animation has settled
  }
  function go(d) {
    var j = i + d;
    if (j >= steps.length) return close(true);
    if (j < 0) j = 0;
    i = j; show();
  }
  function start(force) {
    pane = curPane();
    steps = STEPS.filter(function (s) { return (s.pane == null || s.pane === pane) && visible(document.querySelector(s.sel)); });
    if (!steps.length) return;
    // never on its own: only the walkthrough someone asked for (Show me how, Guide, ?tour=1)
    if (!force && !guiding()) return;
    document.body.appendChild(el);                     // never boxed in by an animated parent
    i = 0; el.hidden = false; window.smartqTourOpen = true; show();
  }
  el.querySelector('[data-tour-next]').addEventListener('click', function () { go(1); });
  el.querySelector('[data-tour-back]').addEventListener('click', function () { go(-1); });
  el.querySelector('[data-tour-skip]').addEventListener('click', function () { setGuide(false); close(false); });
  document.addEventListener('keydown', function (e) { if (!el.hidden && e.key === 'Escape') { setGuide(false); close(false); } });
  addEventListener('resize', function () { if (!el.hidden) place(); });
  addEventListener('scroll', function () { if (!el.hidden) place(); }, { passive: true });
  // the Guide button and "Show me how": the whole walkthrough, from this page on
  window.smartqTour = function () { setGuide(true); start(true); };
  document.querySelectorAll('[data-tour-open]').forEach(function (b) { b.hidden = false; });
  // the form's next step reached: its hints (during the walkthrough, or the first time)
  window.addEventListener('smartq:wizard', function () {
    if (!el.hidden) return;
    setTimeout(function () { start(false); }, 650);           // after the step's slide-in
  });

  // first visit: after the welcome screen is gone
  var force = /[?&]tour=1(&|$)/.test(location.search);
  function wait() {
    var w = document.getElementById('welcome');
    if (w && !w.hidden) return setTimeout(wait, 600);
    setTimeout(function () { start(force || guiding()); }, guiding() ? 700 : 1300);   // after any opening animation
  }
  if (document.readyState === 'complete') wait(); else addEventListener('load', wait);
})();
</script>
