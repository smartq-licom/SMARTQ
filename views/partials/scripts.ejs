<%- include('modal') %>
<script>
// Countdowns ("time left at the window") and submit-once forms. Both also run
// on parts of the page that update themselves (partials/live).
function smartqCountdown(root){ (root || document).querySelectorAll('[data-countdown]').forEach(function(el){
  if (el.dataset.ticking) return; el.dataset.ticking = '1';
  var s = parseInt(el.dataset.seconds || '0', 10);
  (function tick(){
    if (!el.isConnected) return;                       // replaced by an update
    if (s <= 0) { el.textContent = '00:00'; if (window.smartqLive) window.smartqLive(true); else location.reload(); return; }
    var m = Math.floor(s/60), r = s%60;
    el.textContent = String(m).padStart(2,'0')+':'+String(r).padStart(2,'0');
    s--; setTimeout(tick, 1000);
  })();
}); }
function smartqOnce(root){ (root || document).querySelectorAll('form[data-once]').forEach(function(f){
  if (f.dataset.onceBound) return; f.dataset.onceBound = '1';
  f.addEventListener('submit', function(){
    var b = f.querySelector('[type=submit]');
    if (b) { b.disabled = true; b.textContent = 'Please wait...'; }
  });
}); }
smartqCountdown(document);
smartqOnce(document);
window.addEventListener('smartq:updated', function (e) {
  var root = (e.detail && e.detail.root) || document;
  smartqCountdown(root);
});
var mb = document.getElementById('menuBtn'), sb = document.getElementById('sidebar');
if (mb && sb) mb.addEventListener('click', function(){ sb.classList.toggle('-translate-x-full'); });

// Keep the reader's place. A button (form submit) or an automatic refresh
// reloads the same page; return to where they were instead of the top.
// A different page, a #link, or an error message still opens at the top.
(function () {
  var KEY = 'smartq.scroll';
  function save() {
    try { sessionStorage.setItem(KEY, JSON.stringify({ p: location.pathname, y: window.scrollY, t: Date.now() })); } catch (e) {}
  }
  window.addEventListener('pagehide', save);
  window.addEventListener('beforeunload', save);

  var saved = null;
  try { saved = JSON.parse(sessionStorage.getItem(KEY) || 'null'); sessionStorage.removeItem(KEY); } catch (e) {}
  if (!saved || saved.p !== location.pathname || Date.now() - saved.t > 30000 || !saved.y) return;
  var errorShown = [].some.call(document.querySelectorAll('[role="alert"]'), function (el) {
    return el.offsetParent !== null && el.textContent.trim() !== '';     // a visible message, not an empty slot
  });
  if (location.hash || errorShown) return;          // let errors be seen
  function go() { window.scrollTo(0, saved.y); }
  go();
  window.addEventListener('load', go);              // again once images have their size
})();
</script>
</body></html>
<script>
// Estimated time counts down live so the number never looks frozen.
function smartqEta(el) {
  var secs = parseInt(el.dataset.seconds || '0', 10);
  var unit = el.parentElement.querySelector('[data-eta-unit]');
  (function tick() {
    if (secs <= 0) {
      el.textContent = 'any moment';
      el.classList.remove('font-mono');
      el.classList.add('text-2xl');
      if (unit) unit.textContent = 'now';
      return;
    }
    if (secs >= 3600) {                              // 7 h 52 min, not 472 minutes
      var mm = Math.round(secs / 60);
      el.textContent = Math.floor(mm / 60) + ' h ' + (mm % 60);
      if (unit) unit.textContent = 'min';
    } else if (secs >= 120) {
      el.textContent = Math.round(secs / 60);
      if (unit) unit.textContent = 'minutes';
    } else if (secs >= 60) {
      el.textContent = '1';
      if (unit) unit.textContent = 'minute';
    } else {
      el.textContent = secs;
      if (unit) unit.textContent = 'seconds';
    }
    secs--;
    if (el.isConnected) setTimeout(tick, 1000);       // stops once the part is replaced
  })();
}
document.querySelectorAll('[data-eta]').forEach(smartqEta);
window.smartqEta = smartqEta;
window.addEventListener('smartq:updated', function (e) {
  var root = (e.detail && e.detail.root) || document;
  root.querySelectorAll('[data-eta]').forEach(smartqEta);
  smartqOnce(root);
});
</script>
