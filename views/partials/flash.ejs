<%# Success / error messages after a form, shared by every layout. %>
<% if (flash) { %>
<div role="status" class="mb-4 flex items-start gap-3 rounded-xl bg-brand-wash ring-1 ring-inset ring-brand-line px-4 py-3 text-[13.5px] font-medium text-brand-night fade-in">
  <svg class="mt-0.5 shrink-0 text-brand" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/></svg>
  <span><%= flash %></span>
</div>
<% } %>
<% if (error) { %>
<div role="alert" class="mb-4 flex items-start gap-3 rounded-xl bg-red-50 ring-1 ring-inset ring-red-200 px-4 py-3 text-[13.5px] font-medium text-red-900 fade-in">
  <svg class="mt-0.5 shrink-0 text-red-600" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7.5v5.5M12 16.5h.01"/></svg>
  <span><%= error %></span>
</div>
<% } %>
