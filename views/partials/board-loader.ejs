<%#
  Loading screen between a ticket and its office's TV board, both ways.
  A link with data-loader-go (and data-loader-text, data-loader-icon = tv | queue,
  data-loader-mode = back for the sweep back to a ticket)
  shows it at once and then opens the page; the page that opens shows the same
  screen from the first paint and fades it away once it has loaded, so the trip
  reads as one motion. Plain CSS (the board and the student pages share it).
%>
<div id="boardLoader" class="bl" hidden aria-live="polite">
  <div class="bl-in">
    <div class="bl-icon" aria-hidden="true">
      <svg data-bl="tv" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4.5" width="18" height="12" rx="2"/><path d="M8.5 20h7M12 16.5V20"/></svg>
      <svg data-bl="queue" class="bl-qsvg" width="72" height="36" viewBox="0 0 140 70" fill="none" style="display:none">
        <defs>
          <linearGradient id="blFade" x1="0" x2="1">
            <stop offset="0" stop-color="#fff" stop-opacity="0"/><stop offset=".14" stop-color="#fff"/>
            <stop offset=".66" stop-color="#fff"/><stop offset=".76" stop-color="#fff" stop-opacity="0"/>
          </linearGradient>
          <mask id="blLine"><rect width="140" height="70" fill="url(#blFade)"/></mask>
        </defs>
        <line x1="4" y1="63" x2="136" y2="63" stroke="#fff" stroke-opacity=".35" stroke-width="2.5" stroke-linecap="round"/>
        <g mask="url(#blLine)">
          <g class="bl-line">
            <g transform="translate(-16 0)"><circle cx="0" cy="29" r="5.5" fill="#fff"/><rect x="-6.5" y="37" width="13" height="23" rx="6.5" fill="#fff"/></g>
            <g transform="translate(6 0)"><circle cx="0" cy="29" r="5.5" fill="#fff"/><rect x="-6.5" y="37" width="13" height="23" rx="6.5" fill="#fff"/></g>
            <g transform="translate(28 0)"><circle cx="0" cy="29" r="5.5" fill="#fff"/><rect x="-6.5" y="37" width="13" height="23" rx="6.5" fill="#fff"/></g>
            <g transform="translate(50 0)"><circle cx="0" cy="29" r="5.5" fill="#fff"/><rect x="-6.5" y="37" width="13" height="23" rx="6.5" fill="#fff"/></g>
            <g transform="translate(72 0)"><circle cx="0" cy="29" r="5.5" fill="#fff"/><rect x="-6.5" y="37" width="13" height="23" rx="6.5" fill="#fff"/></g>
            <g transform="translate(94 0)"><circle cx="0" cy="29" r="5.5" fill="#fff"/><rect x="-6.5" y="37" width="13" height="23" rx="6.5" fill="#fff"/></g>
          </g>
        </g>
        <rect x="108" y="16" width="28" height="47" rx="4" fill="#fff" fill-opacity=".92"/>
        <rect x="112.5" y="22" width="19" height="15" rx="2.5" fill="#1A6CAE"/>
        <circle class="bl-lamp" cx="122" cy="45" r="3" fill="#34d399"/>
      </svg>
    </div>
    <div class="bl-text" data-bl-text>Loading</div>
    <div class="bl-dots" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="bl-bar" aria-hidden="true"><i></i></div>
  </div>
</div>
<style>
  .bl{ position:fixed; inset:0; z-index:2000; display:grid; place-items:center;
       background:linear-gradient(150deg,#2E9BEA 0%,#2185D5 45%,#123f6b 100%); color:#fff;
       font-family:inherit; transition:opacity .35s ease }
  .bl[hidden]{ display:none !important }
  .bl.bl-show{ animation:bl-fade .22s ease both }
  .bl.bl-out{ opacity:0; pointer-events:none }
  @keyframes bl-fade{ from{ opacity:0 } to{ opacity:1 } }
  .bl-in{ display:flex; flex-direction:column; align-items:center; gap:16px; padding:24px; text-align:center }
  .bl-icon{ position:relative; display:grid; place-items:center; width:76px; height:76px; border-radius:999px; background:rgba(255,255,255,.16) }
  .bl-icon::after{ content:''; position:absolute; inset:-6px; border-radius:inherit; border:2px solid rgba(255,255,255,.55); animation:bl-ping 1.4s ease-out infinite }
  @keyframes bl-ping{ 0%{ opacity:.9; transform:scale(.92) } 100%{ opacity:0; transform:scale(1.25) } }
  .bl-text{ font-size:17px; font-weight:800; letter-spacing:-.01em }
  .bl-dots{ display:flex; gap:7px }
  .bl-dots i{ width:8px; height:8px; border-radius:999px; background:#fff; opacity:.4; animation:bl-dot 1s ease-in-out infinite }
  .bl-dots i:nth-child(2){ animation-delay:.15s } .bl-dots i:nth-child(3){ animation-delay:.3s }
  @keyframes bl-dot{ 0%,100%{ opacity:.35; transform:translateY(0) } 40%{ opacity:1; transform:translateY(-6px) } }
  .bl-bar{ display:none; width:140px; height:4px; border-radius:999px; background:rgba(255,255,255,.25); overflow:hidden }
  .bl-bar i{ display:block; width:40%; height:100%; border-radius:inherit; background:#fff; animation:bl-bar 1s cubic-bezier(.6,0,.4,1) infinite }
  @keyframes bl-bar{ from{ transform:translateX(-110%) } to{ transform:translateX(260%) } }
  /* back to the ticket: a sweep from the left (like going back a page) with a line of
     people stepping toward a window; it leaves to the right, uncovering the ticket */
  .bl.bl-back{ background:linear-gradient(210deg,#2E9BEA 0%,#1A6CAE 55%,#0f3459 100%); transition:transform .38s cubic-bezier(.7,0,.3,1) }
  .bl.bl-back.bl-show{ animation:bl-sweep .32s cubic-bezier(.2,.8,.2,1) both }
  .bl.bl-back.bl-out{ opacity:1; transform:translateX(100%) }
  @keyframes bl-sweep{ from{ transform:translateX(-100%) } to{ transform:none } }
  .bl-back .bl-icon{ width:auto; height:auto; background:none; border-radius:0 }
  .bl-back .bl-icon::after{ display:none }
  .bl-back .bl-in{ gap:10px } .bl-back .bl-text{ font-size:15px; font-weight:700; opacity:.92 }
  .bl-back .bl-dots{ display:none }
  /* the queue: the line steps forward one place toward the window, pauses,
     steps again; the one in front reaches the window (its lamp blinks) */
  .bl-qsvg *{ transform-box:view-box }
  .bl-line{ animation:bl-advance 1.1s cubic-bezier(.45,0,.2,1) infinite }
  @keyframes bl-advance{ 0%{ transform:translate(0,0) } 25%{ transform:translate(11px,-2.5px) } 55%,100%{ transform:translate(22px,0) } }
  .bl-lamp{ animation:bl-lamp 1.1s ease-in-out infinite }
  @keyframes bl-lamp{ 0%,40%{ opacity:.35 } 55%,80%{ opacity:1 } 100%{ opacity:.35 } }
  @media (prefers-reduced-motion:reduce){ .bl, .bl.bl-show, .bl.bl-back, .bl.bl-back.bl-show{ animation:none; transition:none } .bl-icon::after, .bl-dots i, .bl-bar i, .bl-line, .bl-lamp{ animation:none } }
  @media print{ .bl{ display:none !important } }
</style>
<script>
(function () {
  var KEY = 'smartq.loader', el = document.getElementById('boardLoader');
  if (!el) return;
  function set(text, icon, mode) {
    el.classList.toggle('bl-back', mode === 'back');
    el.querySelector('[data-bl-text]').textContent = text;
    el.querySelectorAll('[data-bl]').forEach(function (s) { s.style.display = s.getAttribute('data-bl') === (icon || 'tv') ? '' : 'none'; });   // SVGs have no .hidden
  }
  function show(text, icon, mode) { set(text, icon, mode); el.classList.remove('bl-out'); el.hidden = false; el.classList.add('bl-show'); }
  function hide() { el.classList.add('bl-out'); setTimeout(function () { el.hidden = true; el.classList.remove('bl-show', 'bl-out', 'bl-back'); }, 400); }

  // arriving: the same screen from the first paint, then away once loaded
  var came = null;
  try { came = JSON.parse(sessionStorage.getItem(KEY) || 'null'); sessionStorage.removeItem(KEY); } catch (e) {}
  if (came && Date.now() - came.t < 15000) {
    show(came.text, came.icon, came.mode);
    el.classList.remove('bl-show');                       // already on screen: no second fade-in
    var t0 = Date.now();
    function done() { setTimeout(hide, Math.max(0, 450 - (Date.now() - t0))); }
    if (document.readyState === 'complete') done(); else addEventListener('load', done);
  }

  // leaving: show it at once, then go
  document.addEventListener('click', function (e) {
    var a = e.target.closest && e.target.closest('a[data-loader-go]');
    if (!a || e.defaultPrevented || e.button || e.metaKey || e.ctrlKey || e.shiftKey) return;
    e.preventDefault();
    var text = a.getAttribute('data-loader-text') || 'Loading', icon = a.getAttribute('data-loader-icon') || 'tv', mode = a.getAttribute('data-loader-mode') || '';
    try { sessionStorage.setItem(KEY, JSON.stringify({ text: text, icon: icon, mode: mode, t: Date.now() })); } catch (err) {}
    show(text, icon, mode);
    setTimeout(function () { location.href = a.href; }, mode === 'back' ? 330 : 280);
  });
  // back/forward from the browser's cache: never left covering the page
  addEventListener('pageshow', function (e) { if (e.persisted) { el.hidden = true; el.classList.remove('bl-show', 'bl-out'); } });
})();
</script>
