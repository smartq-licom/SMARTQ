<%- include('../../partials/auth-top', { title: title }) %>

  <h1 class="page-title"><%= mode === 'account_recovery' ? 'Recover your account' : 'Reset your password' %></h1>
  <p class="subtitle">
    <% if (mode === 'account_recovery') { %>
      Enter the Gmail address on your account and we will send a recovery code.
    <% } else { %>
      Enter your registered Gmail address and we will send a code to reset your password.
    <% } %>
  </p>

  <%- include('../../partials/auth-notes') %>

  <div class="card">
    <form method="POST" action="/forgot-password" data-once>
      <input type="hidden" name="mode" value="<%= mode %>">
      <div class="field">
        <label for="email"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>Gmail or email address</label>
        <input id="email" name="email" type="email" class="control" required autofocus autocomplete="email">
      </div>
      <button type="submit" class="btn btn-primary" data-busy="Sending...">Send code</button>
    </form>
  </div>

  <p class="alt"><a href="/">Back to sign in</a></p>
  <% if (mode !== 'account_recovery') { %>
  <p class="under" style="color:var(--faint)">
    Cannot access that address either? <a href="/recover">Recover your account</a>
  </p>
  <% } %>

<%- include('../../partials/auth-bottom') %>
