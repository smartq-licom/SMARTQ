<%- include('../../partials/auth-top', { title: title }) %>

  <h1 class="page-title">Choose a new password</h1>
  <p class="subtitle">Your code checked out. Set a password you have not used before.</p>

  <%- include('../../partials/auth-notes') %>

  <div class="card">
    <form method="POST" action="/reset-password" data-once>
      <div class="field">
        <label for="newPassword"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>New password</label>
        <div class="pw-wrap">
          <input id="newPassword" name="newPassword" type="password" class="control"
                 required autocomplete="new-password" autofocus data-rules-for="pwrules">
          <button type="button" class="pw-toggle" data-pw="newPassword" aria-label="Show password">Show</button>
        </div>
        <ul class="rules" id="pwrules">
          <% rules.forEach(function(r){ %>
          <li><span class="tick">&middot;</span><%= r.label %></li>
          <% }) %>
        </ul>
      </div>

      <div class="field">
        <label for="confirmPassword"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>Confirm new password</label>
        <div class="pw-wrap">
          <input id="confirmPassword" name="confirmPassword" type="password" class="control"
                 required autocomplete="new-password">
          <button type="button" class="pw-toggle" data-pw="confirmPassword" aria-label="Show password">Show</button>
        </div>
      </div>

      <button type="submit" class="btn btn-primary" data-busy="Updating...">Update password</button>
    </form>
  </div>

  <p class="alt"><a href="/">Back to sign in</a></p>

<%- include('../../partials/auth-bottom') %>
