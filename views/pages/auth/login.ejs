<%- include('../../partials/auth-top', { title: title }) %>
<%- include('../../partials/intro') %>

  <h1 class="page-title">Staff sign in</h1>
  <p class="subtitle">For the admin, Cashier and Registrar staff.</p>

  <%- include('../../partials/auth-notes') %>

  <div class="card">
    <form method="POST" action="/login" data-once>
      <input type="hidden" name="next" value="<%= next %>">

      <div class="field">
        <label for="identifier"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>Username</label>
        <input id="identifier" name="identifier" class="control" required autofocus
               autocomplete="username" placeholder="Your username">
      </div>

      <div class="field">
        <label for="password"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>Password</label>
        <div class="pw-wrap">
          <input id="password" name="password" type="password" class="control"
                 required autocomplete="current-password">
          <button type="button" class="pw-toggle" data-pw="password" aria-label="Show password">Show</button>
        </div>
      </div>

      <button type="submit" class="btn btn-primary" data-busy="Signing in...">Sign in</button>
    </form>

    <p class="under">Forgot password? Ask the admin to reset it, or <a href="/forgot-password">click here</a>.</p>
  </div>

  <p class="alt">Student or visitor? No account needed. <a href="/queue">Get a queue number</a></p>


<%- include('../../partials/auth-bottom') %>
