<%- include('../../partials/auth-top', { title: title }) %>

  <h1 class="page-title">Sign in</h1>
  <p class="subtitle">Use the username or the Gmail address on your account.</p>

  <%- include('../../partials/auth-notes') %>

  <div class="card">
    <form method="POST" action="/login" data-once>
      <input type="hidden" name="next" value="<%= next %>">

      <div class="field">
        <label for="identifier"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>Username or Gmail</label>
        <input id="identifier" name="identifier" class="control" required autofocus
               autocomplete="username" placeholder="juan123 or juan@gmail.com">
      </div>

      <div class="field">
        <label for="password"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>Password</label>
        <div class="pw-wrap">
          <input id="password" name="password" type="password" class="control"
                 required autocomplete="current-password">
          <button type="button" class="pw-toggle" data-pw="password" aria-label="Show password">Show</button>
        </div>
      </div>

      <button type="submit" class="btn btn-primary" data-busy="Signing in...">Sign in</button>
    </form>

    <p class="under">Forgot password? <a href="/forgot-password">Click here</a></p>

    <div class="divider">or</div>
    <%- include('../../partials/auth-google') %>
  </div>

  <p class="alt">New to SmartQ? <a href="/register">Create an account</a></p>
  <p class="under" style="color:var(--faint)">
    Locked out for another reason? <a href="/recover">Recover your account</a>
  </p>

  <details style="margin-top:22px">
    <summary style="cursor:pointer;font-size:12.5px;color:var(--muted)">Accounts for testing</summary>
    <div style="margin-top:8px;padding:14px;background:#fff;border:1px solid var(--line-light);border-radius:var(--r-sm)">
      <table style="width:100%;font-size:12.5px;border-collapse:collapse">
        <tbody>
          <% [['admin','admin123','Admin'],['cashier1','cashier123','Cashier'],
              ['registrar1','registrar123','Registrar 1'],['registrar2','registrar123','Registrar 2'],
              ['juan123','student123','Student'],['liza123','student123','Student, priority']].forEach(function(r){ %>
          <tr>
            <td style="padding:3px 0;font-weight:600"><%= r[0] %></td>
            <td style="padding:3px 0;color:var(--muted)"><%= r[1] %></td>
            <td style="padding:3px 0;color:var(--faint);text-align:right"><%= r[2] %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <p class="hint" style="margin-top:10px">
        Students also sign in with their Gmail. Staff have no email on file, so they skip the code step.
      </p>
    </div>
  </details>

<%- include('../../partials/auth-bottom') %>
