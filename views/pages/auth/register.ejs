<%- include('../../partials/auth-top', { title: title, wide: true }) %>

  <h1 class="page-title">Create your account</h1>
  <p class="subtitle">We will email you a 6-digit code to confirm the address.</p>

  <%- include('../../partials/auth-notes') %>

  <div class="card">
    <form method="POST" action="/register" data-once>
      <p class="secgroup">Your name</p>
      <%- include('../../partials/name-fields', { nf: {
            firstName: form.firstName, middleName: form.middleName, lastName: form.lastName,
            gridClass: 'row row-3', lblClass: '', inputClass: 'control', noneClass: 'text-[12px]'
          } }) %>

      <p class="secgroup">Sign-in details</p>
      <div class="row">
        <div class="field">
          <label for="username"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>Username</label>
          <input id="username" name="username" class="control" required autocomplete="username"
                 value="<%= form.username || '' %>" placeholder="juan123">
          <span class="hint">Letters, numbers, dot, dash and underscore.</span>
        </div>
        <div class="field">
          <label for="email"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>Gmail or email address</label>
          <input id="email" name="email" type="email" class="control" required autocomplete="email"
                 value="<%= form.email || '' %>" placeholder="juan@gmail.com">
          <span class="hint">Your code is sent here.</span>
        </div>
      </div>

      <div class="field">
        <label for="contactNo"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M12 18h.01"/></svg>Contact number <span class="req">optional</span></label>
        <input id="contactNo" name="contactNo" class="control" value="<%= form.contactNo || '' %>"
               placeholder="09XXXXXXXXX" style="max-width:220px">
      </div>

      <p class="secgroup">Choose a password</p>
      <div class="row">
        <div class="field">
          <label for="password"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>Password</label>
          <div class="pw-wrap">
            <input id="password" name="password" type="password" class="control" required
                   autocomplete="new-password" data-rules-for="pwrules">
            <button type="button" class="pw-toggle" data-pw="password" aria-label="Show password">Show</button>
          </div>
          <ul class="rules" id="pwrules">
            <% rules.forEach(function(r){ %>
            <li><span class="tick">&middot;</span><%= r.label %></li>
            <% }) %>
          </ul>
        </div>
        <div class="field">
          <label for="confirmPassword"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>Confirm password</label>
          <div class="pw-wrap">
            <input id="confirmPassword" name="confirmPassword" type="password" class="control"
                   required autocomplete="new-password">
            <button type="button" class="pw-toggle" data-pw="confirmPassword" aria-label="Show password">Show</button>
          </div>
        </div>
      </div>

      <button type="submit" class="btn btn-primary" data-busy="Creating your account...">Create account</button>
    </form>

    <div class="divider">or</div>
    <%- include('../../partials/auth-google') %>
  </div>

  <p class="alt">Already have an account? <a href="/">Sign in</a></p>

<%- include('../../partials/auth-bottom') %>
