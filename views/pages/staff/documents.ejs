<%- include('../../partials/head') %>
<%- include('../../partials/nav', { active: '/staff/documents' }) %>

<div class="mb-5">
  <h2 class="text-xl font-extrabold text-ink"><%= office %> documents</h2>
  <p class="text-[13px] text-slateSoft/80 mt-0.5">
    Documents handled by your office. Prices are set by the administrator.
  </p>
</div>

<div class="grid lg:grid-cols-3 gap-4">
  <div class="lg:col-span-2 <%= UI.card %> overflow-x-auto">
    <table class="w-full">
      <thead><tr>
        <th class="<%= UI.th %>">Document</th>
        <th class="<%= UI.th %>">Price</th>
        <th class="<%= UI.th %>">To claim</th>
        <th class="<%= UI.th %>">Guests</th>
        <th class="<%= UI.th %>">Minutes</th>
        <th class="<%= UI.th %>">Release after</th>
        <th class="<%= UI.th %>">Status</th>
        <th class="<%= UI.th %>"></th>
      </tr></thead>
      <tbody>
        <% documents.forEach(function(d){ %>
        <tr class="<%= UI.tr %>">
          <td class="<%= UI.td %> font-semibold"><%= d.name %>
            <% if ((byDocument[d.id] || []).length) { %>
            <span class="block text-[11px] text-slateSoft/70"><%= byDocument[d.id].length %> requirement<%= byDocument[d.id].length === 1 ? '' : 's' %></span>
            <% } %>
          </td>
          <td class="<%= UI.td %> font-mono">
            <% if (d.paymentRequired) { %>
              <%= d.price > 0 ? peso(d.price) : '<span class="text-amber-700">not priced</span>' %>
            <% } else { %><span class="text-slateSoft/60">free</span><% } %>
          </td>
          <td class="<%= UI.td %>"><%= d.requiresClaim ? 'Yes' : 'No' %></td>
          <td class="<%= UI.td %>"><%= d.guestAllowed ? 'Yes' : 'No' %></td>
          <td class="<%= UI.td %> font-mono"><%= d.baselineMinutes %></td>
          <td class="<%= UI.td %>"><%= d.processingDays ? d.processingDays + ' days' : 'same day' %></td>
          <td class="<%= UI.td %>">
            <span class="<%= pill %> <%= d.isActive ? tone('paid') : tone('cancelled') %>">
              <%= d.isActive ? 'active' : 'disabled' %>
            </span>
          </td>
          <td class="<%= UI.td %> whitespace-nowrap">
            <button type="button" class="<%= UI.btn %> <%= UI.btnGh %> <%= UI.btnSm %>"
                    data-doc="<%= JSON.stringify(d) %>" onclick="editDoc(JSON.parse(this.dataset.doc))">Edit</button>
            <form method="POST" action="/staff/documents/<%= d.id %>/delete" class="inline"
                  data-confirm data-confirm-danger="1"
                  data-confirm-title="Delete document?"
                  data-confirm-body="Delete &quot;<%= d.name %>&quot;? Students will no longer be able to request it."
                  data-confirm-note="Old tickets and receipts that used it keep showing its name."
                  data-confirm-ok="Delete" data-confirm-back="Keep it">
              <button type="submit" class="<%= UI.btn %> <%= UI.btnSm %> border border-red-200 bg-red-50 text-red-800 hover:bg-red-100">Delete</button>
            </form>
          </td>
        </tr>
        <% }) %>
        <% if (!documents.length) { %>
        <tr><td colspan="8" class="px-4 py-8 text-center text-[13px] text-slateSoft/70">No documents yet.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <div>
    <div class="<%= UI.card %> sticky top-20">
      <div class="<%= UI.cardHd %>">
        <h3 class="<%= UI.cardTtl %>" id="formTitle">Add a document</h3>
        <button type="button" id="resetBtn" hidden onclick="resetDoc()"
                class="text-[12px] font-semibold text-brand">New</button>
      </div>
      <div class="<%= UI.body %>">
        <form method="POST" action="/staff/documents" class="space-y-3" id="docForm">
          <input type="hidden" name="id" id="docId" value="">
          <div>
            <label for="name" class="<%= UI.lbl %>">Document name</label>
            <input id="name" name="name" class="<%= UI.input %>" required>
          </div>
          <div>
            <label for="baselineMinutes" class="<%= UI.lbl %>">Typical minutes to serve</label>
            <input id="baselineMinutes" name="baselineMinutes" type="number" min="1" max="120"
                   value="10" class="<%= UI.input %>">
          </div>
          <div>
            <label for="processingDays" class="<%= UI.lbl %>">Release after (days)</label>
            <input id="processingDays" name="processingDays" type="number" min="0" max="60" value="0" class="<%= UI.input %>">
            <span class="<%= UI.hint %>">Days after payment before it can be released. 0 = same day.</span>
          </div>
          <label class="flex items-center gap-2 text-[12.5px]">
            <input type="checkbox" name="requiresClaim" id="requiresClaim" value="1" class="rounded border-hair">
            Something is collected afterwards
          </label>
          <label class="flex items-center gap-2 text-[12.5px]">
            <input type="checkbox" name="guestAllowed" id="guestAllowed" value="1" class="rounded border-hair">
            Guests and alumni may request it
          </label>
          <label class="flex items-center gap-2 text-[12.5px]">
            <input type="checkbox" name="isActive" id="isActive" value="1" checked class="rounded border-hair">
            Available to request
          </label>

          <% if (office === 'Cashier') { %>
          <p class="rounded-lg bg-amber-50 border border-amber-200 px-3.5 py-2.5 text-[12px] text-amber-900">
            A new Cashier document starts unpriced and disabled. An administrator
            sets the price before students can request it.
          </p>
          <% } %>

          <button type="submit" class="<%= UI.btn %> <%= UI.btnMain %> w-full">Save document</button>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
function editDoc(d){
  document.getElementById('docId').value = d.id;
  document.getElementById('name').value = d.name;
  document.getElementById('baselineMinutes').value = d.baselineMinutes;
  document.getElementById('processingDays').value = d.processingDays || 0;
  document.getElementById('requiresClaim').checked = d.requiresClaim;
  document.getElementById('guestAllowed').checked = d.guestAllowed;
  document.getElementById('isActive').checked = d.isActive;
  document.getElementById('formTitle').textContent = 'Edit ' + d.name;
  document.getElementById('resetBtn').hidden = false;
  document.getElementById('name').focus();
}
function resetDoc(){
  document.getElementById('docForm').reset();
  document.getElementById('docId').value = '';
  document.getElementById('formTitle').textContent = 'Add a document';
  document.getElementById('resetBtn').hidden = true;
}
</script>

<%- include('../../partials/foot') %>
<%- include('../../partials/scripts') %>
