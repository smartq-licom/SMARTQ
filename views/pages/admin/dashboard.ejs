<%- include('../../partials/head') %>
<%- include('../../partials/nav', { active: '/admin/dashboard' }) %>
<%
  const hr = new Date().getHours();
  const hello = hr < 12 ? 'Good morning' : hr < 18 ? 'Good afternoon' : 'Good evening';
  const kpis = [
    ['Transactions', reports.summary.total, 'bg-brand-wash text-brand', '<path d="M4 6h16M4 12h16M4 18h10"/>'],
    ['Completed', reports.summary.completed, 'bg-emerald-50 text-emerald-600', '<path d="m5 12 4.5 4.5L19 7"/>'],
    ['Collected', peso(reports.summary.collected), 'bg-violet-50 text-violet-600', '<path d="M8 21V3.5h5.5a4.5 4.5 0 0 1 0 9H8M5 7h14M5 10h14"/>'],
    ['Cancelled', reports.summary.cancelled, 'bg-red-50 text-red-600', '<path d="M6 6l12 12M18 6 6 18"/>'],
  ];
%>
<div class="max-w-[1400px]">
<div class="mb-5">
  <p class="text-[13px] font-semibold text-brand"><%= hello %>, <%= me.firstName %></p>
  <h2 class="text-[24px] font-extrabold tracking-tight">Today at a glance</h2>
  <p class="text-[12.5px] text-slateSoft/70"><%= new Date().toLocaleDateString('en-PH', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' }) %></p>
</div>

<div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-4">
  <% kpis.forEach(function(c){ %>
  <div class="rise <%= UI.card %> p-4 flex items-center gap-3.5">
    <span class="grid place-items-center w-11 h-11 rounded-xl <%= c[2] %> shrink-0" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><%- c[3] %></svg>
    </span>
    <div class="min-w-0">
      <div class="font-mono text-[22px] font-extrabold leading-none truncate"><%= c[1] %></div>
      <div class="text-[11.5px] font-medium text-slateSoft/70 mt-1"><%= c[0] %></div>
    </div>
  </div>
  <% }) %>
</div>

<div class="grid sm:grid-cols-2 gap-3 mb-4">
  <% ['Cashier','Registrar'].forEach(function(d){ const L = load[d]; %>
  <div class="<%= UI.card %> p-5">
    <div class="flex items-center justify-between mb-3">
      <span class="text-[14px] font-bold"><%= d %></span>
      <span class="<%= pill %> <%= tone(L.level) %> capitalize"><%= L.level %></span>
    </div>
    <div class="flex items-end justify-between gap-4">
      <div><div class="font-mono text-[34px] font-extrabold leading-none"><%= L.waiting %></div>
        <div class="text-[12px] text-slateSoft/70 mt-1">waiting now</div></div>
      <div class="text-right"><div class="font-mono text-[14px] font-bold"><%= L.issued %> <span class="text-slateSoft/50">/ <%= L.capacity %></span></div>
        <div class="text-[11.5px] text-slateSoft/70"><%= L.remaining %> numbers left today</div></div>
    </div>
    <div class="h-2 rounded-full bg-mist mt-3.5 overflow-hidden">
      <div class="h-full rounded-full transition-all <%= L.level==='full'?'bg-red-500':L.level==='busy'?'bg-amber-500':'bg-emerald-500' %>" style="width:<%= L.percent %>%"></div>
    </div>
  </div>
  <% }) %>
</div>

<div class="mb-4">
  <%- include('../../partials/release-outlook', { outlook: releaseOutlook, compact: true }) %>
</div>

<div class="grid lg:grid-cols-12 gap-4 items-start">
  <section class="lg:col-span-7 min-w-0 <%= UI.card %>">
    <div class="<%= UI.cardHd %>"><h3 class="<%= UI.cardTtl %>">Latest transactions</h3>
      <a href="/admin/history" class="text-[12.5px] font-semibold text-brand hover:underline">See all &rarr;</a></div>
    <% if (!recent.length) { %>
    <p class="px-5 py-8 text-center text-[13px] text-slateSoft/60">No transactions today.</p>
    <% } else { %>
    <ul class="divide-y divide-hair/60">
      <% recent.forEach(function(t){ %>
      <li class="flex items-center gap-3 px-5 py-3">
        <span class="<%= chip %> shrink-0"><%= t.ticketNo %></span>
        <div class="min-w-0 flex-1">
          <div class="text-[13.5px] font-semibold truncate"><%= t.name %></div>
          <div class="text-[12px] text-slateSoft/70 truncate"><%= t.items.map(function(i){return i.name}).join(', ') %></div>
        </div>
        <div class="text-right shrink-0">
          <div class="font-mono text-[13px] font-semibold"><%= t.amountDue > 0 ? peso(t.amountDue) : '—' %></div>
          <span class="<%= pill %> <%= tone(t.overallStatus) %>"><%= label(t.overallStatus) %></span>
        </div>
      </li>
      <% }) %>
    </ul>
    <% } %>
  </section>

  <section class="lg:col-span-5 min-w-0 <%= UI.card %>">
    <div class="<%= UI.cardHd %>"><h3 class="<%= UI.cardTtl %>">Windows</h3>
      <a href="/admin/windows" class="text-[12.5px] font-semibold text-brand hover:underline">Manage &rarr;</a></div>
    <ul class="divide-y divide-hair/60">
      <% windows.forEach(function(w){ %>
      <li class="flex items-center justify-between gap-3 px-5 py-3">
        <div class="flex items-center gap-3 min-w-0">
          <span class="relative flex w-2.5 h-2.5 shrink-0" aria-hidden="true">
            <% if (w.serving) { %><span class="absolute inset-0 rounded-full bg-emerald-500 animate-ping opacity-50"></span><% } %>
            <span class="relative w-2.5 h-2.5 rounded-full <%= w.status === 'open' ? 'bg-emerald-500' : w.status === 'break' ? 'bg-amber-500' : 'bg-slateSoft/30' %>"></span>
          </span>
          <div class="min-w-0">
            <div class="text-[13.5px] font-semibold truncate"><%= w.label %></div>
            <div class="text-[11.5px] text-slateSoft/70"><%= w.department %><% if (w.serving) { %> &middot; serving <span class="font-mono font-bold text-ink"><%= w.serving %></span><% } %></div>
          </div>
        </div>
        <span class="<%= pill %> <%= tone(w.status) %> capitalize"><%= w.status %></span>
      </li>
      <% }) %>
    </ul>
  </section>
</div>
</div>
<%- include('../../partials/foot') %>
<%- include('../../partials/scripts') %>
