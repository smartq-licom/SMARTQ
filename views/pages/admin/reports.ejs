<%- include('../../partials/head') %>
<%- include('../../partials/nav', { active: '/admin/reports' }) %>
<div class="flex flex-wrap items-end justify-between gap-3 mb-4">
  <div><h2 class="text-xl font-extrabold">Reports</h2>
    <p class="text-[13px] text-slateSoft/80 mt-0.5"><%= reports.from %> to <%= reports.to %></p></div>
  <form method="GET" class="flex flex-wrap items-end gap-2 no-print">
    <div><label for="from" class="<%= UI.lbl %>">From</label><input id="from" type="date" name="from" value="<%= from %>" class="<%= UI.input %>"></div>
    <div><label for="to" class="<%= UI.lbl %>">To</label><input id="to" type="date" name="to" value="<%= to %>" class="<%= UI.input %>"></div>
    <button type="submit" class="<%= UI.btn %> <%= UI.btnMain %>">Apply</button>
    <button type="button" onclick="window.print()" class="<%= UI.btn %> <%= UI.btnGh %>">Print</button>
  </form>
</div>

<div class="grid grid-cols-2 lg:grid-cols-6 gap-3 mb-5">
  <% [['Total', reports.summary.total],['Cashier', reports.summary.cashier],
      ['Registrar', reports.summary.registrar],['Completed', reports.summary.completed],
      ['Cancelled', reports.summary.cancelled],['Collected', peso(reports.summary.collected)]].forEach(function(c){ %>
  <div class="<%= UI.card %> p-4"><div class="text-xl font-extrabold"><%= c[1] %></div>
    <div class="text-[11px] text-slateSoft/80 mt-0.5"><%= c[0] %></div></div>
  <% }) %>
</div>
<div class="grid grid-cols-2 lg:grid-cols-6 gap-3 mb-5">
  <% [['Priority', reports.summary.priority],['Regular', reports.summary.regular],
      ['Guests', reports.summary.guests],['Scheduled', reports.summary.scheduled],
      ['Avg service', reports.summary.avgService + ' min'],['Avg wait', reports.summary.avgWait + ' min']].forEach(function(c){ %>
  <div class="<%= UI.card %> p-4"><div class="text-xl font-extrabold"><%= c[1] %></div>
    <div class="text-[11px] text-slateSoft/80 mt-0.5"><%= c[0] %></div></div>
  <% }) %>
</div>

<!-- prediction accuracy -->
<div class="<%= UI.card %> mb-4">
  <div class="<%= UI.cardHd %>">
    <h3 class="<%= UI.cardTtl %>">Waiting-time prediction accuracy</h3>
    <span class="<%= pill %> bg-mist text-slateSoft"><%= accuracy.samples %> measured tickets</span>
  </div>
  <div class="<%= UI.body %>">
    <% if (!accuracy.samples) { %>
    <p class="text-[13px] text-slateSoft/80">
      No measurements yet. Every ticket stores the wait predicted when it was issued;
      once tickets have been called, the error is calculated here.
    </p>
    <% } else { %>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
      <div class="rounded-lg bg-mist border border-hair p-4">
        <div class="text-2xl font-extrabold"><%= accuracy.mae %></div>
        <div class="text-[11px] text-slateSoft/80 mt-0.5">Mean absolute error (min)</div>
      </div>
      <div class="rounded-lg bg-mist border border-hair p-4">
        <div class="text-2xl font-extrabold"><%= accuracy.rmse %></div>
        <div class="text-[11px] text-slateSoft/80 mt-0.5">Root mean square error</div>
      </div>
      <div class="rounded-lg bg-mist border border-hair p-4">
        <div class="text-2xl font-extrabold"><%= accuracy.within5 %>%</div>
        <div class="text-[11px] text-slateSoft/80 mt-0.5">Within 5 minutes</div>
      </div>
      <div class="rounded-lg bg-mist border border-hair p-4">
        <div class="text-2xl font-extrabold"><%= accuracy.samples %></div>
        <div class="text-[11px] text-slateSoft/80 mt-0.5">Samples</div>
      </div>
    </div>
    <% if (Object.keys(accuracy.byDept).length) { %>
    <div class="flex flex-wrap gap-4 mt-3 text-[12px] text-slateSoft">
      <% Object.keys(accuracy.byDept).forEach(function(d){ %>
      <span><strong><%= d %></strong>: <%= accuracy.byDept[d].mae %> min error over <%= accuracy.byDept[d].n %> tickets</span>
      <% }) %>
    </div>
    <% } %>
    <p class="text-[11.5px] text-slateSoft/80 mt-3">
      Error is the difference between the wait predicted when the ticket was issued
      and the wait the client actually experienced before being called.
    </p>
    <% } %>
  </div>
</div>

<!-- peak hour detection -->
<div class="flex flex-wrap items-end justify-between gap-3 mb-3">
  <div>
    <h3 class="text-[15px] font-extrabold">Peak hour detection</h3>
    <p class="text-[12px] text-slateSoft/80 mt-0.5">
      <strong><%= peakPeriod.label %></strong><%= peakWeekday !== 'all' ? ', ' + dayNames[peakWeekday] + 's only' : '' %>.
      Independent of the report dates above.
    </p>
  </div>
  <%# Period: today / this week / this month / this year / last 30 days /
      custom range. Day of week narrows it further (e.g. Mondays this month). %>
  <form method="GET" class="flex flex-wrap items-end gap-2 no-print" id="peakForm">
    <input type="hidden" name="from" value="<%= from %>">
    <input type="hidden" name="to" value="<%= to %>">
    <div>
      <label for="pperiod" class="<%= UI.lbl %>">Period</label>
      <select id="pperiod" name="pperiod" class="<%= UI.input %>">
        <% Object.keys(periods).forEach(function (k) { %>
        <option value="<%= k %>" <%= peakPeriod.key === k ? 'selected' : '' %>><%= periods[k] %></option>
        <% }) %>
      </select>
    </div>
    <div data-custom <%= peakPeriod.key === 'custom' ? '' : 'hidden' %>>
      <label for="pfrom" class="<%= UI.lbl %>">From</label>
      <input id="pfrom" name="pfrom" type="date" class="<%= UI.input %>" value="<%= peakPeriod.from %>">
    </div>
    <div data-custom <%= peakPeriod.key === 'custom' ? '' : 'hidden' %>>
      <label for="pto" class="<%= UI.lbl %>">To</label>
      <input id="pto" name="pto" type="date" class="<%= UI.input %>" value="<%= peakPeriod.to %>">
    </div>
    <div>
      <label for="weekday" class="<%= UI.lbl %>">Day of week</label>
      <select id="weekday" name="weekday" class="<%= UI.input %>">
        <option value="all" <%= peakWeekday === 'all' ? 'selected' : '' %>>Every day</option>
        <% [1,2,3,4,5,6,0].forEach(function (i) { %>
        <option value="<%= i %>" <%= peakWeekday === i ? 'selected' : '' %>><%= dayNames[i] %>s</option>
        <% }) %>
      </select>
    </div>
    <div data-custom <%= peakPeriod.key === 'custom' ? '' : 'hidden' %>>
      <button type="submit" class="<%= UI.btn %> <%= UI.btnGh %>">Show</button>
    </div>
  </form>
  <script>
  (function () {
    var f = document.getElementById('peakForm'), p = document.getElementById('pperiod');
    // Custom shows the date boxes and waits for Show; the others apply at once.
    p.addEventListener('change', function () {
      var custom = p.value === 'custom';
      f.querySelectorAll('[data-custom]').forEach(function (el) { el.hidden = !custom; });
      if (!custom) f.submit();
    });
    document.getElementById('weekday').addEventListener('change', function () {
      if (p.value !== 'custom') f.submit();
    });
  })();
  </script>
</div>
<div class="grid lg:grid-cols-2 gap-4 mb-4">
  <%- include('../../partials/peak-hours', { p: peakHours.Cashier,   compact: false }) %>
  <%- include('../../partials/peak-hours', { p: peakHours.Registrar, compact: false }) %>
</div>

<div class="grid lg:grid-cols-2 gap-4">
  <div class="<%= UI.card %>">
    <div class="<%= UI.cardHd %>"><h3 class="<%= UI.cardTtl %>">Most requested documents</h3></div>
    <div class="overflow-x-auto"><table class="w-full">
      <thead><tr><th class="<%= UI.th %>">Document</th><th class="<%= UI.th %>">Count</th><th class="<%= UI.th %>">Amount</th></tr></thead>
      <tbody>
        <% reports.items.forEach(function(i){ %>
        <tr class="<%= UI.tr %>"><td class="<%= UI.td %>"><%= i.name %></td>
          <td class="<%= UI.td %> font-mono"><%= i.count %></td>
          <td class="<%= UI.td %> font-mono text-[12px]"><%= peso(i.amount) %></td></tr>
        <% }) %>
        <% if (!reports.items.length) { %><tr><td colspan="3" class="px-4 py-6 text-center text-[13px] text-slateSoft/80">No data.</td></tr><% } %>
      </tbody></table></div>
  </div>

  <div class="<%= UI.card %>">
    <div class="<%= UI.cardHd %>"><h3 class="<%= UI.cardTtl %>">Transactions per staff</h3></div>
    <div class="overflow-x-auto"><table class="w-full">
      <thead><tr><th class="<%= UI.th %>">Staff</th><th class="<%= UI.th %>">Dept</th>
        <th class="<%= UI.th %>">Count</th><th class="<%= UI.th %>">Avg min</th></tr></thead>
      <tbody>
        <% reports.byStaff.forEach(function(s){ %>
        <tr class="<%= UI.tr %>"><td class="<%= UI.td %>"><%= s.name %></td>
          <td class="<%= UI.td %> text-[12px]"><%= s.department %></td>
          <td class="<%= UI.td %> font-mono"><%= s.count %></td>
          <td class="<%= UI.td %> font-mono"><%= s.avgMin || '—' %></td></tr>
        <% }) %>
        <% if (!reports.byStaff.length) { %><tr><td colspan="4" class="px-4 py-6 text-center text-[13px] text-slateSoft/80">No data.</td></tr><% } %>
      </tbody></table></div>
  </div>

  <div class="<%= UI.card %>">
    <div class="<%= UI.cardHd %>"><h3 class="<%= UI.cardTtl %>">Per window</h3></div>
    <div class="overflow-x-auto"><table class="w-full">
      <thead><tr><th class="<%= UI.th %>">Window</th><th class="<%= UI.th %>">Dept</th><th class="<%= UI.th %>">Count</th></tr></thead>
      <tbody>
        <% reports.byWindow.forEach(function(w){ %>
        <tr class="<%= UI.tr %>"><td class="<%= UI.td %>"><%= w.name %></td>
          <td class="<%= UI.td %> text-[12px]"><%= w.department %></td>
          <td class="<%= UI.td %> font-mono"><%= w.count %></td></tr>
        <% }) %>
        <% if (!reports.byWindow.length) { %><tr><td colspan="3" class="px-4 py-6 text-center text-[13px] text-slateSoft/80">No data.</td></tr><% } %>
      </tbody></table></div>
  </div>

  <div class="<%= UI.card %>">
    <div class="<%= UI.cardHd %>"><h3 class="<%= UI.cardTtl %>">Service time estimates</h3></div>
    <div class="overflow-x-auto"><table class="w-full">
      <thead><tr><th class="<%= UI.th %>">Document</th><th class="<%= UI.th %>">Baseline</th>
        <th class="<%= UI.th %>">Samples</th><th class="<%= UI.th %>">In use</th></tr></thead>
      <tbody>
        <% estimation.forEach(function(e){ %>
        <tr class="<%= UI.tr %>"><td class="<%= UI.td %> text-[12.5px]"><%= e.name %></td>
          <td class="<%= UI.td %> font-mono text-[12px]"><%= e.baseline %> min</td>
          <td class="<%= UI.td %> font-mono text-[12px]"><%= e.samples %></td>
          <td class="<%= UI.td %>"><span class="<%= pill %> <%= e.source === 'historical' ? tone('paid') : tone('regular') %>"><%= e.effective %> min &middot; <%= e.source %></span></td></tr>
        <% }) %>
      </tbody></table></div>
  </div>
</div>
<%- include('../../partials/foot') %>
<%- include('../../partials/scripts') %>
