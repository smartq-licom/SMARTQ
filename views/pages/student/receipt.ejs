<%- include('../../partials/head') %>
<%- include('../../partials/nav', { active: '/student/history' }) %>
<div class="max-w-md mx-auto">
  <div class="<%= UI.card %> p-7">
    <div class="text-center border-b border-dashed border-hair pb-4">
      <div class="text-[14px] font-extrabold uppercase tracking-wide"><%= settings.institutionName %></div>
      <div class="text-[11.5px] text-slateSoft/80 mt-0.5">Official Electronic Receipt</div>
      <div class="font-mono text-[13px] font-bold mt-2"><%= r.receiptNo %></div>
    </div>
    <dl class="py-4 space-y-2 text-[12.5px] border-b border-dashed border-hair">
      <div class="flex justify-between gap-3"><dt class="text-slateSoft/80">Cashier ticket</dt><dd class="font-mono font-bold"><%= r.ticketNo %></dd></div>
      <div class="flex justify-between gap-3"><dt class="text-slateSoft/80">Name</dt><dd class="font-semibold text-right"><%= r.name %></dd></div>
      <% if (r.studentNo) { %>
      <div class="flex justify-between gap-3"><dt class="text-slateSoft/80">Student no.</dt><dd class="font-mono"><%= r.studentNo %></dd></div>
      <% } %>
      <% if (r.course) { %>
      <div class="flex justify-between gap-3"><dt class="text-slateSoft/80">Course</dt><dd><%= r.course %><%= r.yearLevel ? ' - Year ' + r.yearLevel : '' %></dd></div>
      <% } %>
      <% if (r.purpose) { %><div class="flex justify-between gap-3"><dt class="text-slateSoft/80">Purpose</dt><dd class="text-right"><%= r.purpose %></dd></div><% } %>
    </dl>
    <div class="py-4 border-b border-dashed border-hair">
      <% r.documents.forEach(function(i){ %>
      <div class="flex justify-between gap-3 text-[12.5px] py-1">
        <span><%= i.label %></span><span class="font-mono"><%= peso(i.price) %></span>
      </div>
      <% }) %>
      <div class="flex justify-between gap-3 mt-2.5 pt-2.5 border-t border-hair">
        <span class="text-[13px] font-extrabold">Amount paid</span>
        <span class="text-[15px] font-extrabold font-mono"><%= peso(r.amountPaid) %></span>
      </div>
    </div>
    <dl class="py-4 space-y-2 text-[12.5px]">
      <div class="flex justify-between gap-3"><dt class="text-slateSoft/80">Status</dt>
        <dd><span class="<%= pill %> <%= tone('paid') %>">PAID</span></dd></div>
      <div class="flex justify-between gap-3"><dt class="text-slateSoft/80">Date &amp; time</dt>
        <dd class="font-mono text-[11.5px]"><%= new Date(r.paidAt).toLocaleString('en-PH') %></dd></div>
      <div class="flex justify-between gap-3"><dt class="text-slateSoft/80">Cashier</dt><dd><%= r.staffName %></dd></div>
      <div class="flex justify-between gap-3"><dt class="text-slateSoft/80">Window</dt><dd><%= r.windowLabel %></dd></div>
    </dl>
    <p class="text-[10.5px] text-slateSoft/60 text-center border-t border-hair pt-3">
      This electronic receipt is generated by SmartQ and is kept in your account permanently.
    </p>
  </div>
  <div class="flex justify-center gap-2 mt-4 no-print">
    <a href="/student/history" class="<%= UI.btn %> <%= UI.btnGh %> <%= UI.btnSm %>">Back</a>
    <button onclick="window.print()" class="<%= UI.btn %> <%= UI.btnMain %> <%= UI.btnSm %>">Print receipt</button>
  </div>
</div>
<%- include('../../partials/foot') %>
<%- include('../../partials/scripts') %>
