<% const active_ = '/student/dashboard' %>
<%- include('../../partials/head') %>
<% if (active.some(function(x){ return ['waiting','called','serving'].includes(x.ticketStatus); })) { %>
<meta http-equiv="refresh" content="10">
<% } %>
<%- include('../../partials/nav', { active: '/student/dashboard' }) %>

<div class="flex flex-wrap items-start justify-between gap-3 mb-5">
  <div>
    <h2 class="text-xl font-extrabold">Hello, <%= me.firstName %></h2>
    <p class="text-[13px] text-slateSoft/80 mt-0.5">
      <%= me.role === 'guest' ? 'Guest account' : (me.course || 'Student') + (me.yearLevel ? ' · Year ' + me.yearLevel : '') %>
      <% if (me.studentNo) { %> &middot; <span class="font-mono"><%= me.studentNo %></span><% } %>
    </p>
  </div>
  <a href="/student/request" class="<%= UI.btn %> <%= UI.btnMain %> text-[14px] px-6 py-3">Issue Ticket</a>
</div>

<!-- live office load -->
<div class="grid sm:grid-cols-2 gap-3 mb-5">
  <% ['Cashier','Registrar'].forEach(function(d){ const L = load[d]; %>
  <div class="<%= UI.card %> p-4">
    <div class="flex items-center justify-between">
      <span class="text-[12px] font-bold uppercase tracking-wider text-slateSoft/80"><%= d %></span>
      <span class="<%= pill %> <%= tone(L.level) %>"><%= L.level %></span>
    </div>
    <div class="flex items-baseline gap-2 mt-1.5">
      <span class="text-2xl font-extrabold"><%= L.waiting %></span>
      <span class="text-[12px] text-slateSoft/80">waiting now &middot; <%= L.serving %> at the window</span>
    </div>
  </div>
  <% }) %>
</div>

<% const inQueue = active; %>

<h3 class="text-[12px] font-bold uppercase tracking-wider text-slateSoft/80 mb-2.5">Active transactions</h3>
<% if (!inQueue.length) { %>
<div class="<%= UI.card %> p-10 text-center">
  <div class="text-4xl font-extrabold text-hair font-mono">---</div>
  <p class="text-[14px] font-semibold mt-3">You have no active transaction</p>
  <p class="text-[12.5px] text-slateSoft/80 mt-1">Request a queue number when you are ready to go to the office.</p>
  <a href="/student/request" class="<%= UI.btn %> <%= UI.btnMain %> mt-5">Issue Ticket</a>
</div>
<% } else { %>
<div class="grid lg:grid-cols-2 gap-4">
  <% inQueue.forEach(function(t){ %>
  <div class="<%= UI.card %>">
    <div class="<%= UI.cardHd %>">
      <div class="flex items-center gap-2">
        <span class="font-mono text-xl font-extrabold"><%= t.ticketNo %></span>
        <span class="<%= pill %> <%= tone(t.queueCategory) %>"><%= t.queueCategory %></span>
      </div>
      <span class="<%= pill %> <%= tone(t.overallStatus) %>"><%= label(t.overallStatus) %></span>
    </div>
    <div class="<%= UI.body %> space-y-3">
      <dl class="grid grid-cols-2 gap-x-4 gap-y-2 text-[13px]">
        <div><dt class="text-slateSoft/80 text-[11.5px]">Destination</dt><dd class="font-semibold"><%= t.department %></dd></div>
        <div><dt class="text-slateSoft/80 text-[11.5px]">Amount due</dt>
          <dd class="font-semibold"><%= t.amountDue > 0 ? peso(t.amountDue) : 'No payment' %></dd></div>
        <div class="col-span-2"><dt class="text-slateSoft/80 text-[11.5px]">Requested document<%= t.items.length > 1 ? 's' : '' %></dt>
          <dd class="font-semibold"><%= t.items.map(function(i){return i.name}).join(', ') %></dd></div>
        <div class="col-span-2"><dt class="text-slateSoft/80 text-[11.5px]">Purpose</dt>
          <dd class="font-semibold"><%= t.purposeText || "-" %></dd></div>
        <div><dt class="text-slateSoft/80 text-[11.5px]">Ticket status</dt>
          <dd><span class="<%= pill %> <%= tone(t.ticketStatus) %>"><%= t.ticketStatus %></span></dd></div>
        <div><dt class="text-slateSoft/80 text-[11.5px]">Payment</dt>
          <dd><span class="<%= pill %> <%= tone(t.paymentStatus) %>"><%= label(t.paymentStatus) %></span></dd></div>
        <div><dt class="text-slateSoft/80 text-[11.5px]">Visit date</dt>
          <dd class="text-[12.5px] font-semibold"><%= t.visitDateText %>
            <span class="block font-normal text-[11px] text-slateSoft/75">Any time <%= officeHours %></span></dd></div>
        <div><dt class="text-slateSoft/80 text-[11.5px]"><%= t.isScheduled ? 'Booked on' : 'Requested at' %></dt>
          <dd class="text-[12.5px]"><%= t.requestedOnText %></dd></div>
        <% if (t.parentTicket) { %>
        <div><dt class="text-slateSoft/80 text-[11.5px]">From cashier</dt>
          <dd class="font-mono text-[12px]"><%= t.parentTicket %></dd></div>
        <% } %>
        <% if (t.staffName) { %>
        <div><dt class="text-slateSoft/80 text-[11.5px]">Staff</dt>
          <dd class="text-[12.5px]"><%= t.staffName %><% if (t.windowLabel) { %> &middot; <%= t.windowLabel %><% } %></dd></div>
        <% } %>
      </dl>

      <%- include('../../partials/eta', { eta: t.eta }) %>
      <% if (['called','serving'].includes(t.ticketStatus)) { %>
      <div class="rounded-lg bg-emerald-50 border border-emerald-200 px-3.5 py-3 flex items-center gap-3">
        <div>
          <div class="text-[13px] font-bold text-emerald-900">It is your turn</div>
          <div class="text-[12px] text-emerald-800">Please proceed to <%= t.windowLabel || t.department %>.</div>
        </div>
        <% if (t.timeLeft != null && t.paymentStatus !== 'paid') { %>
        <span class="ml-auto font-mono text-lg font-extrabold text-emerald-900" data-countdown data-seconds="<%= t.timeLeft %>">--:--</span>
        <% } %>
      </div>
      <% } %>
      <% if (t.overallStatus === 'waiting_registrar' && t.department === 'Cashier') { %>
      <div class="rounded-lg bg-amber-50 border border-amber-200 px-3.5 py-2.5 text-[12.5px] text-amber-900">
        Payment complete.
      </div>
      <% } %>

      <div class="flex flex-wrap gap-2 pt-1">
        <a href="/student/ticket/<%= t.id %>" class="<%= UI.btn %> <%= UI.btnGh %> <%= UI.btnSm %>">View ticket</a>
        <% if (t.receiptNo && t.paymentStatus === 'paid') { %>
        <a href="/student/receipt/<%= t.id %>" class="<%= UI.btn %> <%= UI.btnOk %> <%= UI.btnSm %>">View receipt</a>
        <% } %>
      </div>
    </div>
  </div>
  <% }) %>
</div>
<% } %>

<% if (recent.length) { %>
<h3 class="text-[12px] font-bold uppercase tracking-wider text-slateSoft/80 mt-6 mb-2.5">Recent activity</h3>
<div class="<%= UI.card %> overflow-x-auto">
  <table class="w-full">
    <thead><tr>
      <th class="<%= UI.th %>">Ticket</th><th class="<%= UI.th %>">Document</th>
      <th class="<%= UI.th %>">Amount</th><th class="<%= UI.th %>">Status</th>
      <th class="<%= UI.th %>">Date</th><th class="<%= UI.th %>"></th>
    </tr></thead>
    <tbody>
      <% recent.forEach(function(t){ %>
      <tr class="<%= UI.tr %>">
        <td class="<%= UI.td %>"><span class="<%= chip %>"><%= t.ticketNo %></span></td>
        <td class="<%= UI.td %>"><%= t.items.map(function(i){return i.name}).join(', ') %></td>
        <td class="<%= UI.td %>"><%= t.amountDue > 0 ? peso(t.amountDue) : '—' %></td>
        <td class="<%= UI.td %>"><span class="<%= pill %> <%= tone(t.overallStatus) %>"><%= label(t.overallStatus) %></span></td>
        <td class="<%= UI.td %> font-mono text-[12px]"><%= t.serviceDate %></td>
        <td class="<%= UI.td %>"><a href="/student/ticket/<%= t.id %>" class="text-[12px] font-semibold underline">Open</a></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } %>

<%- include('../../partials/foot') %>
<%- include('../../partials/scripts') %>
