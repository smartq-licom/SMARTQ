<%- include('../../partials/head') %>
<%- include('../../partials/nav', { active: '/student/history' }) %>
<h2 class="text-xl font-extrabold mb-1">Transaction history</h2>
<p class="text-[13px] text-slateSoft/80 mb-4">Every request you have made, with its final status.</p>
<div class="<%= UI.card %> overflow-x-auto">
  <table class="w-full">
    <thead><tr>
      <th class="<%= UI.th %>">Ticket</th><th class="<%= UI.th %>">Dept</th>
      <th class="<%= UI.th %>">Document</th><th class="<%= UI.th %>">Purpose</th>
      <th class="<%= UI.th %>">Amount</th><th class="<%= UI.th %>">Payment</th>
      <th class="<%= UI.th %>">Status</th><th class="<%= UI.th %>">Staff</th>
      <th class="<%= UI.th %>">Date</th><th class="<%= UI.th %>">Receipt</th>
    </tr></thead>
    <tbody>
      <% list.forEach(function(t){ %>
      <tr class="<%= UI.tr %>">
        <td class="<%= UI.td %>"><span class="<%= chip %>"><%= t.ticketNo %></span></td>
        <td class="<%= UI.td %> text-[12px]"><%= t.department %></td>
        <td class="<%= UI.td %>"><%= t.items.map(function(i){return i.name}).join(', ') %></td>
        <td class="<%= UI.td %> text-[12px] text-slateSoft"><%= t.purposeText || "-" %></td>
        <td class="<%= UI.td %> font-mono text-[12px]"><%= t.amountDue > 0 ? peso(t.amountDue) : '—' %></td>
        <td class="<%= UI.td %>"><span class="<%= pill %> <%= tone(t.paymentStatus) %>"><%= label(t.paymentStatus) %></span></td>
        <td class="<%= UI.td %>"><span class="<%= pill %> <%= tone(t.overallStatus) %>"><%= label(t.overallStatus) %></span></td>
        <td class="<%= UI.td %> text-[12px]"><%= t.staffName || '—' %></td>
        <td class="<%= UI.td %> font-mono text-[12px]"><%= t.serviceDate %></td>
        <td class="<%= UI.td %>">
          <% if (t.paymentStatus === 'paid') { %>
          <a href="/student/receipt/<%= t.id %>" class="text-[12px] font-semibold underline">View</a>
          <% } else { %><span class="text-slateSoft/60 text-[12px]">—</span><% } %>
        </td>
      </tr>
      <% }) %>
      <% if (!list.length) { %>
      <tr><td colspan="10" class="px-4 py-10 text-center text-[13px] text-slateSoft/80">No transactions yet.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
<%- include('../../partials/foot') %>
<%- include('../../partials/scripts') %>
