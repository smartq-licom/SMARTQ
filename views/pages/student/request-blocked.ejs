<%- include('../../partials/head') %>
<%- include('../../partials/nav', { active: '/student/request' }) %>

<div class="max-w-3xl mx-auto">
  <div class="mb-5">
    <h2 class="text-xl font-extrabold text-ink">Both offices already have your ticket</h2>
    <p class="text-[13px] text-slateSoft/80 mt-1">
      You may hold one ticket per office. Finish these and you can request again.
    </p>
  </div>

  <div class="grid lg:grid-cols-2 gap-4">
    <% [['Cashier', activeBy.Cashier, etaCashier], ['Registrar', activeBy.Registrar, etaRegistrar]].forEach(function(g){
         const dept = g[0], t = g[1], eta = g[2]; if (!t) return; %>
    <div class="<%= UI.card %>">
      <div class="<%= UI.cardHd %>">
        <div class="flex items-center gap-2">
          <span class="font-mono text-lg font-extrabold text-brand-deep"><%= t.ticketNo %></span>
          <span class="<%= pill %> <%= tone(t.queueCategory) %>"><%= t.queueCategory %></span>
        </div>
        <span class="<%= pill %> <%= tone(t.overallStatus) %>"><%= label(t.overallStatus) %></span>
      </div>
      <div class="<%= UI.body %> space-y-3">
        <dl class="grid grid-cols-2 gap-x-4 gap-y-2 text-[13px]">
          <div><dt class="text-slateSoft/70 text-[11.5px]">Office</dt><dd class="font-semibold"><%= dept %></dd></div>
          <div><dt class="text-slateSoft/70 text-[11.5px]">Amount</dt>
            <dd class="font-semibold"><%= t.amountDue > 0 ? peso(t.amountDue) : 'No payment' %></dd></div>
          <div class="col-span-2"><dt class="text-slateSoft/70 text-[11.5px]">Document<%= t.items.length > 1 ? 's' : '' %></dt>
            <dd class="font-semibold"><%= t.items.map(function(i){ return i.label }).join(', ') %></dd></div>
          <% if (t.isScheduled) { %>
          <div class="col-span-2"><dt class="text-slateSoft/70 text-[11.5px]">Scheduled for</dt>
            <dd class="font-mono font-semibold"><%= t.scheduledDate %></dd></div>
          <% } %>
        </dl>
        <%- include('../../partials/eta', { eta: eta }) %>
        <div class="flex flex-wrap gap-2 pt-1">
          <a href="/student/ticket/<%= t.id %>" class="<%= UI.btn %> <%= UI.btnMain %> <%= UI.btnSm %>">View ticket</a>
        </div>
      </div>
    </div>
    <% }) %>
  </div>

  <div class="mt-4">
    <a href="/student/dashboard" class="<%= UI.btn %> <%= UI.btnGh %>">Back to dashboard</a>
  </div>
</div>

<%- include('../../partials/foot') %>
<%- include('../../partials/scripts') %>
