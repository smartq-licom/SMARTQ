<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= dept %> Queue | SmartQ</title>
<script src="https://cdn.tailwindcss.com"></script>
<link rel="icon" href="/img/lcc-seal.jpg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=JetBrains+Mono:wght@700;800&display=swap" rel="stylesheet">
<script>
tailwind.config = { theme: { extend: {
  colors: { brand:{ DEFAULT:'#2185D5', deep:'#1A6CAE', night:'#0F4C81', wash:'#EAF3FB', line:'#C9E0F4' }, ink:'#1E2A36', slateSoft:'#4A5866', edge:'#E3E7ED' },
  fontFamily: { sans:['"Plus Jakarta Sans"','system-ui','sans-serif'], mono:['"JetBrains Mono"','ui-monospace','monospace'] },
}}}
</script>
<style>
  body{font-family:'Plus Jakarta Sans',system-ui,sans-serif;background:radial-gradient(90% 70% at 10% 0%,#EAF3FB 0%,#F2F4F8 55%)}
  .font-mono{font-variant-numeric:tabular-nums;letter-spacing:-.02em}
  .glow{text-shadow:0 4px 30px rgba(15,76,129,.35)}
  .card{background:#fff;border:1px solid #E3E7ED;border-radius:24px;box-shadow:0 1px 2px rgba(16,24,40,.04),0 8px 24px -8px rgba(16,24,40,.08)}
  .label{font-size:13px;font-weight:800;text-transform:uppercase;letter-spacing:.22em;color:#1A6CAE}
  /* a part that just changed glows once, instead of the whole screen reloading */
  .live-changed{animation:lc 1.4s ease-out}
  @keyframes lc{0%{filter:brightness(1.12) saturate(1.3)}100%{filter:none}}
  .serving-now{animation:pulse 2.4s ease-in-out infinite}
  @keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(33,133,213,.0),0 20px 60px -20px rgba(33,133,213,.6)}50%{box-shadow:0 0 0 6px rgba(33,133,213,.18),0 20px 60px -20px rgba(33,133,213,.8)}}
  .marquee{white-space:nowrap;display:inline-block;animation:mq 28s linear infinite;padding-left:100%}
  @keyframes mq{to{transform:translateX(-100%)}}
  /* browsers without View Transitions: the changed part fades out, then swaps (partials/live) */
  [data-live-soft]{transition:opacity .6s ease}
  [data-live-soft].live-out{opacity:0}
  /* morphing (View Transitions): each named card or number glides and reshapes
     into its new place and look; the rest of the screen stays still */
  ::view-transition-group(*){animation-duration:.9s;animation-timing-function:cubic-bezier(.2,.8,.2,1)}
  ::view-transition-old(*),::view-transition-new(*){animation-duration:.6s}
  ::view-transition-old(root),::view-transition-new(root){animation:none}
  /* lane numbers: a readable grey from across the room, still quieter than Now serving */
  .lane-no{color:#4f5d6c}
  html.night .lane-no{color:#b7c6d7}
  /* just called: the proceed chip draws the eye with a slow, soft breath and a
     nudging arrow, never a flash */
  .go-chip{animation:go-breathe 2.6s ease-in-out infinite}
  @keyframes go-breathe{0%,100%{box-shadow:0 8px 24px -10px rgba(8,40,80,.55),0 0 0 0 rgba(255,255,255,.0)}50%{box-shadow:0 8px 24px -10px rgba(8,40,80,.55),0 0 0 8px rgba(255,255,255,.18)}}
  html.night span.go-chip{color:#0F4C81}             /* a white chip keeps its dark text at night */
  .go-arrow{animation:go-nudge 1.6s ease-in-out infinite}
  @keyframes go-nudge{0%,100%{transform:translateX(0)}50%{transform:translateX(4px)}}
  @media (prefers-reduced-motion:reduce){.go-chip,.go-arrow{animation:none}}
  @media (prefers-reduced-motion:reduce){.live-changed,.serving-now,.marquee{animation:none} ::view-transition-group(*),::view-transition-old(*),::view-transition-new(*){animation:none !important}.marquee{padding-left:0}}

  /* Night: after office hours (and before opening) the board slowly turns dark.
     The night sky is a layer that fades in over the day background; cards and
     text change colour more slowly than a page flip, so the change is gentle. */
  body::before{content:'';position:fixed;inset:0;z-index:-1;pointer-events:none;opacity:0;
    background:
      radial-gradient(1.5px 1.5px at 12% 18%,rgba(255,255,255,.55),transparent 60%),
      radial-gradient(1.5px 1.5px at 78% 12%,rgba(255,255,255,.45),transparent 60%),
      radial-gradient(1px 1px at 46% 30%,rgba(255,255,255,.4),transparent 60%),
      radial-gradient(1.5px 1.5px at 88% 46%,rgba(255,255,255,.35),transparent 60%),
      radial-gradient(1px 1px at 24% 64%,rgba(255,255,255,.3),transparent 60%),
      radial-gradient(1px 1px at 62% 78%,rgba(255,255,255,.3),transparent 60%),
      radial-gradient(90% 70% at 10% 0%,#163257 0%,#0b1626 60%)}
  html.night body::before{opacity:1}
  html.night-anim body::before{transition:opacity 8s ease}
  html.night-anim .card, html.night-anim [class*="text-"], html.night-anim [class*="bg-"], html.night-anim [class*="ring-"], html.night-anim .label{
    transition:background-color 6s ease, color 6s ease, border-color 6s ease, box-shadow 6s ease}
  html.night .card{background:#13243b;border-color:#1f3652;box-shadow:0 8px 24px -10px rgba(0,0,0,.5)}
  html.night .text-ink{color:#e6eef7}
  html.night [class*="text-slateSoft"]{color:#9db1c7}
  html.night .text-edge{color:#2a4262}
  html.night .label{color:#7cc4fa}
  html.night .text-brand-night{color:#9fd3ff}
  html.night [class*="bg-[#F5F7FA]"]{background-color:#1a2f4a}
  html.night .bg-brand-wash{background-color:#17365a}
  html.night [class*="ring-edge"], html.night .ring-brand{--tw-ring-color:#2a4668}
  html.night .border-edge{border-color:#1f3652}
  html.night .bg-amber-50{background-color:#3a2d12}
  html.night .text-amber-800{color:#fcd38a}
  html.night .text-amber-700{color:#f7c66b}
  @media (prefers-reduced-motion:reduce){ body::before, html.night-anim .card, html.night-anim [class*="text-"], html.night-anim [class*="bg-"]{transition:none} }
</style>
</head>
<body class="text-ink antialiased">
<%- include('../../partials/board-loader') %>
<%# day or night: is the office taking people right now? (no estimate after closing).
    Kept up to date with the rest of the board; the script below reads it. %>
<% var morningNote = !(predict && predict.join) && /^Today's line opens/.test((predict && predict.note) || ''); %>
<span data-live="mode" hidden><i data-open="<%= (predict && (predict.join || predict.finishing)) || morningNote ? 1 : 0 %>"></i></span>

<div class="min-h-screen lg:h-screen flex flex-col lg:overflow-hidden">

  <%# Opened from a student's ticket (the Board button adds ?from=<ticket token>):
      a way back to it. The office TV opens the plain address and never shows it. %>
  <a id="backToTicket" hidden data-loader-go data-loader-icon="queue" data-loader-mode="back" data-loader-text="Back to your ticket" aria-label="Back to my ticket" title="Back to my ticket"
     class="back-fab fixed z-50 right-4 grid place-items-center w-14 h-14 rounded-full text-white bg-gradient-to-br from-[#2E9BEA] via-brand to-brand-night shadow-[0_12px_28px_-8px_rgba(26,108,174,.7)] hover:brightness-110 active:scale-95 transition">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 14 4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11"/></svg>
  </a>
  <style>
    .back-fab[hidden]{ display:none !important }           /* the office TV: never shown */
    .back-fab{ bottom:calc(16px + env(safe-area-inset-bottom)); animation:fab-in .4s cubic-bezier(.2,.8,.2,1) both }
    @keyframes fab-in{ from{ opacity:0; transform:translateY(16px) scale(.85) } to{ opacity:1; transform:none } }
    @media (prefers-reduced-motion:reduce){ .back-fab{ animation:none } }
    @media print{ .back-fab{ display:none !important } }
  </style>
  <script>
    (function () {
      var from = new URLSearchParams(location.search).get('from') || '';
      if (!/^[a-f0-9]{32}$/.test(from)) return;            // only a real ticket link
      var a = document.getElementById('backToTicket');
      a.href = '/queue/t/' + from;
      a.hidden = false;
    })();
  </script>

  <!-- header -->
  <header class="px-4 sm:px-8 pt-6 pb-4 flex flex-wrap items-center justify-between gap-4">
    <div class="flex items-center gap-4">
      <img src="/img/lcc-seal.jpg" alt="Libon Community College seal"
           class="w-12 h-12 sm:w-16 sm:h-16 xl:w-[72px] xl:h-[72px] rounded-full ring-4 ring-brand-line bg-white object-cover">
      <div>
        <div class="text-[26px] sm:text-[34px] xl:text-[40px] font-extrabold tracking-tight leading-none"><%= dept %></div>
        <div class="text-[15px] text-slateSoft/70 font-medium mt-1.5"><%= settings.institutionName %> &middot; Smart<span class="text-brand">Q</span></div>
      </div>
    </div>
    <div class="text-right">
      <div id="clock" class="font-mono text-[30px] sm:text-[44px] xl:text-[52px] font-extrabold leading-none text-brand-night">--:--</div>
      <div id="dateline" class="text-[14px] text-slateSoft/70 font-semibold mt-1.5"></div>
    </div>
  </header>

  <main class="flex-1 min-h-0 grid lg:grid-cols-12 gap-6 px-4 sm:px-8 pb-6">

    <!-- left: now serving, then the two lanes -->
    <%# phones: this column dissolves (contents) so the order can be Now serving, Next up, lanes %>
    <div class="contents lg:flex lg:col-span-8 lg:flex-col lg:gap-6 lg:min-h-0 lg:min-w-0">
      <%# on a TV (lg): Now serving takes the free height, so its number can be big %>
      <section data-live="serving" data-live-soft class="order-1 lg:order-none min-w-0 lg:flex-1 lg:min-h-0 flex flex-col">
        <div class="label mb-3">Now serving</div>
        <% var big = windows.length > 1 ? 'lg:text-[min(17vh,7vw)]' : 'lg:text-[min(22vh,13vw)]';
           var wc = typeof waitingCount !== 'undefined' ? waitingCount : null;
           var noLine = wc ? !(wc.priority + wc.regular) : !(priority.length + regular.length);
           // finishing: past closing, the staff still serving the people already in line
           var finishing = !!(predict && predict.finishing);
           var openNow = !!(predict && predict.join) || finishing;   // the windows are working (day look)
           // before the same-day line opens on an open day: morning, not "closed"
           var morning = !openNow && /^Today's line opens/.test(predict.note || '');
           var ot = String(settings.openTime || '08:00').split(':'), oh = +ot[0],
               opens = ((oh % 12) || 12) + ':' + (ot[1] || '00') + (oh < 12 ? ' AM' : ' PM');
           var offTitle = morning ? 'Opening soon' : 'Closed for today',
               offSub = morning ? predict.note.replace(/\.$/, '') + ' · office opens ' + opens : 'Opens at ' + opens + ' on the next open day'; %>
        <%# Several windows, all idle outside hours: one shared card ("Opening soon" / "Closed for today") %>
        <% var allIdle = windows.length > 1 && !serving.length && !openNow; %>
        <% if (allIdle) { %>
        <div style="view-transition-name:win-all" class="card px-5 sm:px-8 py-7 text-center flex flex-col items-center justify-center lg:flex-1 lg:min-h-0">
          <div class="grid place-items-center w-20 h-20 lg:w-24 lg:h-24 rounded-full <%= morning ? 'bg-amber-50 text-amber-500' : 'bg-[#F5F7FA] text-slateSoft/60' %>" aria-hidden="true">
            <% if (morning) { %><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 18a5 5 0 0 0-10 0M12 2v5M4.2 10.2l1.4 1.4M1 18h2M21 18h2M18.4 11.6l1.4-1.4M23 22H1M8 6l4-4 4 4"/></svg><% } else { %><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z"/></svg><% } %>
          </div>
          <div class="mt-4 text-[34px] sm:text-[44px] lg:text-[min(7vh,60px)] font-extrabold leading-tight text-ink"><%= offTitle %></div>
          <div class="mt-1 text-[17px] sm:text-[19px] font-semibold text-slateSoft/70"><%= offSub %></div>
        </div>
        <% } else { %>
        <div class="grid <%= windows.length > 1 ? 'md:grid-cols-2' : '' %> <%= windows.length > 2 ? 'xl:grid-cols-3' : '' %> gap-5 lg:flex-1 lg:min-h-0">
          <% windows.forEach(function(w){ %>
          <% const s = serving.find(function(t){ return t.windowId === w.id }); %>
          <% if (s) { %>
          <div style="view-transition-name:win-<%= w.id %>" class="serving-now text-white rounded-[28px] bg-gradient-to-br from-[#2E9BEA] via-brand to-brand-night px-5 sm:px-8 py-7 text-center flex flex-col justify-center">
            <div class="text-[16px] font-extrabold uppercase tracking-[.2em] text-white/80"><%= w.label %></div>
            <div style="view-transition-name:tk-<%= s.ticketNo %>" class="font-mono glow text-[72px] sm:text-[110px] <%= big %> leading-[1] font-extrabold mt-2"><%= s.ticketNo %></div>
            <%# no name on a public screen. Just called: where to go (the one thing the
                back of the room needs, and it works without the chime); then "Being served". %>
            <div class="mt-4 flex flex-wrap items-center justify-center gap-3">
              <% if (s.ticketStatus === 'called') { %>
              <span class="go-chip whitespace-nowrap inline-flex items-center gap-2.5 rounded-full bg-white text-brand-night pl-5 pr-4 py-2 text-[16px] sm:text-[20px] font-extrabold shadow-[0_8px_24px_-10px_rgba(8,40,80,.55)]">
                <% if (windows.length > 1) { %>Please proceed now<% } else { %><span class="sm:hidden">Please proceed now</span><span class="hidden sm:inline">Please proceed to <%= w.label %></span><% } %>
                <svg class="go-arrow" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </span>
              <% } else { %>
              <span class="inline-flex items-center gap-2 rounded-full bg-white/15 px-4 py-1.5 text-[16px] font-bold text-white/90"><span class="w-2 h-2 rounded-full bg-emerald-300"></span>Being served</span>
              <% } %>
              <span class="rounded-full px-3.5 py-1 text-[13px] font-extrabold uppercase tracking-wide <%= s.queueCategory === 'priority' ? 'bg-violet-500' : 'bg-white/15 text-white/80' %>"><%= s.queueCategory %></span>
            </div>
          </div>
          <% } else if (w.status === 'open' && !openNow) { %>
          <%# outside hours: "Opening soon" with a sunrise before opening, "Closed for today" with a moon after %>
          <div style="view-transition-name:win-<%= w.id %>" class="card px-5 sm:px-8 py-7 text-center flex flex-col items-center justify-center">
            <div class="text-[16px] font-extrabold uppercase tracking-[.2em] text-slateSoft/60"><%= w.label %></div>
            <div class="mt-4 grid place-items-center w-20 h-20 lg:w-24 lg:h-24 rounded-full <%= morning ? 'bg-amber-50 text-amber-500' : 'bg-[#F5F7FA] text-slateSoft/60' %>" aria-hidden="true">
              <% if (morning) { %><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 18a5 5 0 0 0-10 0M12 2v5M4.2 10.2l1.4 1.4M1 18h2M21 18h2M18.4 11.6l1.4-1.4M23 22H1M8 6l4-4 4 4"/></svg><% } else { %><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z"/></svg><% } %>
            </div>
            <div class="mt-4 text-[34px] sm:text-[44px] lg:text-[min(7vh,60px)] font-extrabold leading-tight text-ink"><%= offTitle %></div>
            <div class="mt-1 text-[17px] sm:text-[19px] font-semibold text-slateSoft/70"><%= offSub %></div>
          </div>
          <% } else { %>
          <div style="view-transition-name:win-<%= w.id %>" class="card px-5 sm:px-8 py-7 text-center flex flex-col justify-center">
            <div class="text-[16px] font-extrabold uppercase tracking-[.2em] text-slateSoft/60"><%= w.label %></div>
            <div class="font-mono text-[72px] sm:text-[110px] <%= big %> leading-[1] font-extrabold mt-2 text-edge">----</div>
            <div class="mt-3 flex items-center justify-center gap-3">
              <span class="rounded-full px-4 py-1.5 text-[14px] font-extrabold uppercase tracking-wide bg-[#F5F7FA] text-slateSoft"><%= w.status %></span>
              <span class="text-[19px] font-bold text-slateSoft/50"><%= w.status === 'open' ? 'Available' : w.status === 'break' ? 'On break' : '' %></span>
            </div>
          </div>
          <% } %>
          <% }) %>
        </div>
        <% } %>
      </section>

      <section class="order-3 lg:order-none min-w-0 min-h-0 grid md:grid-cols-[repeat(auto-fit,minmax(14rem,1fr))] gap-5" data-live="lanes" data-live-soft>
        <%# A calm lane: the first few numbers, light and small, so the eye goes to
            "Now serving" and "Next up"; the rest is a count ("+16 more"). %>
        <% var SHOW = 6, counts = typeof waitingCount !== 'undefined' ? waitingCount : {};
           // each number appears once on screen: the ones in Next up are not listed again here
           var inNext = {}; (predict.nextUp || []).forEach(function (n) { inNext[n.ticketNo] = 1; }); %>
        <% var bookedList = typeof booked !== 'undefined' ? booked : [];
           var groups = [['Priority', priority, 'bg-violet-500', counts.priority], ['Regular', regular, 'bg-brand', counts.regular]];
           // bookings (CB-/RB-) get their own card, with their time, only when there are some today
           if (counts.booked) groups.push(['Booked', bookedList, 'bg-amber-500', counts.booked]); %>
        <% groups.forEach(function (g) {
             var total = g[3] != null ? g[3] : g[1].length,
                 upNext = g[1].filter(function (t) { return inNext[t.ticketNo]; }).length,
                 shown = g[1].filter(function (t) { return !inNext[t.ticketNo]; }).slice(0, SHOW),
                 more = total - upNext - shown.length; %>
        <div style="view-transition-name:lane-<%= g[0].toLowerCase() %>" class="card px-6 py-5 min-h-0 overflow-hidden">
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mb-4">
            <span class="w-2.5 h-2.5 rounded-full <%= g[2] %>"></span>
            <span class="label !text-slateSoft"><%= g[0] %></span>
            <span class="ml-auto whitespace-nowrap text-[14px] font-bold text-slateSoft"><span class="font-mono text-[18px] font-extrabold text-ink"><%= total %></span> waiting</span>
          </div>
          <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
            <% shown.forEach(function(t){ %>
            <%# all alike: who is next is shown once, in Next up %>
            <% if (t.slotStart) { var sh = +t.slotStart.slice(0, 2); %>
            <div class="leading-none"><div class="lane-no font-mono text-[26px] font-bold"><%= t.ticketNo %></div>
              <div class="text-[12.5px] font-bold text-amber-700 mt-1"><%= ((sh % 12) || 12) + t.slotStart.slice(2) + (sh < 12 ? ' AM' : ' PM') %></div></div>
            <% } else { %>
            <div class="lane-no font-mono text-[26px] font-bold leading-none"><%= t.ticketNo %></div>
            <% } %>
            <% }) %>
            <% if (more > 0) { %>
            <div class="text-[15px] font-bold text-slateSoft/60">+<%= more %> more</div>
            <% } %>
            <% if (!total) { %>
            <div class="text-[18px] text-slateSoft/45 font-semibold py-2">No one waiting</div>
            <% } else if (!shown.length && more <= 0) { %>
            <div class="text-[18px] text-slateSoft/45 font-semibold py-2">All in Next up</div>
            <% } %>
          </div>
        </div>
        <% }) %>
      </section>
    </div>

    <!-- right: SmartQ predicts. The real call order and the wait if you join now -->
    <aside class="order-2 lg:order-none lg:col-span-4 flex flex-col gap-5 min-h-0 min-w-0" data-live="predict" data-live-soft>
      <section style="view-transition-name:nextup" class="card px-6 py-5 lg:flex-1 lg:min-h-0 flex flex-col">
        <div class="label mb-3">Next up</div>
        <% if (predict.nextUp.length) { %>
        <ol class="space-y-2.5 lg:space-y-0 lg:flex-1 lg:flex lg:flex-col lg:justify-evenly lg:gap-3">
          <% predict.nextUp.forEach(function (n, i) { %>
          <li class="flex items-center justify-between gap-4 rounded-2xl px-4 py-2.5 lg:py-4 <%= i === 0 ? 'bg-brand-wash ring-2 ring-brand' : 'bg-[#F5F7FA]' %>">
            <span style="view-transition-name:tk-<%= n.ticketNo %>" class="font-mono text-[34px] lg:text-[min(6.5vh,3.2vw,56px)] font-extrabold leading-none whitespace-nowrap"><%= n.ticketNo %></span>
            <span class="text-right">
              <span class="block text-[12px] font-extrabold uppercase tracking-widest <%= i === 0 ? 'text-brand' : 'text-slateSoft/55' %>"><%= i === 0 ? 'Next' : 'Then' %></span>
              <span class="block text-[16px] font-bold text-ink whitespace-nowrap">~<%= n.at %></span>
            </span>
          </li>
          <% }) %>
        </ol>
        <% } else { %>
        <%# no one waiting: a calm note in the middle of the card, not a lonely line at the top %>
        <div class="flex-1 flex flex-col items-center justify-center text-center py-6">
          <div class="grid place-items-center w-14 h-14 rounded-full bg-[#F5F7FA] text-slateSoft/50" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.2"/><path d="M3.5 19c.6-3.2 2.8-5 5.5-5s4.9 1.8 5.5 5"/><path d="M16 4.8a3.2 3.2 0 0 1 0 6.4M17.5 14.2c1.7.6 2.7 2.3 3 4.8"/></svg>
          </div>
          <div class="mt-3 text-[22px] font-extrabold text-ink">No one waiting</div>
          <div class="mt-1 text-[15px] font-semibold text-slateSoft/70 max-w-[16rem]"><%= predict && predict.finishing ? "Today's line is almost done." : predict && predict.join ? "Get a number and you'll be called right away." : (/^Today's line opens/.test(predict && predict.note || '') ? 'Be one of the first when it opens.' : 'The line opens again on the next open day.') %></div>
        </div>
        <% } %>
      </section>

      <section style="view-transition-name:joinnow" class="card px-6 py-5">
        <div class="label mb-2">If you join now</div>
        <% if (predict.join) { %>
        <div class="text-[40px] lg:text-[min(6vh,3.4vw,52px)] font-extrabold leading-tight text-brand-night whitespace-nowrap"><% var jm = Math.round(predict.join.minutes || 0); %><%= jm < 1 ? 'Under a minute' : jm < 60 ? jm + ' min' : Math.floor(jm / 60) + ' h' + (jm % 60 ? ' ' + (jm % 60) + ' min' : '') %></div>
        <div class="text-[16px] font-semibold text-slateSoft mt-0.5">your turn around <strong class="text-ink"><%= predict.join.startClock %></strong></div>
        <% if (!predict.join.fits) { %><div class="mt-2 rounded-xl bg-amber-50 ring-1 ring-amber-200 px-3 py-2 text-[14px] font-bold text-amber-800">The line is long: you may not be served today</div><% } %>
        <% } else { %>
        <div class="text-[20px] font-bold text-slateSoft py-1"><%= predict.note || 'Estimate unavailable' %></div>
        <% } %>
        <div class="text-[14px] font-medium text-slateSoft/60 mt-2">
          <%= predict.avgWait ? "Today's real average wait: " + duration(predict.avgWait.minutes).replace('about ', '') : 'No one called yet today' %>
        </div>
      </section>
    </aside>
  </main>

  <!-- recently completed, then the announcement -->
  <div data-live="recent" data-live-soft>
  <% if (recent.length) { %>
  <section class="px-4 sm:px-8 py-3 border-t border-edge flex items-center gap-5 flex-wrap">
    <span class="text-[12px] font-extrabold uppercase tracking-[.22em] text-slateSoft/60">Just served</span>
    <% recent.forEach(function(t){ %>
    <span class="font-mono text-[22px] font-bold text-slateSoft/55"><%= t.ticketNo %></span>
    <% }) %>
  </section>
  <% } %>
  </div>

  <footer class="bg-brand text-white py-3.5 text-[20px] font-bold overflow-hidden" data-live="announce">
    <% if (settings.announcement) { %>
    <% if (String(settings.announcement).length > 70) { %><span class="marquee"><%= settings.announcement %></span>
    <% } else { %><div class="text-center px-8"><%= settings.announcement %></div><% } %>
    <% } %>
  </footer>
</div>

<script>
function tick(){
  var n = new Date(), p = function(v){ return String(v).padStart(2,'0') };
  // hours and minutes (12-hour, no seconds): ticking seconds only pull the eye
  document.getElementById('clock').textContent = ((n.getHours() % 12) || 12) + ':' + p(n.getMinutes());
  document.getElementById('dateline').textContent =
    n.toLocaleDateString('en-PH',{weekday:'long',year:'numeric',month:'long',day:'numeric'});
}
tick(); setInterval(tick, 1000);
</script>
<script>
// Night after office hours: dark at once if the board opens at night, then
// any change (closing, opening) fades slowly instead of flipping.
(function () {
  var html = document.documentElement;
  function night() { var f = document.querySelector('[data-live="mode"] [data-open]'); return !!f && f.getAttribute('data-open') !== '1'; }
  function apply() { html.classList.toggle('night', night()); }
  apply();
  requestAnimationFrame(function () { requestAnimationFrame(function () { html.classList.add('night-anim'); }); });
  // after a refresh (each part fades out, swaps, fades in), wait for the last
  // part, then change colours: otherwise new cards are born in the night colours
  var later = null;
  window.addEventListener('smartq:updated', function () {
    clearTimeout(later);
    later = setTimeout(function () { later = null; requestAnimationFrame(apply); }, 1200);   // after the last part has faded back in
  });
  setInterval(function () { if (!later) apply(); }, 15000);
})();
</script>
<script>
// the part that changed glows once, so new content is noticed
window.addEventListener('smartq:updated', function (e) {
  var el = e.detail && e.detail.root; if (!el) return;
  el.classList.remove('live-changed'); void el.offsetWidth; el.classList.add('live-changed');
});
</script>
<%- include('../../partials/live', { liveEvery: Math.max(5, Number(settings.refreshRate) || 10) }) %>
<%- include('../../partials/chime', {
      chimeScope: dept.toLowerCase(),
      chimeId: announcement ? announcement.id : '',
      pulseUrl: '/display/' + dept.toLowerCase() + '/pulse'
    }) %>
</body>
</html>
