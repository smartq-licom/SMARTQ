<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= dept %> Queue | SmartQ</title>
<script src="https://cdn.tailwindcss.com"></script>
<link rel="icon" href="/img/lcc-seal.jpg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=JetBrains+Mono:wght@700;800&display=swap" rel="stylesheet">
<script>
tailwind.config = { theme: { extend: {
  colors: { brand:{ DEFAULT:'#2185D5', deep:'#1A6CAE', night:'#0F4C81', wash:'#EAF3FB', line:'#C9E0F4' }, ink:'#1E2A36', slateSoft:'#4A5866', edge:'#E3E7ED' },
  fontFamily: { sans:['"Plus Jakarta Sans"','system-ui','sans-serif'], mono:['"JetBrains Mono"','ui-monospace','monospace'] },
}}}
</script>
<style>
  body{font-family:'Plus Jakarta Sans',system-ui,sans-serif;background:radial-gradient(90% 70% at 10% 0%,#EAF3FB 0%,#F2F4F8 55%)}
  .font-mono{font-variant-numeric:tabular-nums;letter-spacing:-.02em}
  .glow{text-shadow:0 4px 30px rgba(15,76,129,.35)}
  .card{background:#fff;border:1px solid #E3E7ED;border-radius:24px;box-shadow:0 1px 2px rgba(16,24,40,.04),0 8px 24px -8px rgba(16,24,40,.08)}
  .label{font-size:13px;font-weight:800;text-transform:uppercase;letter-spacing:.22em;color:#1A6CAE}
  /* a part that just changed glows once, instead of the whole screen reloading */
  .live-changed{animation:lc 1.4s ease-out}
  @keyframes lc{0%{filter:brightness(1.12) saturate(1.3)}100%{filter:none}}
  .serving-now{animation:pulse 2.4s ease-in-out infinite}
  @keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(33,133,213,.0),0 20px 60px -20px rgba(33,133,213,.6)}50%{box-shadow:0 0 0 6px rgba(33,133,213,.18),0 20px 60px -20px rgba(33,133,213,.8)}}
  .marquee{white-space:nowrap;display:inline-block;animation:mq 28s linear infinite;padding-left:100%}
  @keyframes mq{to{transform:translateX(-100%)}}
  @media (prefers-reduced-motion:reduce){.live-changed,.serving-now,.marquee{animation:none}.marquee{padding-left:0}}
</style>
</head>
<body class="text-ink antialiased">
<%- include('../../partials/board-loader') %>

<div class="min-h-screen lg:h-screen flex flex-col lg:overflow-hidden">

  <%# Opened from a student's ticket (the Board button adds ?from=<ticket token>):
      a way back to it. The office TV opens the plain address and never shows it. %>
  <a id="backToTicket" hidden data-loader-go data-loader-icon="queue" data-loader-mode="back" data-loader-text="Back to your ticket" aria-label="Back to my ticket" title="Back to my ticket"
     class="back-fab fixed z-50 right-4 grid place-items-center w-14 h-14 rounded-full text-white bg-gradient-to-br from-[#2E9BEA] via-brand to-brand-night shadow-[0_12px_28px_-8px_rgba(26,108,174,.7)] hover:brightness-110 active:scale-95 transition">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 14 4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11"/></svg>
  </a>
  <style>
    .back-fab[hidden]{ display:none !important }           /* the office TV: never shown */
    .back-fab{ bottom:calc(16px + env(safe-area-inset-bottom)); animation:fab-in .4s cubic-bezier(.2,.8,.2,1) both }
    @keyframes fab-in{ from{ opacity:0; transform:translateY(16px) scale(.85) } to{ opacity:1; transform:none } }
    @media (prefers-reduced-motion:reduce){ .back-fab{ animation:none } }
    @media print{ .back-fab{ display:none !important } }
  </style>
  <script>
    (function () {
      var from = new URLSearchParams(location.search).get('from') || '';
      if (!/^[a-f0-9]{32}$/.test(from)) return;            // only a real ticket link
      var a = document.getElementById('backToTicket');
      a.href = '/queue/t/' + from;
      a.hidden = false;
    })();
  </script>

  <!-- header -->
  <header class="px-4 sm:px-8 pt-6 pb-4 flex flex-wrap items-center justify-between gap-4">
    <div class="flex items-center gap-4">
      <img src="/img/lcc-seal.jpg" alt="Libon Community College seal"
           class="w-12 h-12 sm:w-16 sm:h-16 xl:w-[72px] xl:h-[72px] rounded-full ring-4 ring-brand-line bg-white object-cover">
      <div>
        <div class="text-[26px] sm:text-[34px] xl:text-[40px] font-extrabold tracking-tight leading-none"><%= dept %></div>
        <div class="text-[15px] text-slateSoft/70 font-medium mt-1.5"><%= settings.institutionName %> &middot; Smart<span class="text-brand">Q</span></div>
      </div>
    </div>
    <div class="text-right">
      <div id="clock" class="font-mono text-[30px] sm:text-[44px] xl:text-[52px] font-extrabold leading-none text-brand-night">--:--:--</div>
      <div id="dateline" class="text-[14px] text-slateSoft/70 font-semibold mt-1.5"></div>
    </div>
  </header>

  <% var nextNo = predict.nextUp.length ? predict.nextUp[0].ticketNo : null; %>
  <main class="flex-1 min-h-0 grid lg:grid-cols-12 gap-6 px-4 sm:px-8 pb-6">

    <!-- left: now serving, then the two lanes -->
    <div class="lg:col-span-8 flex flex-col gap-6 min-h-0 min-w-0">
      <%# on a TV (lg): Now serving takes the free height, so its number can be big %>
      <section data-live="serving" class="lg:flex-1 lg:min-h-0 flex flex-col">
        <div class="label mb-3">Now serving</div>
        <div class="grid <%= windows.length > 1 ? 'md:grid-cols-2' : '' %> <%= windows.length > 2 ? 'xl:grid-cols-3' : '' %> gap-5 lg:flex-1 lg:min-h-0">
          <% var big = windows.length > 1 ? 'lg:text-[min(17vh,7vw)]' : 'lg:text-[min(22vh,13vw)]'; %>
          <% windows.forEach(function(w){ %>
          <% const s = serving.find(function(t){ return t.windowId === w.id }); %>
          <% if (s) { %>
          <div class="serving-now text-white rounded-[28px] bg-gradient-to-br from-[#2E9BEA] via-brand to-brand-night px-5 sm:px-8 py-7 text-center flex flex-col justify-center">
            <div class="text-[16px] font-extrabold uppercase tracking-[.2em] text-white/80"><%= w.label %></div>
            <div class="font-mono glow text-[72px] sm:text-[110px] <%= big %> leading-[1] font-extrabold mt-2"><%= s.ticketNo %></div>
            <div class="mt-3 flex items-center justify-center gap-3">
              <%# no name on a public screen: the number is enough %>
              <span class="rounded-full px-4 py-1.5 text-[14px] font-extrabold uppercase tracking-wide <%= s.queueCategory === 'priority' ? 'bg-violet-500' : 'bg-white/20' %>"><%= s.queueCategory %></span>
            </div>
          </div>
          <% } else { %>
          <div class="card px-5 sm:px-8 py-7 text-center flex flex-col justify-center">
            <div class="text-[16px] font-extrabold uppercase tracking-[.2em] text-slateSoft/60"><%= w.label %></div>
            <div class="font-mono text-[72px] sm:text-[110px] <%= big %> leading-[1] font-extrabold mt-2 text-edge">----</div>
            <div class="mt-3 flex items-center justify-center gap-3">
              <span class="rounded-full px-4 py-1.5 text-[14px] font-extrabold uppercase tracking-wide bg-[#F5F7FA] text-slateSoft"><%= w.status %></span>
              <span class="text-[19px] font-bold text-slateSoft/50"><%= w.status === 'open' ? 'Available' : '' %></span>
            </div>
          </div>
          <% } %>
          <% }) %>
        </div>
      </section>

      <section class="min-h-0 grid md:grid-cols-2 gap-5" data-live="lanes">
        <%# A calm lane: the first few numbers, light and small, so the eye goes to
            "Now serving" and "Next"; the rest is a count ("+16 more"). %>
        <% var SHOW = 6, counts = typeof waitingCount !== 'undefined' ? waitingCount : {}; %>
        <% [['Priority', priority, 'bg-violet-500', counts.priority], ['Regular', regular, 'bg-brand', counts.regular]].forEach(function (g) {
             var total = g[3] != null ? g[3] : g[1].length, shown = g[1].slice(0, SHOW), more = total - shown.length; %>
        <div class="card px-6 py-5 min-h-0 overflow-hidden">
          <div class="flex items-center gap-3 mb-4">
            <span class="w-2.5 h-2.5 rounded-full <%= g[2] %>"></span>
            <span class="label !text-slateSoft"><%= g[0] %></span>
            <span class="ml-auto text-[14px] font-bold text-slateSoft"><span class="font-mono text-[18px] font-extrabold text-ink"><%= total %></span> waiting</span>
          </div>
          <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
            <% shown.forEach(function(t){ %>
            <% if (t.ticketNo === nextNo) { %>
            <div class="rounded-2xl px-4 py-2 bg-brand text-white shadow-lg shadow-brand/30">
              <div class="font-mono text-[30px] font-extrabold leading-none"><%= t.ticketNo %></div>
              <div class="text-[11px] font-extrabold uppercase tracking-widest text-white/85 mt-1">Next</div>
            </div>
            <% } else { %>
            <div class="font-mono text-[24px] font-semibold leading-none text-slateSoft/70"><%= t.ticketNo %></div>
            <% } %>
            <% }) %>
            <% if (more > 0) { %>
            <div class="text-[15px] font-bold text-slateSoft/60">+<%= more %> more</div>
            <% } %>
            <% if (!total) { %>
            <div class="text-[18px] text-slateSoft/45 font-semibold py-2">No one waiting</div>
            <% } %>
          </div>
        </div>
        <% }) %>
      </section>
    </div>

    <!-- right: SmartQ predicts. The real call order and the wait if you join now -->
    <aside class="lg:col-span-4 flex flex-col gap-5 min-h-0 min-w-0" data-live="predict">
      <section class="card px-6 py-5 lg:flex-1 lg:min-h-0 flex flex-col">
        <div class="label mb-3">Next up</div>
        <% if (predict.nextUp.length) { %>
        <ol class="space-y-2.5 lg:space-y-0 lg:flex-1 lg:flex lg:flex-col lg:justify-evenly lg:gap-3">
          <% predict.nextUp.forEach(function (n, i) { %>
          <li class="flex items-center justify-between gap-4 rounded-2xl px-4 py-2.5 lg:py-4 <%= i === 0 ? 'bg-brand-wash ring-2 ring-brand' : 'bg-[#F5F7FA]' %>">
            <span class="font-mono text-[34px] lg:text-[min(6.5vh,3.2vw,56px)] font-extrabold leading-none whitespace-nowrap"><%= n.ticketNo %></span>
            <span class="text-right">
              <span class="block text-[12px] font-extrabold uppercase tracking-widest <%= i === 0 ? 'text-brand' : 'text-slateSoft/55' %>"><%= i === 0 ? 'Next' : 'Then' %></span>
              <span class="block text-[16px] font-bold text-ink whitespace-nowrap">~<%= n.at %></span>
            </span>
          </li>
          <% }) %>
        </ol>
        <% } else { %>
        <div class="text-[19px] font-bold text-slateSoft/45 py-2">No one waiting</div>
        <% } %>
      </section>

      <section class="card px-6 py-5">
        <div class="label mb-2">If you join now</div>
        <% if (predict.join) { %>
        <div class="text-[40px] font-extrabold leading-tight text-brand-night"><%= duration(predict.join.minutes).replace('about ', '') %></div>
        <div class="text-[16px] font-semibold text-slateSoft mt-0.5">your turn around <strong class="text-ink"><%= predict.join.startClock %></strong></div>
        <% if (!predict.join.fits) { %><div class="mt-2 rounded-xl bg-amber-50 ring-1 ring-amber-200 px-3 py-2 text-[14px] font-bold text-amber-800">The line is long: you may not be served today</div><% } %>
        <% } else { %>
        <div class="text-[20px] font-bold text-slateSoft py-1"><%= predict.note || 'Estimate unavailable' %></div>
        <% } %>
        <div class="text-[14px] font-medium text-slateSoft/60 mt-2">
          <%= predict.avgWait ? "Today's real average wait: " + duration(predict.avgWait.minutes).replace('about ', '') : 'No one called yet today' %>
        </div>
      </section>
    </aside>
  </main>

  <!-- recently completed, then the announcement -->
  <div data-live="recent">
  <% if (recent.length) { %>
  <section class="px-4 sm:px-8 py-3 border-t border-edge flex items-center gap-5 flex-wrap">
    <span class="text-[12px] font-extrabold uppercase tracking-[.22em] text-slateSoft/50">Recently completed</span>
    <% recent.forEach(function(t){ %>
    <span class="font-mono text-[22px] font-extrabold text-slateSoft/40"><%= t.ticketNo %></span>
    <% }) %>
  </section>
  <% } %>
  </div>

  <footer class="bg-brand text-white py-3.5 text-[20px] font-bold overflow-hidden" data-live="announce">
    <% if (settings.announcement) { %>
    <% if (String(settings.announcement).length > 70) { %><span class="marquee"><%= settings.announcement %></span>
    <% } else { %><div class="text-center px-8"><%= settings.announcement %></div><% } %>
    <% } %>
  </footer>
</div>

<script>
function tick(){
  var n = new Date(), p = function(v){ return String(v).padStart(2,'0') };
  document.getElementById('clock').textContent = p(n.getHours())+':'+p(n.getMinutes())+':'+p(n.getSeconds());
  document.getElementById('dateline').textContent =
    n.toLocaleDateString('en-PH',{weekday:'long',year:'numeric',month:'long',day:'numeric'});
}
tick(); setInterval(tick, 1000);
</script>
<script>
// the part that changed glows once, so a new number is noticed without a flash
window.addEventListener('smartq:updated', function (e) {
  var el = e.detail && e.detail.root; if (!el) return;
  el.classList.remove('live-changed'); void el.offsetWidth; el.classList.add('live-changed');
});
</script>
<%- include('../../partials/live', { liveEvery: Math.max(5, Number(settings.refreshRate) || 10) }) %>
<%- include('../../partials/chime', {
      chimeScope: dept.toLowerCase(),
      chimeId: announcement ? announcement.id : '',
      pulseUrl: '/display/' + dept.toLowerCase() + '/pulse'
    }) %>
</body>
</html>
