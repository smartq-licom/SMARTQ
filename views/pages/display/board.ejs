<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="refresh" content="<%= settings.refreshRate %>">
<title><%= dept %> Queue | SmartQ</title>
<script src="https://cdn.tailwindcss.com"></script>
<link rel="icon" href="/img/lcc-seal.jpg">
<link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@500;600;700;800;900&display=swap" rel="stylesheet">
<script>
tailwind.config = { theme: { extend: { colors: {
  brand:{ DEFAULT:'#2185D5', deep:'#1A6CAE', wash:'#E7F1FA' },
  ink:'#303841', slateSoft:'#3A4750', mist:'#F3F3F3', hair:'#DFE2E6'
}}}}
</script>
<style>
  body{font-family:'Public Sans',system-ui,sans-serif}
  .blink{animation:bl 1.6s ease-in-out infinite}
  @keyframes bl{0%,100%{opacity:1}50%{opacity:.55}}
</style>
</head>
<body class="bg-white text-ink">

<div class="min-h-screen flex flex-col">

  <!-- header -->
  <header class="border-b-[6px] border-brand px-8 py-5 flex items-center justify-between gap-6">
    <div class="flex items-center gap-5">
      <img src="/img/lcc-seal.jpg" alt="Libon Community College seal"
           class="w-16 h-16 xl:w-20 xl:h-20 rounded-full ring-4 ring-brand/25 object-cover">
      <div>
        <div class="text-3xl xl:text-4xl font-black tracking-tight uppercase text-ink"><%= dept %></div>
        <div class="text-[15px] text-slateSoft font-medium"><%= settings.institutionName %></div>
      </div>
    </div>
    <div class="text-right">
      <div id="clock" class="text-4xl xl:text-5xl font-black tabular-nums text-brand-deep">--:--:--</div>
      <div id="dateline" class="text-[14px] text-slateSoft font-semibold"></div>
    </div>
  </header>

  <!-- now serving -->
  <section class="px-8 py-7 border-b-2 border-hair">
    <div class="text-[15px] font-black uppercase tracking-[0.2em] text-brand mb-5">Now Serving</div>
    <div class="grid <%= windows.length > 1 ? 'md:grid-cols-2' : '' %> gap-6">
      <% windows.forEach(function(w){ %>
      <% const s = serving.find(function(t){ return t.windowId === w.id }); %>
      <div class="rounded-2xl border-4 <%= s ? 'border-brand bg-brand-wash/40' : 'border-hair' %> px-8 py-8 text-center">
        <div class="text-[15px] font-extrabold uppercase tracking-widest text-slateSoft"><%= w.label %></div>
        <% if (s) { %>
          <div class="text-[110px] xl:text-[150px] leading-[0.95] font-black tracking-tighter mt-2 tabular-nums text-brand-deep"><%= s.ticketNo %></div>
          <div class="mt-3 flex items-center justify-center gap-3">
            <span class="rounded-full px-4 py-1.5 text-[15px] font-black uppercase tracking-wide
              <%= s.queueCategory === 'priority' ? 'bg-ink text-white' : 'bg-brand text-white' %>">
              <%= s.queueCategory %>
            </span>
          </div>
          <div class="text-[19px] font-bold mt-3 text-ink"><%= s.name %></div>
        <% } else { %>
          <div class="text-[110px] xl:text-[150px] leading-[0.95] font-black tracking-tighter mt-2 text-hair">----</div>
          <div class="text-[17px] font-bold text-slateSoft/60 mt-3">Available</div>
          <div class="mt-2"><span class="rounded-full px-4 py-1 text-[13px] font-bold uppercase bg-mist text-slateSoft"><%= w.status %></span></div>
        <% } %>
      </div>
      <% }) %>
    </div>
  </section>

  <!-- SmartQ predicts: the real call order, the wait if you join now, today's average, a QR to join -->
  <% var nextNo = predict.nextUp.length ? predict.nextUp[0].ticketNo : null; %>
  <section class="px-8 py-5 border-b-2 border-hair bg-mist/60">
    <div class="flex flex-wrap items-stretch gap-6">
      <div class="flex-1 min-w-[16rem]">
        <div class="text-[15px] font-black uppercase tracking-[0.2em] text-brand mb-3">Next up</div>
        <% if (predict.nextUp.length) { %>
        <div class="flex flex-wrap gap-3">
          <% predict.nextUp.forEach(function (n, i) { %>
          <div class="rounded-xl border-2 <%= i === 0 ? 'border-brand bg-white' : 'border-hair bg-white' %> px-5 py-3 min-w-[9rem]">
            <div class="text-4xl font-black tabular-nums <%= i === 0 ? 'text-brand-deep' : '' %>"><%= n.ticketNo %></div>
            <div class="text-[13px] font-bold text-slateSoft mt-0.5"><%= i === 0 ? 'next' : 'then' %> &middot; about <%= n.at %></div>
          </div>
          <% }) %>
        </div>
        <% } else { %>
        <div class="text-[19px] font-bold text-slateSoft/70 py-3">No one waiting</div>
        <% } %>
      </div>
      <div class="w-px bg-hair hidden lg:block"></div>
      <div class="min-w-[15rem]">
        <div class="text-[15px] font-black uppercase tracking-[0.2em] text-brand mb-3">If you join now</div>
        <% if (predict.join) { %>
        <div class="text-4xl font-black text-ink leading-tight"><%= duration(predict.join.minutes).replace('about ', '') %></div>
        <div class="text-[15px] font-bold text-slateSoft mt-1">your turn around <%= predict.join.startClock %></div>
        <% if (!predict.join.fits) { %><div class="text-[14px] font-bold text-amber-700 mt-1">The line is long: you may not be served today</div><% } %>
        <% } else { %>
        <div class="text-[19px] font-bold text-slateSoft py-2 max-w-[16rem]"><%= predict.note || 'Estimate unavailable' %></div>
        <% } %>
        <div class="text-[14px] font-semibold text-slateSoft/80 mt-2">
          <%= predict.avgWait ? "Today's actual average wait: " + duration(predict.avgWait.minutes).replace('about ', '') : 'No one called yet today' %>
        </div>
      </div>
      <div class="w-px bg-hair hidden lg:block"></div>
      <div class="flex items-center gap-4">
        <div class="bg-white p-2.5 rounded-xl border-2 border-brand w-32 h-32 [&_svg]:w-full [&_svg]:h-full" aria-label="QR code to join the queue"><%- predict.qr %></div>
        <div class="max-w-[9rem]">
          <div class="text-[19px] font-black text-ink leading-tight">Scan to join</div>
          <div class="text-[13px] font-semibold text-slateSoft mt-1">No account needed. Wait anywhere and get alerts.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- waiting lanes -->
  <section class="flex-1 grid md:grid-cols-2 gap-0">
    <div class="px-8 py-6 md:border-r-2 border-hair">
      <div class="flex items-center gap-3 mb-4">
        <span class="text-[15px] font-black uppercase tracking-[0.2em] text-slateSoft">Priority</span>
        <span class="rounded-full bg-brand text-white px-3 py-0.5 text-[13px] font-black"><%= priority.length %></span>
      </div>
      <div class="flex flex-wrap gap-3">
        <% priority.forEach(function(t, i){ %>
        <div class="rounded-xl border-2 <%= t.ticketNo === nextNo ? 'border-brand bg-brand-wash' : 'border-hair' %> px-5 py-3">
          <div class="text-4xl font-black tabular-nums"><%= t.ticketNo %></div>
          <% if (t.ticketNo === nextNo) { %><div class="text-[11px] font-black uppercase tracking-widest text-brand mt-0.5">Next</div><% } %>
        </div>
        <% }) %>
        <% if (!priority.length) { %>
        <div class="text-[17px] text-slateSoft/60 font-semibold py-3">No one waiting</div>
        <% } %>
      </div>
    </div>

    <div class="px-8 py-6">
      <div class="flex items-center gap-3 mb-4">
        <span class="text-[15px] font-black uppercase tracking-[0.2em] text-slateSoft">Regular</span>
        <span class="rounded-full bg-brand text-white px-3 py-0.5 text-[13px] font-black"><%= regular.length %></span>
      </div>
      <div class="flex flex-wrap gap-3">
        <% regular.forEach(function(t, i){ %>
        <div class="rounded-xl border-2 <%= t.ticketNo === nextNo ? 'border-brand bg-brand-wash' : 'border-hair' %> px-5 py-3">
          <div class="text-4xl font-black tabular-nums"><%= t.ticketNo %></div>
          <% if (t.ticketNo === nextNo) { %><div class="text-[11px] font-black uppercase tracking-widest text-brand mt-0.5">Next</div><% } %>
        </div>
        <% }) %>
        <% if (!regular.length) { %>
        <div class="text-[17px] text-slateSoft/60 font-semibold py-3">No one waiting</div>
        <% } %>
      </div>
    </div>
  </section>

  <!-- recently called -->
  <% if (recent.length) { %>
  <section class="px-8 py-4 border-t-2 border-hair">
    <div class="flex items-center gap-4 flex-wrap">
      <span class="text-[13px] font-black uppercase tracking-[0.2em] text-slateSoft/70">Recently completed</span>
      <% recent.forEach(function(t){ %>
      <span class="text-2xl font-black text-slateSoft/50 tabular-nums"><%= t.ticketNo %></span>
      <% }) %>
    </div>
  </section>
  <% } %>

  <!-- announcement -->
  <footer class="bg-brand text-white px-8 py-4 text-center text-[19px] font-bold">
    <%= settings.announcement %>
  </footer>
</div>

<script>
function tick(){
  var n = new Date(), p = function(v){ return String(v).padStart(2,'0') };
  document.getElementById('clock').textContent = p(n.getHours())+':'+p(n.getMinutes())+':'+p(n.getSeconds());
  document.getElementById('dateline').textContent =
    n.toLocaleDateString('en-PH',{weekday:'long',year:'numeric',month:'long',day:'numeric'});
}
tick(); setInterval(tick, 1000);
</script>
<%- include('../../partials/chime', {
      chimeScope: dept.toLowerCase(),
      chimeId: announcement ? announcement.id : '',
      pulseUrl: '/display/' + dept.toLowerCase() + '/pulse'
    }) %>
</body>
</html>
