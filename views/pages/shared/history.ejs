<%- include('../../partials/head') %>
<%- include('../../partials/nav', { active: base }) %>
<%# Queue History: one row per student/client, counted from their tickets. %>
<div class="mb-4">
  <h2 class="text-xl font-extrabold">Queue History</h2>
  <p class="text-[13px] text-slateSoft/80 mt-0.5">
    Every student and client with how many of their transactions were served.
    Open <strong>View History</strong> to see each ticket.
  </p>
</div>

<%- include('../../partials/history-filters', { f: f, choices: choices, office: office, action: base, showSearch: true }) %>

<%
  // Click a header to sort by it; click again to reverse. Filters and search stay.
  function sortHref(key) {
    var keep = [];
    Object.keys(query || {}).forEach(function (k) {
      if (['sort', 'dir', 'page'].indexOf(k) < 0 && query[k]) keep.push(k + '=' + encodeURIComponent(query[k]));
    });
    // numbers and dates read best biggest / newest first
    var first = ['completed', 'cancelled', 'pending', 'last'].indexOf(key) >= 0 ? 'desc' : 'asc';
    var dir = f.sort === key ? (f.dir === 'asc' ? 'desc' : 'asc') : first;
    keep.push('sort=' + key, 'dir=' + dir);
    return base + '?' + keep.join('&');
  }
  function sortTh(key, label, sub) {
    var on = f.sort === key;
    return '<th class="' + UI.th + '" aria-sort="' + (on ? (f.dir === 'asc' ? 'ascending' : 'descending') : 'none') + '">' +
      '<a href="' + sortHref(key) + '" class="inline-flex items-center gap-1 hover:text-brand ' + (on ? 'text-brand' : '') + '">' + label +
      '<span aria-hidden="true" class="' + (on ? '' : 'opacity-30') + '">' + (on ? (f.dir === 'asc' ? '&#9650;' : '&#9660;') : '&#8693;') + '</span></a>' +
      (sub ? '<span class="block font-normal normal-case tracking-normal text-[10.5px]">' + sub + '</span>' : '') + '</th>';
  }
%>
<div class="<%= UI.card %>">
  <div class="overflow-x-auto">
  <table class="w-full">
    <thead><tr>
      <%- sortTh('name', 'Student / Client') %>
      <%- sortTh('studentNo', 'Student no.') %>
      <%- sortTh('completed', 'Total Transactions', 'completed / served') %>
      <%- sortTh('cancelled', 'Cancelled / No-show') %>
      <%- sortTh('pending', 'Pending') %>
      <%- sortTh('last', 'Last ticket') %>
      <th class="<%= UI.th %>"></th>
    </tr></thead>
    <tbody>
      <% rows.forEach(function (r) { %>
      <tr class="<%= UI.tr %>">
        <td class="<%= UI.td %>">
          <span class="font-semibold"><%= r.fullName %></span>
          <% if (r.deleted) { %><span class="<%= pill %> bg-mist text-slateSoft ml-1">deleted account</span><% } %>
          <span class="block text-[11.5px] text-slateSoft/75"><span class="capitalize"><%= r.role %></span><%= r.login ? ' · ' + r.login : '' %></span>
        </td>
        <td class="<%= UI.td %> font-mono text-[12px]"><%= r.studentNo || '-' %></td>
        <td class="<%= UI.td %> text-[16px] font-extrabold"><%= r.completed %></td>
        <td class="<%= UI.td %> font-mono"><%= r.cancelled %></td>
        <td class="<%= UI.td %> font-mono"><%= r.pending %></td>
        <td class="<%= UI.td %> text-[12px] whitespace-nowrap"><%= r.lastAt ? new Date(r.lastAt).toLocaleDateString('en-PH', { month: 'short', day: 'numeric', year: 'numeric' }) : '-' %></td>
        <td class="<%= UI.td %>">
          <%
            var keep = [];
            ['from','to','document','status','staff','lane','office'].forEach(function (k) { if (query[k]) keep.push(k + '=' + encodeURIComponent(query[k])); });
          %>
          <a href="<%= base %>/<%= r.id %><%= keep.length ? '?' + keep.join('&') : '' %>" class="<%= UI.btn %> <%= UI.btnGh %> <%= UI.btnSm %>">View History</a>
        </td>
      </tr>
      <% }) %>
      <% if (!rows.length) { %>
      <tr><td colspan="7" class="px-4 py-10 text-center text-[13px] text-slateSoft/80">No students or clients match these filters.</td></tr>
      <% } %>
    </tbody>
  </table>
  </div>
  <%- include('../../partials/pagination', { pg: pg, label: 'students / clients' }) %>
</div>
<%- include('../../partials/foot') %>
<%- include('../../partials/scripts') %>
