<%- include('../../partials/head') %>
<%- include('../../partials/public-nav') %>
<div class="max-w-md mx-auto">
  <div class="mb-4">
    <h2 class="text-xl font-extrabold">Find my ticket</h2>
    <p class="text-[13px] text-slateSoft/80 mt-0.5">
      Lost the page or using another phone? Enter the booking code shown on your ticket.
    </p>
  </div>

  <% if (formError) { %>
  <div role="alert" class="mb-4 rounded-lg bg-red-50 border-l-4 border-red-600 px-4 py-3 text-[13px] font-medium text-red-900"><%= formError %></div>
  <% } %>

  <form method="POST" action="/queue/find" class="<%= UI.card %> p-5 space-y-4" data-once>
    <div>
      <label for="code" class="<%= UI.lbl %>">Booking code</label>
      <input id="code" name="code" required maxlength="6" autocomplete="off" autocapitalize="characters"
             value="<%= form.code || '' %>" placeholder="e.g. K7MX2Q"
             class="<%= UI.input %> font-mono text-lg tracking-[.25em] uppercase">
    </div>
    <div>
      <label for="who" class="<%= UI.lbl %>">Student number <span class="font-normal text-slateSoft/70">(visitors: last name)</span></label>
      <input id="who" name="who" required maxlength="60" autocomplete="off" value="<%= form.who || '' %>" class="<%= UI.input %>">
    </div>
    <button type="submit" class="<%= UI.btn %> <%= UI.btnMain %> w-full py-3">Open my ticket</button>
  </form>

  <p class="mt-4 text-center text-[12.5px] text-slateSoft/75">
    No booking code? Ask at the office window. <a href="/queue" class="text-brand font-semibold">Back to the queue</a>
  </p>
</div>
<%- include('../../partials/foot') %>
<%- include('../../partials/scripts') %>
