<%- include('../../partials/head') %>
<%
  const about = {
    Cashier:   { what: 'Pay for documents', eg: 'Transcript of Records, certifications, other paid documents' },
    Registrar: { what: 'Free requests and claiming', eg: 'Claim a paid document, submit or request free documents' },
  };
  const mins = m => duration(m);
  const mineAt = {};
  active.forEach(function (t) { if (!mineAt[t.department]) mineAt[t.department] = t; });
%>
<%- include('../../partials/queue-welcome', {
      offices: offices, mineAt: mineAt,
      waitText: function (m, o) { return sameDay.early ? 'Line opens ' + sameDay.opensClock
        : o && o.beforeOpen ? 'Opens ' + o.openClock : (m == null ? 'Book a time' : duration(m, true) + ' wait'); }
    }) %>
<%- include('../../partials/public-nav') %>
<div data-live="home">

<% if (active.length) { %>
<section class="mb-6" aria-labelledby="mineTitle">
  <h2 id="mineTitle" class="text-[13px] font-bold uppercase tracking-wider text-slateSoft/80 mb-2">Your ticket<%= active.length > 1 ? 's' : '' %> on this phone</h2>
  <div class="grid gap-2.5 sm:grid-cols-2">
    <% active.forEach(function (t) { %>
    <a href="/queue/t/<%= t.accessToken %>" class="<%= UI.card %> flex items-center gap-4 px-4 py-3.5 hover:border-brand transition-colors">
      <span class="font-mono text-2xl font-extrabold text-ink whitespace-nowrap"><%= t.ticketNo %></span>
      <span class="min-w-0">
        <span class="block text-[13.5px] font-bold text-ink"><%= t.department %></span>
        <span class="block text-[12px] text-slateSoft/80"><%= t.visitDateText %> &middot; <%= label(t.ticketStatus) %></span>
      </span>
      <span class="ml-auto text-brand text-[13px] font-semibold">Open &rarr;</span>
    </a>
    <% }) %>
  </div>
</section>
<% } %>

<div class="mb-4">
  <h2 class="text-2xl font-extrabold tracking-tight">What are your transactions today?</h2>
  <p class="text-[13.5px] text-slateSoft/80 mt-1">
    Choose an office to get a queue number. No account or login needed.
    Office hours: <%= officeHours %>.
  </p>
</div>

<% if (!sameDay.open) { %>
<p class="mb-4 rounded-lg bg-amber-50 border border-amber-200 px-4 py-3 text-[13px] text-amber-900">
  <% if (sameDay.early) { %>
  Today's line opens at <strong><%= sameDay.opensClock %></strong>, an hour before the office. You can book a time now.
  <% } else { %>
  <%= sameDay.why.replace(', so please pick a date.', '.').replace(', so please pick a working day.', '.') %>
  You can still book a number for a later date.
  <% } %>
</p>
<% } %>

<div class="grid gap-4 sm:grid-cols-2">
  <% ['Cashier', 'Registrar'].forEach(function (off) { const o = offices[off]; const mine = mineAt[off]; %>
  <section class="<%= UI.card %> flex flex-col" aria-labelledby="off-<%= off %>">
    <div class="px-5 pt-5">
      <h3 id="off-<%= off %>" class="text-[18px] font-extrabold text-ink"><%= off %></h3>
      <p class="text-[13px] font-semibold text-slateSoft mt-0.5"><%= about[off].what %></p>
      <p class="text-[12px] text-slateSoft/70 mt-0.5"><%= about[off].eg %></p>
    </div>

    <dl class="grid grid-cols-2 gap-3 px-5 py-4">
      <div class="rounded-lg bg-mist px-3 py-3">
        <dt class="text-[11px] uppercase tracking-wider text-slateSoft/75">In the queue</dt>
        <dd class="font-mono text-3xl font-extrabold text-ink mt-0.5"><%= o.waiting %></dd>
        <dd class="text-[11.5px] text-slateSoft/75"><%= o.waiting === 1 ? 'student waiting' : 'students waiting' %></dd>
        <%# the rest of today's picture, so "0 waiting" never looks like lost numbers %>
        <% if (o.serving || o.served) { %>
        <dd class="text-[11px] text-slateSoft/65 mt-1 leading-snug">
          <%= o.serving ? o.serving + ' at the window' : '' %><%= o.serving && o.served ? ' · ' : '' %><%= o.served ? o.served + ' served today' : '' %>
        </dd>
        <% } %>
      </div>
      <div class="rounded-lg bg-brand-wash px-3 py-3">
        <dt class="text-[11px] uppercase tracking-wider text-brand-deep/80">If you join now</dt>
        <% if (o.minutes == null && sameDay.early) { %>
        <dd class="text-[15px] font-extrabold text-brand-deep mt-1.5 leading-tight">Line opens at <%= sameDay.opensClock %></dd>
        <dd class="text-[11.5px] text-brand-deep/75">book a time now, or come back then</dd>
        <% } else if (o.minutes == null) { %>
        <dd class="text-[15px] font-bold text-brand-deep mt-1.5">Book a time</dd>
        <dd class="text-[11.5px] text-brand-deep/75">same-day line is closed</dd>
        <% } else if (o.beforeOpen) { %>
        <dd class="text-[15px] font-extrabold text-brand-deep mt-1.5 leading-tight">Opens at <%= o.openClock %></dd>
        <dd class="text-[11.5px] text-brand-deep/75"><%= o.waiting ? o.waiting + ' already in line' : "you'd be among the first" %></dd>
        <% } else { %>
        <dd class="text-[15px] font-extrabold text-brand-deep mt-1.5 leading-tight"><%= mins(o.minutes) %></dd>
        <dd class="text-[11.5px] text-brand-deep/75">your turn around <%= o.startClock %><%= o.closed ? ' (once a window opens)' : '' %></dd>
        <% } %>
      </div>
    </dl>

    <%# Today's real average next to the prediction, and the capacity decision. %>
    <div class="px-5 -mt-1 pb-3 space-y-1.5">
      <p class="text-[12px] text-slateSoft/80">
        <% if (o.avgWait) { %>Today's actual average wait: <strong><%= duration(o.avgWait.minutes).replace('about ', '') %></strong>
          (from <%= o.avgWait.served %> served)<% } else { %>No one has been served yet today.<% } %>
      </p>
      <% if (o.minutes != null && !o.fits) { %>
      <p class="rounded-lg bg-amber-50 border border-amber-200 px-3 py-2 text-[12px] text-amber-900">
        &#9888;&#65039; The line is long: if you join now you may not be served before closing. Consider booking a time tomorrow.
      </p>
      <% } %>
    </div>

    <% if (o.nowServing.length) { %>
    <div class="px-5 pb-3 text-[12px] text-slateSoft/80 flex flex-wrap items-center gap-1.5">
      Now serving:
      <% o.nowServing.forEach(function (w) { %>
      <span class="<%= chip %>"><%= w.ticket %></span><span class="text-slateSoft/60"><%= w.label %></span>
      <% }) %>
    </div>
    <% } %>

    <div class="mt-auto px-5 pb-5">
      <% if (mine) { %>
      <a href="/queue/t/<%= mine.accessToken %>" class="<%= UI.btn %> <%= UI.btnGh %> w-full py-3">You have <%= mine.ticketNo %> here &rarr;</a>
      <% } else { %>
      <a href="/queue/new?office=<%= off %>" class="<%= UI.btn %> <%= UI.btnMain %> w-full py-3 text-[14px]">Get a <%= off %> number</a>
      <% } %>
    </div>
  </section>
  <% }) %>
</div>

<p class="mt-5 text-[12px] text-slateSoft/70 text-center">
  The wait is an estimate from how fast the windows have been serving today. It updates by itself.
</p>

<% if (past.length) { %>
<section class="mt-6">
  <h2 class="text-[12px] font-bold uppercase tracking-wider text-slateSoft/70 mb-2">Recent on this phone</h2>
  <ul class="<%= UI.card %> divide-y divide-hair">
    <% past.forEach(function (t) { %>
    <li><a href="/queue/t/<%= t.accessToken %>" class="flex items-center gap-3 px-4 py-2.5 text-[13px] hover:bg-brand-wash/40">
      <span class="font-mono font-bold"><%= t.ticketNo %></span>
      <span class="text-slateSoft/80"><%= t.department %> &middot; <%= t.visitDateText %></span>
      <span class="ml-auto <%= pill %> <%= tone(t.ticketStatus) %>"><%= t.ticketStatus %></span>
    </a></li>
    <% }) %>
  </ul>
</section>
<% } %>

</div>
<%- include('../../partials/live', { liveEvery: 20 }) %>
<%- include('../../partials/foot') %>
<%- include('../../partials/scripts') %>
