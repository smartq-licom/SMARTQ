<%- include('../../partials/head') %>
<%
  const about = {
    Cashier:   { what: 'Pay for documents', eg: 'TOR, certifications, other paid documents',
                 icon: '<path d="M12 3v18M16.5 7.5c0-1.7-2-3-4.5-3s-4.5 1.3-4.5 3 2 2.6 4.5 3 4.5 1.3 4.5 3-2 3-4.5 3-4.5-1.3-4.5-3"/>' },
    Registrar: { what: 'Free requests and claiming', eg: 'Claim a paid document, or request free ones',
                 icon: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h4"/>' },
  };
  const mins = m => duration(m);
  const mineAt = {};
  active.forEach(function (t) { if (!mineAt[t.department]) mineAt[t.department] = t; });
  const hr = new Date().getHours();
  const hello = hr < 12 ? 'Good morning' : hr < 18 ? 'Good afternoon' : 'Good evening';
%>
<%- include('../../partials/queue-welcome', {
      offices: offices, mineAt: mineAt,
      waitText: function (m, o) { return sameDay.early ? 'Line opens ' + sameDay.opensClock
        : o && o.beforeOpen ? 'Opens ' + o.openClock : (m == null ? 'Book a time' : duration(m, true) + ' wait'); }
    }) %>
<%- include('../../partials/public-nav') %>
<div data-live="home">

<% if (active.length) { %>
<section class="mb-6" aria-labelledby="mineTitle">
  <h2 id="mineTitle" class="text-[12px] font-bold uppercase tracking-wider text-slateSoft/70 mb-2">Your ticket<%= active.length > 1 ? 's' : '' %> on this phone</h2>
  <div class="grid gap-3 sm:grid-cols-2">
    <% active.forEach(function (t) { %>
    <a href="/queue/t/<%= t.accessToken %>" class="rise bg-hero text-white rounded-2xl shadow-lift flex items-center gap-4 px-5 py-4 hover:brightness-110 transition">
      <span class="font-mono text-[28px] font-extrabold whitespace-nowrap leading-none"><%= t.ticketNo %></span>
      <span class="min-w-0">
        <span class="block text-[14px] font-bold"><%= t.department %></span>
        <span class="block text-[12px] text-white/75"><%= t.visitDateText %> &middot; <%= label(t.ticketStatus) %></span>
      </span>
      <span class="ml-auto grid place-items-center w-9 h-9 rounded-full bg-white/15" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg>
      </span>
    </a>
    <% }) %>
  </div>
</section>
<% } %>

<div class="mb-5">
  <p class="text-[13px] font-semibold text-brand"><%= hello %> &#128075;</p>
  <h2 class="text-[26px] sm:text-[30px] font-extrabold tracking-tight leading-tight mt-0.5">What are your transactions today?</h2>
  <div class="mt-2.5 flex flex-wrap items-center gap-2 text-[12.5px]">
    <span class="inline-flex items-center gap-1.5 rounded-full bg-white ring-1 ring-hair px-3 py-1 font-medium text-slateSoft">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
      <%= officeHours %>
    </span>
    <span class="inline-flex items-center gap-1.5 rounded-full bg-white ring-1 ring-hair px-3 py-1 font-medium text-slateSoft">No account needed</span>
  </div>
</div>

<% if (!sameDay.open) { %>
<p class="mb-4 flex gap-2.5 rounded-xl bg-amber-50 ring-1 ring-inset ring-amber-200 px-4 py-3 text-[13px] text-amber-900">
  <span aria-hidden="true">&#9200;</span>
  <span>
  <% if (sameDay.early) { %>
  Today's line opens at <strong><%= sameDay.opensClock %></strong>, an hour before the office. You can book a time now.
  <% } else { %>
  <%= sameDay.why.replace(', so please pick a date.', '.').replace(', so please pick a working day.', '.') %>
  You can still book a number for a later date.
  <% } %>
  </span>
</p>
<% } %>

<div class="grid gap-4 sm:grid-cols-2">
  <% ['Cashier', 'Registrar'].forEach(function (off) { const o = offices[off]; const mine = mineAt[off]; %>
  <section class="rise <%= UI.card %> flex flex-col" aria-labelledby="off-<%= off %>">
    <div class="px-5 pt-5 flex items-start gap-3.5">
      <span class="grid place-items-center w-12 h-12 rounded-2xl bg-brand-wash text-brand shrink-0" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><%- about[off].icon %></svg>
      </span>
      <div class="min-w-0">
        <h3 id="off-<%= off %>" class="text-[19px] font-extrabold tracking-tight text-ink leading-tight"><%= off %></h3>
        <p class="text-[13px] font-medium text-slateSoft"><%= about[off].what %></p>
        <p class="text-[12px] text-slateSoft/60"><%= about[off].eg %></p>
      </div>
    </div>

    <%# the headline: how long if I join now, then the line itself %>
    <div class="mx-5 mt-4 rounded-2xl bg-mist px-4 py-3.5">
      <div class="text-[11px] font-semibold uppercase tracking-wider text-slateSoft/60">If you join now</div>
      <% if (o.minutes == null && sameDay.early) { %>
      <div class="text-[20px] font-extrabold text-brand-night leading-tight mt-0.5">Line opens at <%= sameDay.opensClock %></div>
      <div class="text-[12px] text-slateSoft/75">book a time now, or come back then</div>
      <% } else if (o.minutes == null) { %>
      <div class="text-[20px] font-extrabold text-brand-night mt-0.5">Book a time</div>
      <div class="text-[12px] text-slateSoft/75">the same-day line is closed</div>
      <% } else if (o.beforeOpen) { %>
      <div class="text-[20px] font-extrabold text-brand-night leading-tight mt-0.5">Opens at <%= o.openClock %></div>
      <div class="text-[12px] text-slateSoft/75"><%= o.waiting ? o.waiting + ' already in line' : "you'd be among the first" %></div>
      <% } else { %>
      <div class="text-[22px] font-extrabold text-brand-night leading-tight mt-0.5"><%= mins(o.minutes).replace('about ', '~') %></div>
      <div class="text-[12px] text-slateSoft/75">your turn around <strong class="text-ink"><%= o.startClock %></strong><%= o.closed ? ' (once a window opens)' : '' %></div>
      <% if (breakEnds) { %><div class="mt-1 text-[12px] font-medium text-amber-700">&#9749; Break time: the windows call again at <%= breakEnds %></div><% } %>
      <% } %>

      <div class="mt-3 pt-3 border-t border-hair flex flex-wrap items-center gap-x-4 gap-y-1 text-[12px] text-slateSoft">
        <span><strong class="font-mono text-[15px] text-ink"><%= o.waiting %></strong> waiting</span>
        <% if (o.serving) { %><span><strong class="font-mono text-[15px] text-ink"><%= o.serving %></strong> at a window</span><% } %>
        <% if (o.served) { %><span><strong class="font-mono text-[15px] text-ink"><%= o.served %></strong> served</span><% } %>
        <% if (o.avgWait) { %><span class="basis-full text-[11.5px] text-slateSoft/70">Today's real average wait: <strong><%= duration(o.avgWait.minutes).replace('about ', '') %></strong> (<%= o.avgWait.served %> served)</span><% } %>
      </div>
    </div>

    <% if (o.minutes != null && !o.fits) { %>
    <p class="mx-5 mt-3 rounded-xl bg-amber-50 ring-1 ring-inset ring-amber-200 px-3 py-2 text-[12px] text-amber-900">
      &#9888;&#65039; The line is long: if you join now you may not be served before closing. Consider booking a time tomorrow.
    </p>
    <% } %>

    <% if (o.nowServing.length) { %>
    <div class="mx-5 mt-3 flex flex-wrap items-center gap-1.5 text-[12px] text-slateSoft/80">
      <span class="relative flex w-2 h-2 mr-0.5" aria-hidden="true"><span class="absolute inset-0 rounded-full bg-emerald-500 animate-ping opacity-60"></span><span class="relative w-2 h-2 rounded-full bg-emerald-500"></span></span>
      Now serving
      <% o.nowServing.forEach(function (w) { %>
      <span class="<%= chip %>"><%= w.ticket %></span><span class="text-slateSoft/55"><%= w.label %></span>
      <% }) %>
    </div>
    <% } %>

    <div class="mt-auto p-5">
      <% if (mine) { %>
      <a href="/queue/t/<%= mine.accessToken %>" class="<%= UI.btn %> <%= UI.btnGh %> w-full py-3.5">You have <%= mine.ticketNo %> here &rarr;</a>
      <% } else { %>
      <a href="/queue/new?office=<%= off %>" class="<%= UI.btn %> <%= UI.btnMain %> w-full py-3.5 text-[14.5px]">Get a <%= off %> number
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      <% } %>
    </div>
  </section>
  <% }) %>
</div>

<p class="mt-5 text-[12px] text-slateSoft/60 text-center">
  Wait times are predicted from today's pace and past days. They update by themselves.
</p>

<% if (past.length) { %>
<section class="mt-7">
  <h2 class="text-[12px] font-bold uppercase tracking-wider text-slateSoft/70 mb-2">Recent on this phone</h2>
  <ul class="<%= UI.card %> divide-y divide-hair/70">
    <% past.forEach(function (t) { %>
    <li><a href="/queue/t/<%= t.accessToken %>" class="flex items-center gap-3 px-4 py-3 text-[13px] hover:bg-brand-wash/40">
      <span class="font-mono font-bold"><%= t.ticketNo %></span>
      <span class="text-slateSoft/80"><%= t.department %> &middot; <%= t.visitDateText %></span>
      <span class="ml-auto <%= pill %> <%= tone(t.ticketStatus) %>"><%= t.ticketStatus %></span>
    </a></li>
    <% }) %>
  </ul>
</section>
<% } %>

</div>
<%- include('../../partials/live', { liveEvery: 20 }) %>
<%- include('../../partials/foot') %>
<%- include('../../partials/scripts') %>
