<%- include('../../partials/head') %>
<%- include('../../partials/public-nav') %>
<%# Styles first, so step ticks and document checks never flash unstyled on a slow phone. %>
<style>
  /* office cards */
  .office-card{ position:relative; display:block; cursor:pointer; border:2px solid #E3E7ED; border-radius:18px; padding:14px 16px; background:#fff;
                transition:border-color .25s, background-color .25s, box-shadow .25s, transform .25s cubic-bezier(.34,1.56,.64,1) }
  .office-card:hover{ border-color:#C9E0F4 }
  .office-card:active{ transform:scale(.98) }
  .office-card:has(input:checked){ border-color:#2185D5; background:#F4F9FE; transform:translateY(-2px);
                                   box-shadow:0 0 0 4px rgba(33,133,213,.10), 0 10px 22px -10px rgba(33,133,213,.55) }
  .office-card:has(input:focus-visible){ outline:2px solid #2185D5; outline-offset:2px }
  .office-card.is-busy{ cursor:not-allowed; opacity:.55; background:#F5F7FA }
  .office-badge{ position:absolute; top:12px; right:12px; width:24px; height:24px; border-radius:50%; display:grid; place-items:center;
                 background:#2185D5; transform:scale(0); transition:transform .3s cubic-bezier(.34,1.56,.64,1) }
  .office-badge svg{ fill:none; stroke:#fff; stroke-width:3.2; stroke-linecap:round; stroke-linejoin:round }
  .office-card:has(input:checked) .office-badge{ transform:scale(1) }
  /* the documents open, then their cards arrive one by one */
  .docs-in{ animation:open .35s cubic-bezier(.2,.8,.2,1) both }
  #docSection.docs-in .doc-row:not([hidden]){ animation:row-in .4s cubic-bezier(.2,.8,.2,1) both; animation-delay:calc(.08s + var(--i, 0) * 45ms) }
  @keyframes row-in{ from{ opacity:0; transform:translateY(10px) scale(.98) } to{ opacity:1; transform:none } }
  @media (prefers-reduced-motion:reduce){ .docs-in, #docSection.docs-in .doc-row{ animation:none !important } .office-card, .office-badge{ transition:none } }
  /* document cards */
  .doc-row{ border:2px solid #E3E7ED; border-radius:18px; padding:14px 16px; background:#fff;
            transition:border-color .2s, background-color .2s, box-shadow .2s, transform .15s }
  .doc-row:hover{ border-color:#C9E0F4 }
  .doc-row.is-picked{ border-color:#2185D5; background:#F4F9FE; box-shadow:0 0 0 4px rgba(33,133,213,.10), 0 6px 18px -8px rgba(33,133,213,.45) }
  .doc-head{ display:flex; align-items:center; gap:12px; cursor:pointer }
  .doc-head:active{ transform:scale(.99) }
  .doc-check{ flex:none; width:26px; height:26px; border-radius:50%; border:2px solid #C7CED6; display:grid; place-items:center;
              background:#fff; transition:background .2s, border-color .2s, transform .25s cubic-bezier(.34,1.56,.64,1) }
  .doc-check svg{ width:15px; height:15px; fill:none; stroke:#fff; stroke-width:3.2; stroke-linecap:round; stroke-linejoin:round;
                  stroke-dasharray:24; stroke-dashoffset:24; transition:stroke-dashoffset .3s ease-out .05s }
  .doc-row.is-picked .doc-check{ background:#2185D5; border-color:#2185D5; transform:scale(1.08) }
  .doc-row.is-picked .doc-check svg{ stroke-dashoffset:0 }
  .doc-head input:focus-visible + .doc-check{ outline:2px solid #2185D5; outline-offset:2px }
  .doc-head input:disabled ~ *{ opacity:.45 }
  .doc-price{ flex:none; font:700 12.5px/1 'JetBrains Mono',monospace; padding:6px 9px; border-radius:999px; background:#F5F7FA; color:#4A5866 }
  .doc-row.is-picked .doc-price{ background:#2185D5; color:#fff }
  .doc-qty{ display:flex; align-items:center; gap:10px; margin:12px 0 0 38px; animation:open .25s ease-out }
  .stepper{ display:flex; align-items:center; border:1.5px solid #E3E7ED; border-radius:12px; background:#fff; overflow:hidden }
  .stepper button{ width:34px; height:34px; font-size:18px; font-weight:700; color:#2185D5 }
  .stepper button:hover{ background:#EAF3FB }
  .stepper input{ width:38px; text-align:center; font:700 14px 'JetBrains Mono',monospace; border:0; outline:none; -moz-appearance:textfield }
  .stepper input::-webkit-inner-spin-button, .stepper input::-webkit-outer-spin-button{ -webkit-appearance:none; margin:0 }
  /* the purpose, inside the document that asks for it */
  .purpose-box{ margin:12px 0 0 38px; padding:12px 14px; border-radius:14px; background:#fff; border:1.5px dashed #C9E0F4; animation:open .3s ease-out }
  .purpose-chips{ display:flex; flex-wrap:wrap; gap:8px; margin-top:10px }
  .purpose-chips button{ padding:8px 13px; border-radius:999px; font-size:12.5px; font-weight:600; color:#1E2A36;
                         background:#F5F7FA; border:1.5px solid #E3E7ED; transition:all .15s }
  .purpose-chips button:hover{ border-color:#2185D5; color:#1A6CAE }
  .purpose-chips button[aria-checked="true"]{ background:#2185D5; border-color:#2185D5; color:#fff; box-shadow:0 6px 14px -6px rgba(33,133,213,.7) }
  @keyframes open{ from{ opacity:0; transform:translateY(-6px) } to{ opacity:1; transform:none } }
  @media (max-width:480px){ .doc-qty, .purpose-box{ margin-left:0 } }
  @media (prefers-reduced-motion:reduce){ .doc-qty, .purpose-box{ animation:none } .doc-check, .doc-check svg{ transition:none } }
  /* "hidden" must win over layout classes such as flex (the Copies box). */
  form [hidden]{ display:none !important }
  /* the line between steps fills from left to right as you move on */
  .wiz-line{ position:absolute; top:22px; right:50%; width:100%; height:4px; border-radius:4px;
             background:linear-gradient(#2185D5,#2185D5) left/0% 100% no-repeat #DFE2E6;
             transition:background-size .5s cubic-bezier(.4,0,.2,1) }
  .wiz-dot{ position:relative; z-index:1; width:46px; height:46px; border-radius:50%;
            display:grid; place-items:center; font-weight:800; font-size:17px;
            background:#fff; color:#9AA3AB; border:3px solid #DFE2E6;
            transition:background .3s, color .3s, border-color .3s, transform .3s, box-shadow .3s }
  .wiz-dot:disabled{ cursor:not-allowed }
  .wiz-tick{ width:22px; height:22px; display:none }
  .wiz-label{ margin-top:6px; text-align:center; font-size:11px; line-height:1.25; color:#9AA3AB }
  .wiz-label b{ font-weight:700 }

  /* finished: filled blue with a tick, clickable */
  .wiz-item.is-done .wiz-dot{ background:#2185D5; border-color:#2185D5; color:#fff; cursor:pointer }
  .wiz-item.is-done .wiz-dot:hover{ transform:scale(1.07) }
  .wiz-item.is-done .wiz-num{ display:none }
  .wiz-item.is-done .wiz-tick{ display:block }
  /* the tick draws itself in */
  .wiz-item.is-done .wiz-tick path{ stroke-dasharray:24; stroke-dashoffset:24; animation:wiz-draw .45s ease-out .1s forwards }
  @keyframes wiz-draw{ to{ stroke-dashoffset:0 } }
  .wiz-item.is-done .wiz-label{ color:#303841 }
  .wiz-item.is-done .wiz-line,
  .wiz-item.is-current .wiz-line{ background-size:100% 100% }

  /* current: larger, glowing */
  .wiz-item.is-current .wiz-dot{ background:#2185D5; border-color:#fff; color:#fff; transform:scale(1.18);
                                 box-shadow:0 0 0 4px rgba(33,133,213,.25), 0 6px 18px rgba(33,133,213,.45);
                                 animation:wiz-glow 2s ease-in-out infinite }
  .wiz-item.is-current .wiz-label{ color:#2185D5 }
  @keyframes wiz-glow{
    0%,100%{ box-shadow:0 0 0 4px rgba(33,133,213,.25), 0 6px 18px rgba(33,133,213,.45) }
    50%    { box-shadow:0 0 0 9px rgba(33,133,213,.12), 0 6px 22px rgba(33,133,213,.55) }
  }
  /* steps slide in from the side you are heading to; their cards follow one by one */
  .wiz-pane{ animation:wiz-in .3s ease-out }
  .wiz-pane.wiz-fwd{ animation:wiz-fwd .42s cubic-bezier(.2,.8,.2,1) }
  .wiz-pane.wiz-back{ animation:wiz-back .42s cubic-bezier(.2,.8,.2,1) }
  .wiz-pane.wiz-fwd > *, .wiz-pane.wiz-back > *{ animation:wiz-in .45s cubic-bezier(.2,.8,.2,1) both }
  .wiz-pane > *:nth-child(2){ animation-delay:.06s } .wiz-pane > *:nth-child(3){ animation-delay:.12s }
  .wiz-pane > *:nth-child(4){ animation-delay:.18s } .wiz-pane > *:nth-child(5){ animation-delay:.24s }
  @keyframes wiz-in{ from{ opacity:0; transform:translateY(12px) } to{ opacity:1; transform:none } }
  @keyframes wiz-fwd{ from{ opacity:0; transform:translateX(36px) } to{ opacity:1; transform:none } }
  @keyframes wiz-back{ from{ opacity:0; transform:translateX(-36px) } to{ opacity:1; transform:none } }
  @media (min-width:640px){ .wiz-label{ font-size:12px } .wiz-dot{ width:50px; height:50px } .wiz-line{ top:24px } }
  @media (prefers-reduced-motion:reduce){ .wiz-item.is-current .wiz-dot, .wiz-pane, .wiz-pane > *{ animation:none !important }
    .wiz-item.is-done .wiz-tick path{ animation:none; stroke-dashoffset:0 } }
</style>

<div>
  <div class="mb-5">
    <h2 class="text-xl font-extrabold">Get a queue number</h2>
    <p class="text-[13px] text-slateSoft/80 mt-0.5">No account needed. The amount is set by the office.</p>
  </div>

  <% if (formError) { %>
  <div role="alert" class="mb-4 rounded-lg bg-red-50 border-l-4 border-red-600 px-4 py-3 text-[13px] font-medium text-red-900"><%= formError %></div>
  <% } %>

  <form method="POST" action="/queue/new" enctype="multipart/form-data" data-once class="space-y-4">
    <input type="hidden" name="submitToken" value="<%= submitToken %>">

    <%# Stepper: one step shown at a time. Finished steps can be revisited;
        later steps unlock only after the current one passes its checks. %>
    <nav aria-label="Request steps" class="mb-5">
      <ol class="wiz-bar flex items-start">
        <% var stepIcons = {
             '1': '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h4"/>',
             '2': '<rect x="3.5" y="5" width="17" height="15.5" rx="2.5"/><path d="M3.5 10h17M8 3v4M16 3v4"/>',
             '3': '<circle cx="12" cy="8" r="4"/><path d="M4.5 20.5a7.5 7.5 0 0 1 15 0"/>',
             '4': '<path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><path d="m9 14 2 2 4-4"/>' }; %>
        <% [['1','Office & Docs'],['2','When'],['3','Your details'],['4','Review']].forEach(function (st, i) { %>
        <li class="wiz-item flex-1 flex flex-col items-center relative" data-step-item="<%= st[0] %>">
          <% if (i > 0) { %><span class="wiz-line" aria-hidden="true"></span><% } %>
          <button type="button" class="wiz-dot" data-goto="<%= st[0] %>" aria-label="Step <%= st[0] %>: <%= st[1] %>">
            <svg class="wiz-num" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- stepIcons[st[0]] %></svg>
            <svg class="wiz-tick" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <span class="wiz-label">Step <%= st[0] %><br><b><%= st[1] %></b></span>
        </li>
        <% }) %>
      </ol>
    </nav>

    <!-- STEP 1 of 4: office and documents -->
    <div class="wiz-pane space-y-4" data-pane="1">
      <!-- which office -->
      <%# Chosen already on the queue page: show it, with a way to change it,
          instead of asking again. The radios stay in the form either way. %>
      <% const preset = form.office && !activeBy[form.office] ? form.office : null; %>
      <section class="<%= UI.card %> step">
        <% if (preset) { %>
        <div class="px-5 py-3.5 flex items-center gap-3" data-office-summary>
          <span class="text-[12.5px] text-slateSoft/80">Office</span>
          <span class="text-[15px] font-extrabold text-brand-deep"><%= preset %></span>
          <button type="button" class="ml-auto text-[12.5px] font-semibold text-brand underline" onclick="changeOffice()">Change</button>
        </div>
        <% } %>
        <div class="<%= UI.cardHd %>" <%= preset ? 'hidden' : '' %> data-office-choice><h3 class="<%= UI.cardTtl %>">Which office?</h3></div>
        <div class="<%= UI.body %>" <%= preset ? 'hidden' : '' %> data-office-choice>
          <fieldset>
            <legend class="sr-only">Office</legend>
            <div class="grid sm:grid-cols-2 gap-2.5">
              <% ['Cashier','Registrar'].forEach(function(off){ %>
              <% const busy = !!activeBy[off]; %>
              <label class="office-card <%= busy ? 'is-busy' : '' %>">
                <input type="radio" name="office" value="<%= off %>" class="sr-only"
                       <%= busy ? 'disabled' : '' %>
                       <%= form.office === off ? 'checked' : '' %> onchange="pickOffice()">
                <span class="office-badge" aria-hidden="true"><svg width="13" height="13" viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span>
                <div class="text-[14px] font-bold"><%= off %></div>
                <div class="text-[12px] text-slateSoft/80 mt-0.5">
                  <% if (busy) { %>You already have <%= activeBy[off].ticketNo %> here (on this phone)
                  <% } else { %><%= off === 'Cashier' ? 'Documents you pay for' : 'Free requests and claiming' %><% } %>
                </div>
              </label>
              <% }) %>
            </div>
          </fieldset>
          <p class="<%= UI.hint %>">One ticket covers one office. Choose the office first, then the documents.</p>
        </div>
      </section>

      <!-- documents -->
      <section class="<%= UI.card %> step" id="docSection" hidden>
        <div class="<%= UI.cardHd %>">
          <h3 class="<%= UI.cardTtl %>">Which documents?</h3>
          <span id="pickCount" class="text-[11.5px] font-semibold text-slateSoft/80">0 of <%= settings.maxBatchDocuments %> selected</span>
        </div>
        <div class="<%= UI.body %>">
          <fieldset>
            <legend class="sr-only">Requested documents</legend>
            <div class="grid gap-2" id="docList" data-max="<%= settings.maxBatchDocuments %>">
              <% documents.forEach(function(sv){ %>
              <%# A Registrar document that collects something paid for at the Cashier.
                  The paid documents are found from the student number when the
                  ticket is made (the Registrar checks the ID before releasing). %>
              <% const isClaim = sv.office === 'Registrar' && sv.requiresClaim;
                 const picked = [].concat(form.documentIds || []).map(String).includes(String(sv.id)); %>
              <%# Highlighted from its own checkbox only (recalc sets .is-picked): a
                  plain :has(:checked) also matched the purpose list's selected
                  option, so an unticked OTR stayed blue. %>
              <div class="doc-row" data-office="<%= sv.office %>" hidden>
                <label class="doc-head">
                  <input type="checkbox" name="documentIds" value="<%= sv.id %>" <%= picked ? 'checked' : '' %>
                         data-price="<%= sv.price %>" data-office="<%= sv.office %>" data-row="<%= sv.id %>"
                         data-purpose="<%= sv.needsPurpose ? 1 : 0 %>" data-guest="<%= sv.guestAllowed ? 1 : 0 %>"
                         <%= isClaim ? 'data-claim=1' : '' %>
                         class="sr-only" onchange="recalc()">
                  <span class="doc-check" aria-hidden="true"><svg width="15" height="15" viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span>
                  <span class="min-w-0 flex-1">
                    <span class="block text-[14px] font-semibold leading-tight"><%= sv.name %></span>
                    <span class="block text-[11.5px] text-slateSoft/70 mt-0.5"><%= sv.paymentRequired ? peso(sv.price) + ' each' : 'No payment' %><%= sv.needsPurpose ? ' · asks for a purpose' : '' %><%= sv.processingDays ? ' · ready ' + sv.processingDays + ' days after payment' : '' %></span>
                  </span>
                  <span class="doc-price"><%= sv.paymentRequired ? peso(sv.price).replace('.00', '') : 'Free' %></span>
                </label>
                <%# copies: a − / + stepper; the number field is what is submitted %>
                <div class="doc-qty" id="qty-<%= sv.id %>" hidden>
                  <span class="text-[12px] font-semibold text-slateSoft">Copies</span>
                  <div class="stepper">
                    <button type="button" aria-label="One copy less" onclick="stepCopies(<%= sv.id %>, -1)">&minus;</button>
                    <input id="copies-<%= sv.id %>" type="number" name="copies" value="1" min="1" inputmode="numeric"
                           max="<%= settings.maxCopies %>" data-copies="<%= sv.id %>" disabled aria-label="Copies of <%= sv.name %>"
                           onchange="recalc()" oninput="recalc()">
                    <button type="button" aria-label="One copy more" onclick="stepCopies(<%= sv.id %>, 1)">+</button>
                  </div>
                  <span class="ml-auto text-[12px] text-slateSoft/70" data-line-total="<%= sv.id %>"></span>
                </div>
                <% if (sv.needsPurpose) { %><div data-purpose-slot="<%= sv.id %>"></div><% } %>
                <% if (isClaim) { %>
                <p class="mt-2 ml-10 text-[12px] text-slateSoft/80" data-claim-panel="<%= sv.id %>" hidden>
                  We will find the documents you already paid for at the Cashier using your student number.
                </p>
                <% } %>
                <% if (!sv.guestAllowed) { %>
                <p class="mt-1 ml-10 text-[11px] text-slateSoft/60">For enrolled students only</p>
                <% } %>
                <% if (sv.needsRequirements && (requirements[sv.id] || []).length) { %>
                <details class="mt-2 ml-10">
                  <summary class="cursor-pointer text-[11.5px] font-semibold text-brand"><%= sv.office === 'Cashier' ? 'What to bring to the Registrar when you claim it' : 'What you need to bring' %></summary>
                  <ul class="mt-1.5 space-y-1">
                    <% requirements[sv.id].forEach(function(r){ %>
                    <li class="text-[11.5px] text-slateSoft/85 flex gap-2">
                      <span class="text-brand">&bull;</span>
                      <span><%= r.label %><% if (r.note) { %> <span class="text-slateSoft/60">&mdash; <%= r.note %></span><% } %>
                      <% if (!r.isRequired) { %> <span class="text-slateSoft/60">(optional)</span><% } %></span>
                    </li>
                    <% }) %>
                  </ul>
                </details>
                <% } %>
              </div>
              <% }) %>
            </div>
            <p id="noDocs" class="text-[13px] text-slateSoft/70" hidden>No documents are available for this office.</p>
          </fieldset>

          <div class="mt-4 rounded-2xl bg-hero text-white shadow-lift px-5 py-4 flex items-center justify-between">
            <div>
              <div class="text-[11px] uppercase tracking-wider text-white/70">Amount due</div>
              <div class="text-[11.5px] text-white/70" id="destLabel">Select a document to continue</div>
            </div>
            <div class="text-2xl font-extrabold font-mono" id="amountDue">₱0.00</div>
          </div>
        </div>
      </section>


      <%# Purpose belongs to the document that asks for it (e.g. the OTR), so it
          sits inside that document's box (moved there by recalc), never at the
          bottom where it would look like every document needs one. %>
      <div id="purposeSection" class="purpose-box" hidden>
          <div class="flex items-center gap-2 text-[13px] font-bold text-ink">
            <span class="grid place-items-center w-7 h-7 rounded-lg bg-brand text-white" aria-hidden="true">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4.5"/><circle cx="12" cy="12" r=".6"/></svg>
            </span>
            What is it for? <span class="font-normal text-slateSoft/60">required</span>
          </div>
          <div class="purpose-chips" role="radiogroup" aria-label="Purpose of this document">
            <% purposes.forEach(function(p){ %>
            <button type="button" role="radio" data-purpose-chip="<%= p %>" aria-checked="<%= form.purpose === p ? 'true' : 'false' %>"><%= p %></button>
            <% }) %>
          </div>
          <label for="purpose" class="sr-only">Purpose of this document</label>
          <select id="purpose" name="purpose" hidden onchange="toggleOther()">
            <option value="">Select purpose</option>
            <% purposes.forEach(function(p){ %>
            <option value="<%= p %>" <%= form.purpose === p ? 'selected' : '' %>><%= p %></option>
            <% }) %>
          </select>
          <div id="otherBox" class="hidden mt-3 fade-in">
            <label for="otherPurpose" class="<%= UI.lbl %>">Please specify purpose *</label>
            <input id="otherPurpose" name="otherPurpose" class="<%= UI.input %>" value="<%= form.otherPurpose || '' %>">
          </div>
      </div>

      <p class="wiz-error hidden rounded-lg bg-red-50 border-l-4 border-red-600 px-4 py-2.5 text-[13px] font-medium text-red-900" role="alert"></p>
      <div class="flex flex-wrap items-center gap-2.5">
        <a href="/queue" class="<%= UI.btn %> <%= UI.btnGh %>">Cancel</a>
        <button type="button" class="<%= UI.btn %> <%= UI.btnMain %> px-6 ml-auto" data-next>Next &rarr;</button>
      </div>
    </div>

    <!-- STEP 2 of 4: when -->
    <div class="wiz-pane space-y-4" data-pane="2" hidden>
      <!-- when -->
      <section class="<%= UI.card %> step">
        <div class="<%= UI.cardHd %>"><h3 class="<%= UI.cardTtl %>">When do you need this?</h3></div>
        <div class="<%= UI.body %>">
          <fieldset>
            <legend class="sr-only">Choose when</legend>
            <div class="grid sm:grid-cols-2 gap-2.5">
              <%# "Request now" is greyed out outside office hours, on closed days, or
                  when same-day requests are switched off (the server checks too). %>
              <% if (settings.allowSameDay) { %>
              <label class="rounded-2xl border-2 transition has-[:checked]:shadow-card px-4 py-3.5 border-hair <%= sameDay.open ? 'cursor-pointer has-[:checked]:border-brand has-[:checked]:bg-brand-wash has-[:checked]:ring-4 has-[:checked]:ring-brand/10' : 'cursor-not-allowed bg-mist/60 opacity-60' %>">
                <input type="radio" name="mode" value="now" class="sr-only" <%= sameDay.open ? '' : 'disabled' %>
                       <%= sameDay.open && form.mode !== 'schedule' ? 'checked' : '' %> onchange="toggleMode()">
                <div class="text-[14px] font-bold">Join the line now</div>
                <div class="text-[12px] text-slateSoft/80 mt-0.5"><%= sameDay.open ? "Even from class: your place starts now, and we alert you when to come" : 'Not available right now' %></div>
              </label>
              <% } %>
              <label class="rounded-2xl border-2 transition has-[:checked]:shadow-card px-4 py-3.5 cursor-pointer border-hair has-[:checked]:border-brand has-[:checked]:bg-brand-wash has-[:checked]:ring-4 has-[:checked]:ring-brand/10">
                <input type="radio" name="mode" value="schedule" class="sr-only"
                       <%= (!sameDay.open || form.mode === 'schedule') ? 'checked' : '' %> onchange="toggleMode()">
                <div class="text-[14px] font-bold">Book a time</div>
                <div class="text-[12px] text-slateSoft/80 mt-0.5">Pick a day and a 30-minute slot, up to <%= settings.scheduleMaxDays %> days ahead</div>
              </label>
            </div>
          </fieldset>
          <div id="scheduleBox" class="hidden mt-3.5">
            <label for="scheduledDate" class="<%= UI.lbl %>">Date of your visit</label>
            <input id="scheduledDate" name="scheduledDate" type="date" onchange="loadSlots()" class="<%= UI.input %> max-w-xs"
                   value="<%= form.scheduledDate || '' %>" min="<%= sameDay.open ? today : firstBookable %>" max="<%= maxDate %>">
            <span class="<%= UI.hint %>">
              Any open day from <%= sameDay.open ? today : firstBookable %> up to <%= maxDate %>.
            </span>

            <%# 30-minute slots for that date (data/engine.js slotPlan). Half of each
                slot can be booked; the rest is kept for students who join that day. %>
            <fieldset id="slotBox" class="mt-4" hidden data-picked="<%= form.slot || '' %>">
              <legend class="<%= UI.lbl %>">Time of your visit *</legend>
              <p class="text-[12px] text-slateSoft/80 -mt-1 mb-2" data-slot-note></p>
              <div class="grid grid-cols-2 sm:grid-cols-3 gap-2" data-slot-list></div>
            </fieldset>
          </div>
          <% if (!sameDay.open) { %>
          <p class="mt-3 rounded-lg bg-amber-50 border border-amber-200 px-3.5 py-2.5 text-[12.5px] text-amber-900">
            <%= sameDay.why %>
          </p>
          <% } %>

          <%# Quiet-hour advice. Informational only — the student may still come
              whenever they like; this only says when the line is usually shorter.
              All seven weekdays are embedded so the text follows the date they
              pick without another request to the server. %>
          <% var advWeek = { Cashier: peakAdvice.Cashier, Registrar: peakAdvice.Registrar };
             var anyAdvice = advWeek.Cashier.some(Boolean) || advWeek.Registrar.some(Boolean); %>
          <% if (anyAdvice) { %>
          <div id="peakAdvice" class="mt-3.5 rounded-lg bg-brand-wash border border-brand-line px-3.5 py-3"
               <%# The escaping output tag already makes the quotes attribute-safe.
                   Escaping them by hand first would double-escape the string and
                   break JSON.parse in the browser. %>
               data-advice="<%= JSON.stringify(advWeek) %>"
               data-today="<%= new Date().getDay() %>">
            <div class="text-[12px] font-bold text-brand-deep mb-1.5">
              Best time to come <span data-peak-day></span>
            </div>
            <ul data-peak-list class="space-y-1"></ul>
            <span class="<%= UI.hint %>" data-peak-note></span>
          </div>
          <script>
          (function () {
            var box = document.getElementById('peakAdvice');
            if (!box) return;
            var week  = JSON.parse(box.dataset.advice);
            var today = parseInt(box.dataset.today, 10);
            var days  = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
            var dayEl  = box.querySelector('[data-peak-day]');
            var listEl = box.querySelector('[data-peak-list]');
            var noteEl = box.querySelector('[data-peak-note]');

            function paint(dow, isFuture) {
              var rows = [];
              ['Cashier', 'Registrar'].forEach(function (office) {
                var a = week[office] && week[office][dow];
                if (a) rows.push({ office: office, a: a });
              });
              if (!rows.length) { box.classList.add('hidden'); return; }
              box.classList.remove('hidden');

              dayEl.textContent = isFuture ? 'on ' + days[dow] : 'today (' + days[dow] + ')';

              listEl.innerHTML = '';
              var provisional = false;
              rows.forEach(function (r) {
                if (r.a.provisional) provisional = true;
                var li = document.createElement('li');
                li.className = 'text-[12.5px] text-slateSoft';
                var quiet = r.a.quietest
                  ? ', usually shorter around <strong>' + r.a.quietest.label + '</strong>'
                  : '';
                li.innerHTML = '<strong>' + r.office + ':</strong> busiest around <strong>'
                             + r.a.busiest.label + '</strong>' + quiet + '.';
                listEl.appendChild(li);
              });

              noteEl.textContent = provisional
                ? 'There are not many ' + days[dow] + 's on record yet, so this is a rough guide '
                  + 'from all days combined. You may come at any open hour.'
                : 'Based on past ' + days[dow] + 's. You are free to come at any open hour — '
                  + 'this is only a guide.';
            }

            // Which day is the student actually asking about?
            function currentDow() {
              var sched = document.querySelector('input[name=mode][value=schedule]');
              var date  = document.getElementById('scheduledDate');
              if (sched && sched.checked && date && date.value) {
                var d = new Date(date.value + 'T00:00:00');
                if (!isNaN(d)) return { dow: d.getDay(), future: true };
              }
              return { dow: today, future: false };
            }

            function refresh() { var c = currentDow(); paint(c.dow, c.future); }

            document.querySelectorAll('input[name=mode]').forEach(function (r) {
              r.addEventListener('change', refresh);
            });
            var dateInput = document.getElementById('scheduledDate');
            if (dateInput) dateInput.addEventListener('change', refresh);
            refresh();
          })();
          </script>
          <% } %>
        </div>
      </section>

      <p class="wiz-error hidden rounded-lg bg-red-50 border-l-4 border-red-600 px-4 py-2.5 text-[13px] font-medium text-red-900" role="alert"></p>
      <div class="flex flex-wrap items-center gap-2.5">
        <button type="button" class="<%= UI.btn %> <%= UI.btnGh %>" data-back>&larr; Back</button>
        <button type="button" class="<%= UI.btn %> <%= UI.btnMain %> px-6 ml-auto" data-next>Next &rarr;</button>
      </div>
    </div>

    <!-- STEP 3 of 4: your details -->
    <div class="wiz-pane space-y-4" data-pane="3" hidden>
      <!-- student info -->
      <section class="<%= UI.card %> step">
        <div class="<%= UI.cardHd %>"><h3 class="<%= UI.cardTtl %>">Your information</h3></div>
        <div class="<%= UI.body %>">
          <fieldset class="mb-4">
            <legend class="sr-only">Are you a student?</legend>
            <div class="grid grid-cols-2 gap-2.5">
              <label class="rounded-2xl border-2 transition has-[:checked]:shadow-card px-4 py-3 cursor-pointer border-hair has-[:checked]:border-brand has-[:checked]:bg-brand-wash has-[:checked]:ring-4 has-[:checked]:ring-brand/10">
                <input type="radio" name="clientType" value="student" class="sr-only"
                       <%= form.clientType !== 'guest' ? 'checked' : '' %> onchange="toggleClient()">
                <div class="text-[14px] font-bold">I am a student</div>
                <div class="text-[12px] text-slateSoft/80 mt-0.5">Enrolled or former LICOM student</div>
              </label>
              <label class="rounded-2xl border-2 transition has-[:checked]:shadow-card px-4 py-3 cursor-pointer border-hair has-[:checked]:border-brand has-[:checked]:bg-brand-wash has-[:checked]:ring-4 has-[:checked]:ring-brand/10">
                <input type="radio" name="clientType" value="guest" class="sr-only"
                       <%= form.clientType === 'guest' ? 'checked' : '' %> onchange="toggleClient()">
                <div class="text-[14px] font-bold">I am a visitor</div>
                <div class="text-[12px] text-slateSoft/80 mt-0.5">Parent, applicant or other client</div>
              </label>
            </div>
          </fieldset>
          <%- include('../../partials/name-fields', { nf: {
                firstName: form.firstName || '', middleName: form.middleName || '',
                lastName: form.lastName || '',
                lblClass: UI.lbl, inputClass: UI.input
              } }) %>
          <div id="studentNoBox" class="mt-3 grid sm:grid-cols-3 gap-3">
            <div>
            <label for="studentNo" class="<%= UI.lbl %>">Student number *</label>
            <input id="studentNo" name="studentNo" class="<%= UI.input %> font-mono" value="<%= form.studentNo || '' %>"
                   inputmode="numeric" pattern="\d{9}" maxlength="9" autocomplete="off" placeholder="9 digits"
                   title="Your 9-digit student number, numbers only">
            <span class="<%= UI.hint %>">Used to find your records and the documents you paid for.</span>
            </div>
            <div>
              <label for="course" class="<%= UI.lbl %>">Course *</label>
              <select id="course" name="course" class="<%= UI.input %>">
                <option value="">Select</option>
                <% courses.forEach(function (c) { %>
                <option value="<%= c %>" <%= form.course === c ? 'selected' : '' %>><%= c %></option>
                <% }) %>
              </select>
            </div>
            <div>
              <label for="yearLevel" class="<%= UI.lbl %>">Year level *</label>
              <select id="yearLevel" name="yearLevel" class="<%= UI.input %>">
                <option value="">Select</option>
                <% [1, 2, 3, 4, 5].forEach(function (y) { %>
                <option value="<%= y %>" <%= String(form.yearLevel) === String(y) ? 'selected' : '' %>>Year <%= y %></option>
                <% }) %>
              </select>
            </div>
          </div>
        </div>
      </section>

      <!-- priority lane: declared here, the ID is checked at the window -->
      <section class="<%= UI.card %> step">
        <div class="<%= UI.cardHd %>"><h3 class="<%= UI.cardTtl %>">Priority lane</h3></div>
        <div class="<%= UI.body %>">
          <fieldset>
            <legend class="text-[13px] text-slateSoft mb-2.5">PWD, Senior Citizen and pregnant clients are called ahead of the regular lane.</legend>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
              <% [['', 'No, regular'], ['pwd', priorityLabels.pwd], ['senior', priorityLabels.senior], ['pregnant', priorityLabels.pregnant]].forEach(function (p) { %>
              <label class="rounded-2xl border-2 transition has-[:checked]:shadow-card px-3 py-2.5 text-center cursor-pointer border-hair has-[:checked]:border-brand has-[:checked]:bg-brand-wash has-[:checked]:ring-4 has-[:checked]:ring-brand/10">
                <input type="radio" name="priorityType" value="<%= p[0] %>" class="sr-only"
                       <%= (form.priorityType || '') === p[0] ? 'checked' : '' %> onchange="toggleProof()">
                <span class="text-[13px] font-bold"><%= p[1] %></span>
              </label>
              <% }) %>
            </div>
          </fieldset>
          <div id="proofBox" class="mt-3 rounded-lg bg-violet-50 border border-violet-200 px-3.5 py-3" hidden>
            <label for="proof" class="block text-[12.5px] font-bold text-violet-900 mb-1.5">
              Photo of your proof * <span class="font-normal" data-proof-what></span>
            </label>
            <input id="proof" name="proof" type="file" accept="image/jpeg,image/png,application/pdf"
                   class="block w-full text-[12.5px] text-violet-900 file:mr-3 file:rounded-lg file:border-0 file:bg-violet-700 file:px-3 file:py-2 file:text-white file:font-semibold">
            <p class="text-[12px] text-violet-900/85 mt-2">
              JPG, PNG or PDF, up to 5 MB. You start in the regular line; once staff approve
              your proof, your ticket moves to the priority lane. Bring the same ID to the window.
            </p>
            <% if (formError && form.priorityType) { %>
            <p class="text-[12px] font-semibold text-violet-900 mt-1.5">Please choose the photo again.</p>
            <% } %>
          </div>
        </div>
      </section>

      <!-- who will claim it -->
      <section class="<%= UI.card %> step">
        <div class="<%= UI.cardHd %>"><h3 class="<%= UI.cardTtl %>">Who will claim this?</h3></div>
        <div class="<%= UI.body %>">
          <fieldset>
            <legend class="sr-only">Claimant</legend>
            <div class="grid sm:grid-cols-2 gap-2.5">
              <label class="rounded-2xl border-2 transition has-[:checked]:shadow-card px-4 py-3.5 cursor-pointer border-hair has-[:checked]:border-brand has-[:checked]:bg-brand-wash has-[:checked]:ring-4 has-[:checked]:ring-brand/10">
                <input type="radio" name="claimant" value="self" class="sr-only"
                       <%= form.claimant !== 'representative' ? 'checked' : '' %> onchange="toggleRep()">
                <div class="text-[14px] font-bold">I will claim it myself</div>
                <div class="text-[12px] text-slateSoft/80 mt-0.5">Bring a valid ID to the window</div>
              </label>
              <label class="rounded-2xl border-2 transition has-[:checked]:shadow-card px-4 py-3.5 cursor-pointer border-hair has-[:checked]:border-brand has-[:checked]:bg-brand-wash has-[:checked]:ring-4 has-[:checked]:ring-brand/10">
                <input type="radio" name="claimant" value="representative" class="sr-only"
                       <%= form.claimant === 'representative' ? 'checked' : '' %> onchange="toggleRep()">
                <div class="text-[14px] font-bold">Someone will claim it for me</div>
                <div class="text-[12px] text-slateSoft/80 mt-0.5">A parent, relative or friend</div>
              </label>
            </div>
          </fieldset>

          <div id="repBox" class="hidden mt-4 space-y-3">
            <div class="grid sm:grid-cols-3 gap-3">
              <div>
                <label for="repName" class="<%= UI.lbl %>">Representative's full name *</label>
                <input id="repName" name="repName" class="<%= UI.input %>" value="<%= form.repName || '' %>">
              </div>
              <div>
                <label for="repRelationship" class="<%= UI.lbl %>">Relationship to you *</label>
                <input id="repRelationship" name="repRelationship" class="<%= UI.input %>"
                       value="<%= form.repRelationship || '' %>" placeholder="Mother, sibling, friend">
              </div>
              <div>
                <label for="repContact" class="<%= UI.lbl %>">Contact number</label>
                <input id="repContact" name="repContact" class="<%= UI.input %>"
                       value="<%= form.repContact || '' %>" placeholder="09XXXXXXXXX">
              </div>
            </div>
            <p class="rounded-lg bg-amber-50 border border-amber-200 px-3.5 py-2.5 text-[12.5px] text-amber-900">
              Your representative must bring a signed authorisation letter, their own valid ID,
              and a copy of yours. Staff will check these before releasing anything.
            </p>
          </div>
        </div>
      </section>

      <p class="wiz-error hidden rounded-lg bg-red-50 border-l-4 border-red-600 px-4 py-2.5 text-[13px] font-medium text-red-900" role="alert"></p>
      <div class="flex flex-wrap items-center gap-2.5">
        <button type="button" class="<%= UI.btn %> <%= UI.btnGh %>" data-back>&larr; Back</button>
        <button type="button" class="<%= UI.btn %> <%= UI.btnMain %> px-6 ml-auto" data-next>Review &rarr;</button>
      </div>
    </div>

    <!-- STEP 4 of 4: review and submit -->
    <div class="wiz-pane space-y-4" data-pane="4" hidden>
        <!-- review -->
        <section class="<%= UI.card %>">
          <div class="<%= UI.cardHd %>"><h3 class="<%= UI.cardTtl %>">Review your request</h3></div>
          <div class="<%= UI.body %>">
            <dl id="reviewList" class="divide-y divide-hair text-[13px]"></dl>
            <p class="<%= UI.hint %> mt-3">Something wrong? Click a step above or use Back to change it.</p>
          </div>
        </section>

      <p class="wiz-error hidden rounded-lg bg-red-50 border-l-4 border-red-600 px-4 py-2.5 text-[13px] font-medium text-red-900" role="alert"></p>
      <div class="flex flex-wrap items-center gap-2.5">
        <button type="button" class="<%= UI.btn %> <%= UI.btnGh %>" data-back>&larr; Back</button>
        <button type="submit" class="<%= UI.btn %> <%= UI.btnMain %> px-6 py-3 text-[14px] ml-auto">Get my number</button>
      </div>
    </div>

  </form>
</div>

<script>
function toggleMode(){
  var sched = document.querySelector('input[name=mode][value=schedule]');
  var box = document.getElementById('scheduleBox');
  var on = sched && sched.checked;
  box.classList.toggle('hidden', !on);
  document.getElementById('scheduledDate').required = on;
  loadSlots();
}

// Booking times: asks the server which 30-minute slots on that date still have
// room for the chosen documents, and lists them with the places left.
var slotAsk = 0;
function loadSlots(){
  var box = document.getElementById('slotBox');
  var sched = document.querySelector('input[name=mode][value=schedule]');
  var date = document.getElementById('scheduledDate').value;
  var office = document.querySelector('input[name=office]:checked');
  var list = box.querySelector('[data-slot-list]'), note = box.querySelector('[data-slot-note]');
  if (!(sched && sched.checked) || !date || !office) { box.hidden = true; list.innerHTML = ''; return; }
  var docs = [].map.call(document.querySelectorAll('input[name=documentIds]:checked'), function (b) { return b.value; });
  var picked = (document.querySelector('input[name=slot]:checked') || {}).value || box.dataset.picked;
  var mine = ++slotAsk;
  box.hidden = false;
  note.textContent = 'Checking available times...';
  list.innerHTML = '';
  fetch('/queue/slots?office=' + encodeURIComponent(office.value) + '&date=' + date + '&docs=' + docs.join(','),
        { cache: 'no-store' })
    .then(function (r) { return r.json(); })
    .then(function (d) {
      if (mine !== slotAsk) return;                  // an older answer arrived late
      if (d.closed || d.error) { note.textContent = d.closed || d.error; return; }
      var open = d.slots.filter(function (x) { return x.available; }).length;
      note.textContent = open
        ? 'Each slot fits about ' + d.capacity + ' clients (' + d.windows + ' window' + (d.windows > 1 ? 's' : '') +
          ', about ' + d.avgService + ' min each); half can be booked. Your documents take about ' + d.serviceMin + ' min.'
        : 'Every slot on this date is fully booked. Please choose another date.';
      d.slots.forEach(function (x) {
        if (x.past) return;
        var lab = document.createElement('label');
        lab.className = 'rounded-2xl border-2 transition has-[:checked]:shadow-card px-3 py-2.5 text-center border-hair ' +
          (x.available ? 'cursor-pointer has-[:checked]:border-brand has-[:checked]:bg-brand-wash has-[:checked]:ring-4 has-[:checked]:ring-brand/10' : 'opacity-50 cursor-not-allowed bg-mist');
        lab.innerHTML = '<input type="radio" name="slot" class="sr-only" required>' +
          '<span class="block text-[13px] font-bold"></span><span class="block text-[11px] text-slateSoft/80 mt-0.5"></span>';
        var inp = lab.querySelector('input');
        inp.value = x.start; inp.disabled = !x.available; inp.checked = x.available && x.start === picked;
        lab.querySelectorAll('span')[0].textContent = x.label;
        lab.querySelectorAll('span')[1].textContent = x.available
          ? (x.placesLeft > 0 ? 'about ' + x.placesLeft + ' place' + (x.placesLeft === 1 ? '' : 's') + ' left' : 'last place') : 'full';
        list.appendChild(lab);
      });
    })
    .catch(function () { if (mine === slotAsk) note.textContent = 'Could not load the times. Check your connection and try again.'; });
}
// tapping a purpose chip sets the (hidden) purpose list
document.addEventListener('click', function (e) {
  var chip = e.target.closest('[data-purpose-chip]'); if (!chip) return;
  var sel = document.getElementById('purpose');
  sel.value = chip.dataset.purposeChip;
  toggleOther();
  var box = sel.closest('.wiz-pane'); var err = box && box.querySelector('.wiz-error');
  if (err && /is for|purpose/i.test(err.textContent)) { err.textContent = ''; err.classList.add('hidden'); }
  if (sel.value === 'Others') setTimeout(function () { document.getElementById('otherPurpose').focus(); }, 50);
});
function stepCopies(id, d){
  var f = document.querySelector('[data-copies="' + id + '"]'); if (!f || f.disabled) return;
  var max = parseInt(f.max, 10) || 99;
  f.value = Math.min(max, Math.max(1, (parseInt(f.value, 10) || 1) + d));
  recalc();
}
function toggleOther(){
  var v = document.getElementById('purpose').value;
  document.querySelectorAll('[data-purpose-chip]').forEach(function (c) {
    c.setAttribute('aria-checked', c.dataset.purposeChip === v ? 'true' : 'false');
  });
  var box = document.getElementById('otherBox');
  box.classList.toggle('hidden', v !== 'Others');
  document.getElementById('otherPurpose').required = (v === 'Others');
}
// Visitors give no student number, course or year (and can only pick
// documents open to them).
function toggleClient(){
  var guest = document.querySelector('input[name=clientType][value=guest]').checked;
  document.getElementById('studentNoBox').hidden = guest;
  ['studentNo', 'course', 'yearLevel'].forEach(function (id) {
    var f = document.getElementById(id);
    f.required = !guest;
    f.disabled = guest;
  });
}
// Priority needs a photo of the ID or proof (checked by staff before the
// ticket moves to the priority lane).
function toggleProof(){
  var p = document.querySelector('input[name=priorityType]:checked');
  var on = !!(p && p.value);
  var box = document.getElementById('proofBox'), file = document.getElementById('proof');
  box.hidden = !on;
  file.required = on;
  file.disabled = !on;
  var what = { pwd: '(PWD ID)', senior: '(Senior Citizen ID)', pregnant: '(medical certificate or prenatal record)' };
  box.querySelector('[data-proof-what]').textContent = on ? what[p.value] : '';
}
function toggleRep(){
  var rep = document.querySelector('input[name=claimant][value=representative]').checked;
  document.getElementById('repBox').classList.toggle('hidden', !rep);
  ['repName','repRelationship'].forEach(function(id){
    document.getElementById(id).required = rep;
  });
}

// The office came from the queue page; "Change" brings back both choices.
function changeOffice(){
  document.querySelectorAll('[data-office-choice]').forEach(function (el) { el.hidden = false; el.classList.add('docs-in'); });
  var s = document.querySelector('[data-office-summary]');
  if (s) s.hidden = true;
}

// Office is chosen first; only that office's documents are shown.
var lastOffice = null;
function pickOffice(){
  var chosen = document.querySelector('input[name=office]:checked');
  var section = document.getElementById('docSection');
  var rows = document.querySelectorAll('#docList .doc-row');
  var changed = chosen && chosen.value !== lastOffice;
  var firstLoad = lastOffice === null;
  lastOffice = chosen ? chosen.value : null;
  section.hidden = !chosen;
  var shown = 0;
  rows.forEach(function(row){
    var match = chosen && row.dataset.office === chosen.value;
    row.hidden = !match;
    if (match) row.style.setProperty('--i', Math.min(shown, 10));
    if (match) shown++;
    if (!match) {
      var cb = row.querySelector('input[name=documentIds]');
      if (cb) cb.checked = false;
    }
  });
  document.getElementById('noDocs').hidden = !chosen || shown > 0;
  recalc();
  if (changed) {
    section.classList.remove('docs-in'); void section.offsetWidth; section.classList.add('docs-in');
    // chosen by a tap (not on page load): glide down to the documents
    if (!firstLoad) setTimeout(function () {
      var calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      section.scrollIntoView({ behavior: calm ? 'auto' : 'smooth', block: 'start' });
    }, 120);
  }
}

function recalc(){
  var list  = document.getElementById('docList');
  var max   = parseInt(list.dataset.max, 10);
  var chosen = document.querySelector('input[name=office]:checked');
  var boxes = list.querySelectorAll('input[name=documentIds]');
  var picked = [], total = 0;

  boxes.forEach(function(b){
    var visible = chosen && b.dataset.office === chosen.value;
    var qty    = document.getElementById('qty-' + b.dataset.row);
    var copies = document.querySelector('[data-copies="' + b.dataset.row + '"]');
    if (qty) qty.hidden = !(b.checked && visible);
    var row = b.closest('.doc-row');
    if (row) row.classList.toggle('is-picked', b.checked && visible);
    var line = document.querySelector('[data-line-total="' + b.dataset.row + '"]');
    if (line && copies) {
      var cn = Math.max(1, parseInt(copies.value || '1', 10));
      line.textContent = parseFloat(b.dataset.price) > 0 && cn > 1
        ? '₱' + (parseFloat(b.dataset.price) * cn).toLocaleString('en-PH', {minimumFractionDigits:2}) : '';
    }
    // an unticked box must not submit a copies value, or the arrays misalign
    if (copies) copies.disabled = !(b.checked && visible);
    // the list of paid documents to claim shows only while claiming is ticked
    var panel = document.querySelector('[data-claim-panel="' + b.dataset.row + '"]');
    if (panel) {
      panel.hidden = !(b.checked && visible);
      panel.querySelectorAll('input').forEach(function (c) { c.disabled = panel.hidden; });
    }
    if (!b.checked || !visible) return;
    picked.push(b);
    var n = copies ? Math.max(1, parseInt(copies.value || '1', 10)) : 1;
    total += parseFloat(b.dataset.price) * n;
  });

  boxes.forEach(function(b){
    b.disabled = b.dataset.locked === '1' || (!b.checked && picked.length >= max);
  });

  document.getElementById('pickCount').textContent = picked.length + ' of ' + max + ' selected';
  document.getElementById('amountDue').textContent =
    '₱' + total.toLocaleString('en-PH', {minimumFractionDigits:2, maximumFractionDigits:2});

  // Purpose is only asked for documents flagged as needing one.
  var wantsPurpose = picked.some(function (b) { return b.dataset.purpose === '1'; });
  var ps = document.getElementById('purposeSection');
  var pf = document.getElementById('purpose');
  if (ps) {
    // sit inside the box of the (first) ticked document that asks for a purpose
    var owner = picked.filter(function (b) { return b.dataset.purpose === '1'; })[0];
    var slot = owner && document.querySelector('[data-purpose-slot="' + owner.dataset.row + '"]');
    if (slot && ps.parentNode !== slot) slot.appendChild(ps);
    ps.hidden = !wantsPurpose;
    if (pf) {
      pf.required = wantsPurpose;
      if (!wantsPurpose) { pf.value = ''; toggleOther(); }
    }
  }

  renumber();

  var d = document.getElementById('destLabel');
  if (!picked.length)  d.textContent = 'Select a document to continue';
  else                 d.textContent = 'You will be queued at the ' + chosen.value;
}

/** Numbers only the steps that are actually on screen, so the run never skips. */
function renumber(){
  var n = 0;
  document.querySelectorAll('section.step').forEach(function (sec) {
    if (sec.hidden) return;
    n++;
    var slot = sec.querySelector('[data-step-no]');
    if (slot) slot.textContent = n;
  });
}

toggleMode(); toggleOther(); toggleRep(); toggleClient(); toggleProof(); pickOffice(); renumber();
</script>


<script>
(function () {
  var form  = document.querySelector('form[action="/queue/new"]');
  var panes = [].slice.call(form.querySelectorAll('.wiz-pane'));
  var items = [].slice.call(document.querySelectorAll('[data-step-item]'));
  var LAST  = panes.length;
  var current = 1;
  var reached = 1;   // furthest step opened so far; those stay clickable

  function pane(n) { return panes[n - 1]; }
  // Visible within its step, ignoring whether the step itself is on screen.
  function shown(el) {
    for (var n = el; n && !(n.classList && n.classList.contains('wiz-pane')); n = n.parentElement) {
      if (n.hidden || (n.classList && n.classList.contains('hidden'))) return false;
    }
    return true;
  }
  // The steps do the checking, so the browser's all-at-once check (which
  // cannot point at a field on a hidden step) is switched off.
  form.noValidate = true;

  function showError(n, msg) {
    var box = pane(n).querySelector('.wiz-error');
    box.textContent = msg || '';
    box.classList.toggle('hidden', !msg);
  }

  /** The step's own rules first, then the browser's checks on its visible fields. */
  function check(n, quiet) {
    var p = pane(n), msg = '';
    if (n === 1) {
      var office = form.querySelector('input[name=office]:checked');
      var docs = [].filter.call(form.querySelectorAll('input[name=documentIds]:checked'), shown);
      if (!office) msg = 'Choose an office first.';
      else if (!docs.length) msg = 'Select at least one document.';
      else if (!document.getElementById('purposeSection').hidden && !document.getElementById('purpose').value)
        msg = 'Choose what the document is for.';
    }
    if (n === 2) {
      var sch = form.querySelector('input[name=mode][value=schedule]');
      if (sch && sch.checked && document.getElementById('scheduledDate').value &&
          !form.querySelector('input[name=slot]:checked'))
        msg = 'Choose a time for your visit.';
    }
    if (n === 3) {
      var guest = form.querySelector('input[name=clientType][value=guest]').checked;
      var studentOnly = [].filter.call(form.querySelectorAll('input[name=documentIds]:checked'), shown)
        .filter(function (d) { return d.dataset.guest !== '1'; });
      if (guest && studentOnly.length)
        msg = '"' + text(studentOnly[0].closest('label').querySelector('.block')) +
              '" is for enrolled students only. Choose "I am a student", or go back and remove it.';
    }
    if (!msg) {
      var fields = [].filter.call(p.querySelectorAll('input, select, textarea'),
        function (f) { return !f.disabled && f.type !== 'hidden' && shown(f); });
      for (var i = 0; i < fields.length; i++) {
        if (!fields[i].checkValidity()) {
          if (!quiet) { showError(n, ''); fields[i].reportValidity(); }
          return false;
        }
      }
    }
    if (!quiet) showError(n, msg);
    return !msg;
  }

  function paintBar() {
    items.forEach(function (li, i) {
      var n = i + 1, btn = li.querySelector('.wiz-dot');
      li.classList.toggle('is-done', n !== current && n <= reached);
      li.classList.toggle('is-current', n === current);
      btn.disabled = n > reached;
      if (n === current) btn.setAttribute('aria-current', 'step'); else btn.removeAttribute('aria-current');
    });
  }

  function go(n) {
    // moving forward re-checks every step in between
    for (var k = current; k < n; k++) {
      if (!check(k, k !== current)) { if (k !== current) { show(k); check(k); } return; }
    }
    show(n);
  }

  function show(n, stay) {
    var dir = n > current ? 'wiz-fwd' : n < current ? 'wiz-back' : '';
    current = n;
    if (n > reached) reached = n;
    panes.forEach(function (p, i) { p.hidden = i + 1 !== n; });
    var cur = pane(n);                                // replay the slide for this direction
    cur.classList.remove('wiz-fwd', 'wiz-back'); void cur.offsetWidth;
    if (dir) cur.classList.add(dir);
    if (n === LAST) buildReview();
    if (n === 2) loadSlots();                        // documents may have changed
    paintBar();
    var top = document.querySelector('nav[aria-label="Request steps"]');
    if (top && !stay) top.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function text(el) { return el ? el.textContent.replace(/\s+/g, ' ').trim() : ''; }
  function row(dt, dd) {
    return '<div class="flex flex-wrap justify-between gap-x-4 gap-y-0.5 py-2">' +
           '<dt class="text-slateSoft/80">' + dt + '</dt><dd class="font-semibold text-right">' + dd + '</dd></div>';
  }
  function esc(s) { var d = document.createElement('div'); d.textContent = s; return d.innerHTML; }

  function buildReview() {
    var out = [];
    var office = form.querySelector('input[name=office]:checked');
    if (office) out.push(row('Office', esc(office.value)));
    var docs = [].filter.call(form.querySelectorAll('input[name=documentIds]:checked'), shown).map(function (b) {
      var name = text(b.closest('label').querySelector('.block'));
      var c = form.querySelector('[data-copies="' + b.dataset.row + '"]');
      var n = c && !c.disabled ? parseInt(c.value || '1', 10) : 1;
      return esc(name) + (n > 1 ? ' &times;' + n : '');
    });
    out.push(row('Documents', docs.join('<br>') || '&mdash;'));
    var purpose = document.getElementById('purpose');
    if (purpose && shown(document.getElementById('purposeSection')) && purpose.value) {
      var other = document.getElementById('otherPurpose');
      var ownerRow = purpose.closest('.doc-row');
      var ownerName = ownerRow ? text(ownerRow.querySelector('label .block')) : '';
      out.push(row(ownerName ? 'Purpose (' + esc(ownerName) + ')' : 'Purpose',
                   esc(purpose.value === 'Others' && other.value ? other.value : purpose.value)));
    }
    var sched = form.querySelector('input[name=mode][value=schedule]');
    var date = document.getElementById('scheduledDate');
    out.push(row('When', sched && sched.checked && date.value
      ? esc(new Date(date.value + 'T00:00:00').toLocaleDateString('en-PH', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' })) +
        (function () { var sl = form.querySelector('input[name=slot]:checked');
                       return sl ? '<br>' + esc(text(sl.closest('label').querySelector('span'))) : ''; })()
      : 'Today, join the line now'));
    var name = ['firstName', 'middleName', 'lastName'].map(function (id) {
      var f = form.querySelector('[name=' + id + ']'); var v = f ? f.value.trim() : ''; return /^n\/a$/i.test(v) ? '' : v;
    }).filter(Boolean).join(' ');
    out.push(row('Name', esc(name)));
    var no = document.getElementById('studentNo');
    out.push(row('Student number', no.disabled ? 'Visitor (not a student)' : '<span class="font-mono">' + esc(no.value) + '</span>'));
    var course = document.getElementById('course'), year = document.getElementById('yearLevel');
    if (!course.disabled && course.value)
      out.push(row('Course', esc(course.value + (year.value ? ', Year ' + year.value : ''))));
    var lane = form.querySelector('input[name=priorityType]:checked');
    out.push(row('Lane', lane && lane.value
      ? 'Regular until your ' + esc(text(lane.closest('label'))) + ' proof is approved'
      : 'Regular'));
    var rep = form.querySelector('input[name=claimant][value=representative]');
    out.push(row('Claimed by', rep && rep.checked
      ? esc((document.getElementById('repName').value || 'Representative') + ' (' + (document.getElementById('repRelationship').value || '') + ')')
      : 'Myself'));
    out.push(row('Amount due', '<span class="font-mono text-[15px]">' + esc(text(document.getElementById('amountDue'))) + '</span>'));
    document.getElementById('reviewList').innerHTML = out.join('');
  }

  form.addEventListener('click', function (e) {
    if (e.target.closest('[data-next]')) { e.preventDefault(); go(current + 1); }
    if (e.target.closest('[data-back]')) { e.preventDefault(); show(current - 1); }
  });
  items.forEach(function (li, i) {
    li.querySelector('.wiz-dot').addEventListener('click', function () {
      var n = i + 1;
      if (n < current) show(n); else if (n > current) go(n);
    });
  });
  // Enter in a text box moves to the next step instead of submitting early
  form.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' && current < LAST && e.target.tagName === 'INPUT' && e.target.type !== 'checkbox' && e.target.type !== 'radio') {
      e.preventDefault(); go(current + 1);
    }
  });
  // clear a step's message as soon as the student changes something in it
  form.addEventListener('change', function (e) {
    var p = e.target.closest('.wiz-pane');
    if (p) showError(panes.indexOf(p) + 1, '');
  });

  // Last line of defence before sending: every step must pass. Runs before the
  // page's "submit once" handler, which must not lock the button on a failure.
  form.addEventListener('submit', function (e) {
    for (var k = 1; k <= LAST; k++) {
      if (!check(k, true)) {
        e.preventDefault(); e.stopImmediatePropagation();
        show(k); check(k);
        return;
      }
    }
  });

  // After the server turned a submission back, reopen the first step that
  // still needs attention (or the review, if every step checks out).
  var start = 1;
  if (<%- JSON.stringify(!!formError) %>) {
    start = LAST;
    for (var k = 1; k < LAST; k++) if (!check(k, true)) { start = k; break; }
  }
  show(start, true);
})();
</script>
