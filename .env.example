# Copy this file to .env and fill in the values. Never commit .env.
# On the Hostinger server the real file is /var/www/smartq/.env (deploy/HOSTINGER.md).

# ── Database ────────────────────────────────────────────────────────────────
# Local XAMPP: 127.0.0.1 / 3306 / root / (your password) / smartq_db
# A cloud MySQL host: copy host, port, user and password from the provider's
# connection page and set DB_SSL=true.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smartq_db
DB_SSL=false
# If the provider gives a CA certificate, paste it here.
# One line is fine: replace each line break with \n.
DB_SSL_CA=

# ── App ─────────────────────────────────────────────────────────────────────
# PORT (set on the server) wins; APP_PORT is for running on your own computer.
APP_PORT=3000
# Set NODE_ENV=production online. It turns on HTTPS-only login cookies.
NODE_ENV=development
# A long random string. Required when NODE_ENV=production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Email ───────────────────────────────────────────────────────────────────
# Sends registration and password-reset codes, and priority-lane decisions.
# Gmail: use an App Password (Google Account > Security > App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ── Sign in with Google ─────────────────────────────────────────────────────
# console.cloud.google.com > APIs & Services > Credentials > OAuth client ID
# (Web application). Add every callback URL you use as an Authorised
# redirect URI, e.g. http://localhost:3000/auth/google/callback and
# https://smartq-licom.online/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Email through Brevo (HTTPS): with this set, the SMTP lines are the fallback.
BREVO_API_KEY=

# Web Push (phone notifications): generate with  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
