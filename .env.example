# Copy this file to .env and fill in the values. Never commit .env.
# On Render, enter these under the web service's Environment tab instead.

# ── Database ────────────────────────────────────────────────────────────────
# Local XAMPP: 127.0.0.1 / 3306 / root / (your password) / smartq_db
# Cloud MySQL (Aiven, TiDB Cloud): copy host, port, user and password from the
# provider's connection page and set DB_SSL=true.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smartq_db
DB_SSL=false
# Aiven only: paste the CA certificate (Download CA cert on the service page).
# One line is fine: replace each line break with \n.
DB_SSL_CA=

# ── App ─────────────────────────────────────────────────────────────────────
# Render sets PORT itself; APP_PORT is only for running on your own computer.
APP_PORT=3000
# Set NODE_ENV=production online. It turns on HTTPS-only login cookies.
NODE_ENV=development
# A long random string. Required when NODE_ENV=production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Email ───────────────────────────────────────────────────────────────────
# Sends registration and password-reset codes, and priority-lane decisions.
# Gmail: use an App Password (Google Account > Security > App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ── Sign in with Google ─────────────────────────────────────────────────────
# console.cloud.google.com > APIs & Services > Credentials > OAuth client ID
# (Web application). Add every callback URL you use as an Authorised
# redirect URI, e.g. http://localhost:3000/auth/google/callback and
# https://<your-app>.onrender.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Web Push (phone notifications): generate with  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
